msgid "Enable group management to generate product names and SKUs from attribute values."
msgstr "הפעל את ניהול הקבוצה כדי ליצור שמות ומק״טים מערכי המאפיינים."

msgid "Choose a product category, review the group name and SKU, then arrange the attributes and their values. Each value contributes to the generated name and SKU."
msgstr "בחר קטגוריית מוצר, בדוק את שם הקבוצה והמק״ט, ואז סדר את המאפיינים והערכים שלהם. כל ערך משתתף בשם ובמק״ט המחושבים."

msgid "Selecting a category copies its name and SKU component. Model is a regular attribute value."
msgstr "בחירת קטגוריה מעתיקה את שמה ואת רכיב המק״ט שלה. דגם הוא ערך מאפיין רגיל."

msgid "This is a duplicated group. Set a new group SKU before generating product SKUs."
msgstr "זו קבוצה שהועתקה. יש להגדיר מק״ט קבוצה חדש לפני יצירת מק״טים לפריטים."

msgid "“Block Combination” prevents the selected values from appearing together. “Allow Only Combination” creates an allowlist and blocks all other combinations."
msgstr "„חסום את השילוב” מונע מהערכים שנבחרו להופיע יחד. „אפשר רק את השילוב” יוצר רשימת שילובים מורשים וחוסם את כל השאר."

msgid "Any product containing all selected values together will be blocked."
msgstr "כל פריט שמכיל יחד את כל הערכים שנבחרו ייחסם."

msgid "Only products containing all selected values together will be allowed. Once an allow rule exists, combinations that match no allow rule are blocked."
msgstr "רק פריטים שמכילים יחד את כל הערכים שנבחרו יורשו. כשקיים כלל מותר, כל שילוב שאינו מתאים לכלל מותר נחסם."

msgid "Select one value from at least two different attributes, for example “Model: Window” with “Color: Orange”."
msgstr "בחר ערך אחד לפחות משני מאפיינים שונים, לדוגמה „דגם: חלון” יחד עם „צבע: כתום”."
