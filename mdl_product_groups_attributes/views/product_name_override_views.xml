<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mdl_product_template_name_sku_form" model="ir.ui.view">
        <field name="name">product.template.name.sku.overrides</field>
        <field name="model">product.template</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <form string="Name and SKU Overrides" create="0" delete="0">
                <field name="mdl_catalog_managed" invisible="1"/>
                <field name="mdl_model_as_attribute" invisible="1"/>
                <group>
                    <label for="name" string="Template Name"/>
                    <div class="o_row">
                        <field name="name" nolabel="1"/>
                    </div>
                </group>
                <div class="alert alert-info" role="alert">
                    The template title is for display only. Automatic product names use Product Group Name followed by the configured attribute text, in each language.
                </div>
                <div class="text-muted mb-3">
                    Leave an override blank to use its source value. Enter — to omit that component. Attribute values are added after the shared name and SKU.
                </div>
                <group string="Product Group">
                    <group>
                        <field name="mdl_group_default_name" string="Product Group Name"/>
                    </group>
                    <group>
                        <field name="mdl_group_default_sku" string="Product Group SKU"/>
                        <field name="mdl_group_sku_override" string="Custom Group SKU" class="o_mdl_sku_field"/>
                    </group>
                </group>
                <group string="Model" invisible="mdl_model_as_attribute">
                    <group>
                        <field name="mdl_model_sku_component"/>
                        <field name="mdl_model_sku_override" string="Custom Model SKU" class="o_mdl_sku_field"/>
                    </group>
                </group>
                <group>
                    <field name="mdl_name_suffix" string="Text After All Attributes"/>
                </group>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mdl_product_template_name_sku_controls" model="ir.ui.view">
        <field name="name">product.template.name.sku.controls</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="mdl_product_groups_attributes.mdl_product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="replace">
                <div class="o_mdl_variant_name d-flex align-items-baseline gap-2">
                    <field name="name" class="text-break flex-grow-1" widget="text"
                           options="{'line_breaks': False}"
                           help="Display title of the product group. Automatic product names use Product Group Name below."/>
                </div>
            </xpath>
            <xpath expr="//group[hasclass('o_mdl_catalog_setup')]/field[@name='mdl_group_default_sku']" position="after">
                <button name="action_mdl_open_name_sku_overrides" type="object"
                        string="Name and SKU Overrides" icon="fa-sliders"
                        class="btn-link" colspan="2" invisible="not mdl_catalog_managed"/>
            </xpath>
        </field>
    </record>
</odoo>
