<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mdl_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.mdl.product.groups.attributes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Product Groups &amp; Attributes" name="mdl_product_groups_attributes">
                    <block title="Product Display">
                        <setting string="Display Format in Search and Documents"
                                 help="One system-wide format for all variants. Use [SKU] and [Product Name]; existing Hebrew tokens remain supported.">
                            <field name="mdl_variant_display_format"
                                   class="o_mdl_format_field font-monospace"
                                   placeholder="[SKU] [Product Name]"/>
                            <div class="text-muted mt-2">
                                <span>Example: </span>
                                <field name="mdl_variant_display_example"
                                       class="oe_inline"
                                       readonly="1"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
