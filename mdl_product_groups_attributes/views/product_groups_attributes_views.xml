<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mdl_product_attribute_value_form_view" model="ir.ui.view">
        <field name="name">product.attribute.value.form.mdl.catalog</field>
        <field name="model">product.attribute.value</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <form string="ערך מאפיין" create="0" delete="0">
                <sheet>
                    <widget name="web_ribbon"
                            title="בארכיון"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name" string="טקסט ברירת מחדל"/>
                            <field name="attribute_id"
                                   string="מאפיין"
                                   readonly="1"/>
                            <field name="sequence" string="סדר"/>
                        </group>
                        <group>
                            <field name="mdl_sku_component"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mdl_product_attribute_form_view" model="ir.ui.view">
        <field name="name">product.attribute.form.mdl.catalog</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="mdl_sku_component" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="mdl_product_template_attribute_value_form_view" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.mdl.catalog</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="mdl_catalog_managed" invisible="1"/>
                <field name="mdl_name_component_override" invisible="1"/>
                <field name="mdl_sku_component_override" invisible="1"/>
                <label for="mdl_name_component_value"
                       invisible="not mdl_catalog_managed"/>
                <div class="o_row" invisible="not mdl_catalog_managed">
                    <field name="mdl_name_component_value" nolabel="1"/>
                    <button name="action_mdl_reset_name_component"
                            type="object"
                            icon="fa-undo"
                            title="בטל את שינוי הטקסט וחזור לערך של Odoo"
                            class="btn-link p-0"
                            invisible="not mdl_name_component_override"/>
                </div>
                <label for="mdl_sku_component_value"
                       invisible="not mdl_catalog_managed"/>
                <div class="o_row" invisible="not mdl_catalog_managed">
                    <field name="mdl_sku_component_value" nolabel="1"/>
                    <button name="action_mdl_reset_sku_component"
                            type="object"
                            icon="fa-undo"
                            title="בטל את שינוי המק״ט וחזור לערך המקור"
                            class="btn-link p-0"
                            invisible="not mdl_sku_component_override"/>
                </div>
            </field>
        </field>
    </record>

    <record id="mdl_product_template_attribute_value_list_view" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.mdl.catalog</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="string">ערך המאפיין</attribute>
                <attribute name="readonly">1</attribute>
            </field>
            <field name="name" position="after">
                <field name="mdl_name_component_override" column_invisible="True"/>
                <field name="mdl_sku_component_override" column_invisible="True"/>
                <field name="mdl_name_component_value"
                       string="טקסט בקבוצה"
                       decoration-muted="not mdl_name_component_override"/>
                <button name="action_mdl_reset_name_component"
                        type="object"
                        icon="fa-undo"
                        title="בטל את שינוי הטקסט וחזור לערך של Odoo"
                        invisible="not mdl_name_component_override"/>
                <button name="action_mdl_reset_name_component"
                        type="object"
                        icon="fa-undo"
                        title="-"
                        class="disabled opacity-0"
                        invisible="mdl_name_component_override"/>
                <field name="mdl_sku_component_value"
                       string="מק״ט בקבוצה"
                       decoration-muted="not mdl_sku_component_override"/>
                <button name="action_mdl_reset_sku_component"
                        type="object"
                        icon="fa-undo"
                        title="בטל את שינוי המק״ט וחזור לערך המקור"
                        invisible="not mdl_sku_component_override"/>
                <button name="action_mdl_reset_sku_component"
                        type="object"
                        icon="fa-undo"
                        title="-"
                        class="disabled opacity-0"
                        invisible="mdl_sku_component_override"/>
            </field>
            <field name="html_color" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="image" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="price_extra" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="mdl_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.mdl.native.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']/field[@name='attribute_line_ids']"
                   position="before">
                <field name="mdl_group_name_override" invisible="1"/>
                <field name="mdl_group_sku_override" invisible="1"/>
                <field name="mdl_model_name_override" invisible="1"/>
                <field name="mdl_model_sku_override" invisible="1"/>
                <field name="mdl_model_as_attribute" invisible="1"/>
                <field name="mdl_catalog_managed"
                       string="ניהול שמות ומק״טים לפי מאפיינים"/>
                <group string="הגדרת קבוצת הפריטים"
                       invisible="not mdl_catalog_managed">
                    <group>
                        <field name="mdl_group_default_name"/>
                        <field name="mdl_group_default_sku"/>
                        <field name="categ_id" string="קטגוריית מוצר"/>
                    </group>
                    <group>
                        <label for="mdl_effective_base_name"/>
                        <div class="o_row">
                            <field name="mdl_effective_base_name" nolabel="1"/>
                            <button name="action_mdl_reset_base_name"
                                    type="object"
                                    icon="fa-undo"
                                    title="בטל את שינוי השם וחזור לשם המקור"
                                    class="btn-link p-0"
                                    invisible="not mdl_group_name_override and (mdl_model_as_attribute or not mdl_model_name_override)"/>
                        </div>
                        <label for="mdl_sku_prefix"/>
                        <div class="o_row">
                            <field name="mdl_sku_prefix" nolabel="1"/>
                            <button name="action_mdl_reset_base_sku"
                                    type="object"
                                    icon="fa-undo"
                                    title="בטל את שינוי המק״ט וחזור למק״ט המקור"
                                    class="btn-link p-0"
                                    invisible="not mdl_group_sku_override and (mdl_model_as_attribute or not mdl_model_sku_override)"/>
                        </div>
                        <button name="action_mdl_convert_model_to_attribute"
                                type="object"
                                string="העבר דגם למאפיין"
                                icon="fa-exchange"
                                class="btn-secondary"
                                invisible="mdl_model_as_attribute or not mdl_catalog_managed"/>
                    </group>
                </group>
                <group string="מצב הפריטים"
                       invisible="not mdl_catalog_managed">
                    <group>
                        <field name="mdl_active_variant_count" readonly="1"/>
                        <field name="mdl_archived_variant_count" readonly="1"/>
                        <field name="mdl_blocked_variant_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="mdl_variant_preview" readonly="1" nolabel="1"/>
                        <button name="action_mdl_preview_catalog"
                                type="object"
                                string="תצוגה מקדימה"
                                icon="fa-eye"
                                class="btn-secondary"/>
                        <button name="action_mdl_check_and_rebuild"
                                type="object"
                                string="בדוק וצור פריטים חסרים"
                                icon="fa-cogs"
                                class="btn-primary"/>
                        <button name="action_mdl_open_variants"
                                type="object"
                                string="פתח את פריטי הקבוצה"
                                icon="fa-list"
                                class="btn-secondary"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//page[@name='variants']/field[@name='attribute_line_ids']/list/field[@name='value_ids']"
                   position="after">
                <field name="mdl_name_mode"
                       optional="show"
                       column_invisible="not parent.mdl_catalog_managed"/>
                <field name="mdl_include_in_sku"
                       optional="show"
                       column_invisible="not parent.mdl_catalog_managed"/>
                <field name="mdl_variant_creation_mode"
                       optional="hide"
                       column_invisible="not parent.mdl_catalog_managed"/>
                <field name="mdl_name_suffix"
                       optional="show"
                       column_invisible="not parent.mdl_catalog_managed"/>
                <field name="mdl_is_model_attribute" column_invisible="True"/>
            </xpath>

            <xpath expr="//page[@name='variants']/field[@name='attribute_line_ids']"
                   position="after">
                <separator string="ערכי מאפיינים בקבוצה"
                           invisible="not mdl_catalog_managed"/>
                <field name="mdl_attribute_value_ids"
                       nolabel="1"
                       invisible="not mdl_catalog_managed">
                    <list editable="bottom"
                          create="0"
                          delete="0"
                          default_order="attribute_line_id, product_attribute_value_id, id">
                        <field name="product_tmpl_id" column_invisible="True"/>
                        <field name="attribute_id" column_invisible="True"/>
                        <field name="attribute_line_id"
                               column_invisible="True"/>
                        <field name="mdl_is_attribute_group_start"
                               column_invisible="True"/>
                        <field name="mdl_attribute_group_id"
                               string="מאפיין"
                               readonly="1"
                               decoration-bf="mdl_is_attribute_group_start"/>
                        <field name="product_attribute_value_id"
                               string="ערך"
                               readonly="1"
                               context="{'form_view_ref': 'mdl_product_groups_attributes.mdl_product_attribute_value_form_view'}"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="mdl_name_component_value"
                               string="טקסט בקבוצה"
                               decoration-muted="not mdl_name_component_override"/>
                        <field name="mdl_name_component_override"
                               column_invisible="True"/>
                        <field name="mdl_sku_component_override"
                               column_invisible="True"/>
                        <button name="action_mdl_reset_name_component"
                                type="object"
                                icon="fa-undo"
                                title="בטל את שינוי הטקסט וחזור לערך של Odoo"
                                invisible="not mdl_name_component_override"/>
                        <button name="action_mdl_reset_name_component"
                                type="object"
                                icon="fa-undo"
                                title="-"
                                class="disabled opacity-0"
                                invisible="mdl_name_component_override"/>
                        <field name="mdl_sku_component_value"
                               string="מק״ט בקבוצה"
                               decoration-muted="not mdl_sku_component_override"/>
                        <button name="action_mdl_reset_sku_component"
                                type="object"
                                icon="fa-undo"
                                title="בטל את שינוי המק״ט וחזור לערך המקור"
                                invisible="not mdl_sku_component_override"/>
                        <button name="action_mdl_reset_sku_component"
                                type="object"
                                icon="fa-undo"
                                title="-"
                                class="disabled opacity-0"
                                invisible="mdl_sku_component_override"/>
                    </list>
                </field>

                <separator string="כללי שילובים"
                           invisible="not mdl_catalog_managed"/>
                <field name="mdl_exclusion_ids"
                       nolabel="1"
                       invisible="not mdl_catalog_managed"
                       domain="[('mdl_is_catalog_condition', '=', True)]"
                       context="{'default_mdl_is_catalog_condition': True}">
                    <list editable="bottom">
                        <field name="product_tmpl_id"
                               column_invisible="True"/>
                        <field name="mdl_is_catalog_condition"
                               column_invisible="True"/>
                        <field name="mdl_rule_type"/>
                        <field name="mdl_combination_value_ids"
                               string="ערכי הכלל"
                               widget="many2many_tags"
                               required="1"
                               domain="[('product_tmpl_id', '=', product_tmpl_id), ('ptav_active', '=', True)]"
                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    </list>
                </field>
            </xpath>

        </field>
    </record>

    <record id="mdl_product_template_list_view" model="ir.ui.view">
        <field name="name">product.template.list.mdl.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mdl_model_value_summary"
                       string="דגמים"
                       optional="hide"/>
                <field name="mdl_sku_prefix"
                       string="מק״ט בסיס"
                       optional="hide"/>
            </field>
        </field>
    </record>

    <record id="mdl_product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.mdl.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mdl_sku_prefix" string="מק״ט בסיס"/>
            </field>
        </field>
    </record>

    <record id="mdl_product_product_list_view" model="ir.ui.view">
        <field name="name">product.product.list.mdl.catalog</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="display_name"
                       string="שם הפריט"
                       context="{'display_default_code': False}"
                       readonly="1"
                       optional="hide"/>
            </field>
        </field>
    </record>

    <record id="mdl_product_product_form_final_name" model="ir.ui.view">
        <field name="name">product.product.form.mdl.final.name</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/label[@for='name']"
                   position="replace">
                <label for="mdl_generated_name"
                       string="שם הפריט"
                       invisible="not mdl_generated_name"/>
                <label for="name"
                       string="שם הפריט"
                       invisible="mdl_generated_name"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']"
                   position="replace">
                <field name="mdl_generated_name"
                       class="text-break"
                       readonly="1"
                       invisible="not mdl_generated_name"/>
                <field name="name"
                       class="text-break"
                       options="{'line_breaks': False}"
                       widget="text"
                       invisible="mdl_generated_name"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="נתונים טכניים"
                      name="mdl_technical_data"
                      invisible="not mdl_generated_name">
                    <group>
                        <group string="מידות ומשקל">
                            <field name="mdl_length_cm"/>
                            <field name="mdl_width_cm"/>
                            <field name="mdl_height_cm"/>
                            <field name="weight" string="משקל"/>
                            <field name="volume" string="נפח"/>
                        </group>
                        <group string="נתוני מערכת">
                            <field name="mdl_max_protected_area_m2"/>
                            <field name="mdl_installation_type"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        הנתונים בלשונית זו שייכים לפריט ואינם יוצרים
                        שילובים חדשים. קיבולת, חברה ודגם מערכת מנוהלים
                        בלשונית המאפיינים של תבנית המוצר.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mdl_product_variant_easy_form_final_name" model="ir.ui.view">
        <field name="name">product.product.easy.form.mdl.final.name</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/label[@for='name']"
                   position="replace">
                <label for="mdl_generated_name"
                       string="שם הפריט"
                       invisible="not mdl_generated_name"/>
                <label for="name"
                       string="שם הפריט"
                       invisible="mdl_generated_name"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1/field[@name='name']"
                   position="replace">
                <field name="mdl_generated_name"
                       readonly="1"
                       invisible="not mdl_generated_name"/>
                <field name="name"
                       readonly="1"
                       invisible="mdl_generated_name"/>
            </xpath>
        </field>
    </record>

    <record id="mdl_product_product_search_view" model="ir.ui.view">
        <field name="name">product.product.search.mdl.catalog</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mdl_generated_name" string="שם הפריט"/>
                <field name="mdl_max_protected_area_m2"/>
                <field name="mdl_installation_type"/>
            </field>
        </field>
    </record>
</odoo>
