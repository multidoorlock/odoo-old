<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mdl_template_full_variants_button" model="ir.ui.view">
        <field name="name">product.template.full.variants.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(product.product_variant_action)d']" position="attributes">
                <attribute name="name">action_mdl_open_product_variants</attribute>
                <attribute name="type">object</attribute>
            </xpath>
        </field>
    </record>

    <record id="mdl_variant_supplier_price_list" model="ir.ui.view">
        <field name="name">product.supplierinfo.variant.only.list</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="purchase.product_product_supplierinfo_tree_view2"/>
        <field name="mode">primary</field>
        <field name="priority" eval="1100"/>
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="required">1</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="column_invisible">True</attribute>
            </field>
        </field>
    </record>

    <record id="mdl_variant_supplier_price_form" model="ir.ui.view">
        <field name="name">product.supplierinfo.variant.only.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="mode">primary</field>
        <field name="priority" eval="1100"/>
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="required">1</attribute>
                <attribute name="force_save">1</attribute>
            </field>
            <xpath expr="//field[@name='product_id'][@groups='!product.group_product_variant']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="required">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <field name="product_tmpl_id" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </field>
        </field>
    </record>

    <record id="mdl_shared_supplier_price_form" model="ir.ui.view">
        <field name="name">product.supplierinfo.shared.readonly.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="mode">primary</field>
        <field name="priority" eval="1100"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="edit">false</attribute>
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
                <attribute name="duplicate">false</attribute>
            </form>
        </field>
    </record>

    <record id="mdl_product_variant_full_form" model="ir.ui.view">
        <field name="name">product.product.full.form.variant.scope</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mdl_open_product_template" type="object"
                        class="oe_stat_button" icon="fa-cubes" invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Product Template</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="before">
                <div class="text-muted mb-3" name="mdl_variant_scope_note" invisible="not id">
                    Edit this variant here. Shared settings are read-only; use Product Template to change them for all variants.
                </div>
            </xpath>
            <!-- Native image_1920's inverse may write to the shared template,
                 even when opened on a variant. Use native variant storage. -->
            <field name="image_1920" position="replace">
                <field name="image_variant_1920" widget="image" class="oe_avatar"
                       options="{'convert_to_webp': True, 'preview_image': 'image_variant_128', 'zoom': True}"/>
            </field>
            <label for="lst_price" position="attributes">
                <attribute name="string">Sales Price (Template + Extras)</attribute>
            </label>
            <xpath expr="//page[@name='mdl_technical_data']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>
            <field name="pricelist_rule_ids" position="replace">
                <div class="text-muted mb-2">
                    Only prices assigned to this variant are listed. Shared template and pricelist rules may still apply.
                </div>
                <field name="mdl_variant_pricelist_item_ids" nolabel="1"
                       context="{'default_product_id': id, 'default_product_tmpl_id': product_tmpl_id, 'default_applied_on': '0_product_variant', 'form_view_ref': 'product.product_pricelist_item_product_product_form_view'}">
                    <list>
                        <control><create string="Add a price"/></control>
                        <field name="pricelist_id" required="1"/>
                        <field name="price"/>
                        <field name="min_quantity"/>
                        <field name="date_start" optional="hide"/>
                        <field name="date_end" optional="hide"/>
                        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                        <field name="product_tmpl_id" column_invisible="True"/>
                        <field name="product_id" column_invisible="True"/>
                    </list>
                </field>
            </field>
            <field name="seller_ids" position="replace">
                <separator string="All variants"/>
                <div class="text-muted mb-2">
                    These vendor prices apply to all variants, subject to quantity, validity dates, and company. Edit them on the Product Template.
                </div>
                <field name="mdl_shared_seller_ids" nolabel="1" readonly="1"
                       context="{'form_view_ref': 'mdl_product_groups_attributes.mdl_shared_supplier_price_form'}">
                    <list create="false" edit="false" delete="false">
                        <field name="partner_id" options="{'no_open': True}"/>
                        <field name="product_name" optional="hide"/>
                        <field name="product_code" optional="hide"/>
                        <field name="min_qty"/>
                        <field name="product_uom_id" groups="uom.group_uom" options="{'no_open': True}"/>
                        <field name="price"/>
                        <field name="discount" optional="hide"/>
                        <field name="currency_id" groups="base.group_multi_currency" options="{'no_open': True}"/>
                        <field name="date_start" optional="show"/>
                        <field name="date_end" optional="show"/>
                        <field name="delay" optional="hide"/>
                        <field name="company_id" groups="base.group_multi_company" optional="show" options="{'no_open': True}"/>
                    </list>
                </field>
                <separator string="This variant"/>
                <field name="mdl_variant_seller_ids" nolabel="1"
                       context="{'default_product_id': id, 'default_product_tmpl_id': product_tmpl_id, 'default_price': standard_price, 'product_template_invisible_variant': True, 'list_view_ref': 'mdl_product_groups_attributes.mdl_variant_supplier_price_list', 'form_view_ref': 'mdl_product_groups_attributes.mdl_variant_supplier_price_form'}"/>
            </field>
            <field name="variant_seller_ids" position="replace"/>
        </field>
    </record>
</odoo>
