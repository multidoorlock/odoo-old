<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mdl_product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.form.mdl.catalog</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="mdl_sku_component" string="מק״ט מקור לקבוצת פריטים"/>
            </field>
        </field>
    </record>

    <record id="mdl_product_attribute_form_view" model="ir.ui.view">
        <field name="name">product.attribute.form.mdl.catalog</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="attributes">
                <attribute name="string">טקסט ברירת מחדל</attribute>
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="mdl_sku_component" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="mdl_product_template_attribute_value_form_view" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.mdl.catalog</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="mdl_name_component_override" invisible="1"/>
                <field name="mdl_sku_component_override" invisible="1"/>
                <field name="mdl_name_component_value"/>
                <field name="mdl_sku_component_value"/>
                <button name="action_mdl_reset_components"
                        type="object"
                        string="אפס למקור"
                        icon="fa-undo"
                        class="btn-secondary"
                        invisible="not mdl_name_component_override and not mdl_sku_component_override"/>
            </field>
            <field name="exclude_for" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="mdl_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.mdl.native.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']/field[@name='attribute_line_ids']"
                   position="before">
                <field name="mdl_group_name_override" invisible="1"/>
                <field name="mdl_group_sku_override" invisible="1"/>
                <field name="mdl_model_name_override" invisible="1"/>
                <field name="mdl_model_sku_override" invisible="1"/>
                <group string="בסיס הפריט">
                    <group>
                        <field name="mdl_effective_base_name"/>
                        <field name="mdl_sku_prefix"/>
                        <button name="action_mdl_reset_base_values"
                                type="object"
                                string="אפס למקור"
                                icon="fa-undo"
                                class="btn-secondary"
                                invisible="not mdl_group_name_override and not mdl_group_sku_override and not mdl_model_name_override and not mdl_model_sku_override"/>
                    </group>
                    <group>
                        <button name="action_mdl_check_and_rebuild"
                                type="object"
                                string="בדוק ועדכן את כל הפריטים"
                                class="btn-primary"
                                icon="fa-refresh"
                                invisible="not mdl_sku_prefix"/>
                        <button name="action_mdl_open_variants"
                                type="object"
                                string="פתח את הפריטים הסופיים"
                                class="btn-secondary"
                                icon="fa-list"
                                invisible="not mdl_sku_prefix"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not mdl_sku_prefix">
                    שם הבסיס ומק״ט הבסיס מחוברים אוטומטית מקבוצת הפריטים
                    ומהדגם. עריכה משנה רק את הדגם הנוכחי, ו"אפס למקור"
                    מחזיר לחיבור המקורי.
                    סדר השורות קובע את סדר המאפיינים בשם. את הערכים משייכים בשדה
                    "ערכים" הרגיל של Odoo. רווח, "/", "+" או כל מלל שמפריד בין
                    מאפיינים נכתב רק ב"טקסט אחרי" של השורה הקודמת. שינוי חריג
                    לערך מסוים בדגם נעשה דרך כפתור "Configure" של המאפיין.
                </div>
            </xpath>

            <xpath expr="//page[@name='variants']/field[@name='attribute_line_ids']/list/field[@name='value_ids']"
                   position="after">
                <field name="mdl_name_mode" optional="show"/>
                <field name="mdl_name_suffix" optional="show"/>
            </xpath>

        </field>
    </record>

    <record id="mdl_product_template_list_view" model="ir.ui.view">
        <field name="name">product.template.list.mdl.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mdl_sku_prefix"
                       string="מק״ט בסיס"
                       optional="show"/>
            </field>
        </field>
    </record>

    <record id="mdl_product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.mdl.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mdl_sku_prefix" string="מק״ט בסיס"/>
            </field>
        </field>
    </record>

    <record id="mdl_product_product_list_view" model="ir.ui.view">
        <field name="name">product.product.list.mdl.catalog</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="mdl_generated_name"
                       string="שם הפריט הסופי"
                       optional="show"/>
            </field>
            <field name="name" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="mdl_product_product_form_final_name" model="ir.ui.view">
        <field name="name">product.product.form.mdl.final.name</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/label[@for='name']"
                   position="replace">
                <label for="mdl_generated_name"
                       string="שם הפריט הסופי"
                       invisible="not mdl_generated_name"/>
                <label for="name"
                       string="שם המוצר"
                       invisible="mdl_generated_name"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']"
                   position="replace">
                <field name="mdl_generated_name"
                       class="text-break"
                       readonly="1"
                       invisible="not mdl_generated_name"/>
                <field name="name"
                       class="text-break"
                       options="{'line_breaks': False}"
                       widget="text"
                       invisible="mdl_generated_name"/>
            </xpath>
        </field>
    </record>

    <record id="mdl_product_variant_easy_form_final_name" model="ir.ui.view">
        <field name="name">product.product.easy.form.mdl.final.name</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/label[@for='name']"
                   position="replace">
                <label for="mdl_generated_name"
                       string="שם הפריט הסופי"
                       invisible="not mdl_generated_name"/>
                <label for="name"
                       string="שם המוצר"
                       invisible="mdl_generated_name"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1/field[@name='name']"
                   position="replace">
                <field name="mdl_generated_name"
                       readonly="1"
                       invisible="not mdl_generated_name"/>
                <field name="name"
                       readonly="1"
                       invisible="mdl_generated_name"/>
            </xpath>
        </field>
    </record>

    <record id="mdl_product_product_search_view" model="ir.ui.view">
        <field name="name">product.product.search.mdl.catalog</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mdl_generated_name" string="שם פריט סופי"/>
            </field>
        </field>
    </record>
</odoo>
