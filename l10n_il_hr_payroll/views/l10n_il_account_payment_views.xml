<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==== תשלומי עובדים: אותה טבלה/מודל account.payment ואותו שדה שותף
         (partner_id) בדיוק - אין שדה "עובד" נפרד, בדיוק כמו שתשלומי ספק
         נוספו על גבי תשלומי לקוח בליבת account: view_account_supplier_payment_tree
         רק משנה את ה-string של partner_id ל-"Vendor", לא מוסיפה שדה חדש. כאן
         אותו הדבר בדיוק - partner_id מקבל string="עובד" + domain שמסנן
         לאנשי-קשר של עובדים (res.partner.employee_ids, שדה הפוך קיים כבר על
         hr.employee.work_contact_id - לא צריך שום שדה חדש). ללא domain קשיח
         על ה-action עצמו, אפשר להסיר את הפילטר ולראות גם לקוחות/ספקים. אבל
         התצוגות עצמן הן mode="primary" (יורשות מבנה, לא נבנות מאפס) ומשמשות
         אך ורק את הפעולה הזו תחת שכר - בדיוק כמו view_account_supplier_payment_tree
         עצמה, כדי שמסכי התשלומים המקוריים בהנהלת חשבונות (לקוחות/ספקים/הכל)
         יישארו בדיוק כפי שהיו. priority גבוה מוודא שהתצוגות האלו לעולם לא
         "יזכו" ברזולוציה כברירת מחדל כשלא מציינים view_id במפורש. ==== -->
    <record id="l10n_il_account_payment_view_form" model="ir.ui.view">
        <field name="name">account.payment.view.form.l10n.il.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- partner_id[2] הוא זה שמוצג ל-partner_type='supplier' (המצב
                 היחיד הרלוונטי לתשלומי עובד) - רק שינוי string+domain, לא
                 שדה נוסף. לא ניתן להשתמש ב-string כסלקטור בירושת תצוגות,
                 לכן ממוקם לפי סדר המופעים בתצוגה המקורית. עמודה ימנית: סוג
                 תשלום, עובד, סוג תשלום לעובד, סכום, תאריך, פתק - בדיוק סדר
                 השדות המקוריים בתוספת שדה אחד. -->
            <xpath expr="(//field[@name='partner_id'])[2]" position="attributes">
                <attribute name="string">עובד</attribute>
                <attribute name="domain">[('employee_ids', '!=', False)]</attribute>
            </xpath>
            <xpath expr="(//field[@name='partner_id'])[2]" position="after">
                <field name="l10n_il_employee_payment_type"/>
            </xpath>
            <!-- עמודה שמאלית: השפעה על שכר מתחת לאמצעי תשלום -->
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="l10n_il_affects_payroll"/>
            </xpath>
            <!-- חשבון בנק של החברה לא רלוונטי לתשלום עובד -->
            <xpath expr="(//field[@name='partner_bank_id'])[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <notebook name="payment_notebook" position="inside">
                <page string="מעקב שכר" name="l10n_il_payroll_tracking">
                    <group>
                        <field name="payslip_id"/>
                        <field name="l10n_il_batch_id"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- הוספת פילטר "תשלומי עובדים" גם למסכי הנהלת חשבונות המקוריים (לקוחות/
         ספקים/הכל) - ירושה רגילה (לא primary) על אותה תצוגת חיפוש משותפת,
         בדיוק לצד הפילטרים הקיימים "תשלומי לקוח"/"תשלומי ספק" - רק פילטר
         חיפוש נוסף, לא שדה/עמודה, לכן לא "מזהם" את המסכים המקוריים. -->
    <record id="account_payment_view_search_l10n_il_employee_filter" model="ir.ui.view">
        <field name="name">account.payment.view.search.inherit.l10n.il.employee.filter</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="outbound_filter" position="after">
                <filter name="l10n_il_filter_employee" string="תשלומי עובדים" domain="[('partner_id.employee_ids', '!=', False)]"/>
            </filter>
        </field>
    </record>

    <record id="l10n_il_account_payment_view_list" model="ir.ui.view">
        <field name="name">account.payment.view.list.l10n.il.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">עובד</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="l10n_il_employee_payment_type" optional="show"/>
                <field name="l10n_il_affects_payroll" optional="hide"/>
                <field name="l10n_il_batch_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="l10n_il_account_payment_view_search" model="ir.ui.view">
        <field name="name">account.payment.view.search.l10n.il.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">עובד</attribute>
            </field>
            <filter name="state_in_process" position="after">
                <filter name="state_paid" string="שולם" domain="[('state', '=', 'paid')]"/>
            </filter>
            <filter name="reconciled" position="after">
                <filter name="filter_off_cycle" string="תשלומי עובד בודדים (Off-Cycle)" domain="[('partner_id.employee_ids', '!=', False), ('l10n_il_batch_id', '=', False)]"/>
            </filter>
            <filter name="paymentmethodline" position="after">
                <filter name="group_by_batch" string="מחזור תשלומים" context="{'group_by': 'l10n_il_batch_id'}"/>
            </filter>
        </field>
    </record>

    <record id="action_l10n_il_account_payment" model="ir.actions.act_window">
        <field name="name">תשלומים</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'default_partner_type': 'supplier', 'search_default_l10n_il_filter_employee': 1}</field>
        <field name="search_view_id" ref="l10n_il_account_payment_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">רישום תשלום עובד ראשון</p>
            <p>אותה טבלת תשלומים בדיוק כמו בהנהלת חשבונות - הפילטר "תשלומי עובדים" מוצג כברירת מחדל, ניתן להסיר אותו כדי לראות גם תשלומי לקוחות/ספקים. תשלום שמסומן "השפעה על שכר" נאסף אוטומטית לתלוש השכר הבא של העובד ומסומן כשולם. ליצירה קבוצתית השתמשו במחזורי תשלומים.</p>
        </field>
    </record>
    <record id="action_l10n_il_account_payment_list_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="l10n_il_account_payment_view_list"/>
        <field name="act_window_id" ref="action_l10n_il_account_payment"/>
    </record>
    <record id="action_l10n_il_account_payment_form_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_il_account_payment_view_form"/>
        <field name="act_window_id" ref="action_l10n_il_account_payment"/>
    </record>

    <!-- ==== אשף יצירת מחזור: שלב 1 - פרטים משותפים (מוגדר לפני הרשימה שמפנה אליו) ==== -->
    <record id="l10n_il_payment_batch_wizard_view_form_step1" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.wizard.view.form.step1</field>
        <field name="model">l10n.il.payment.batch.wizard</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="מחזור תשלומים חדש">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="payment_type" widget="radio" options="{'horizontal': True}"/>
                        <field name="l10n_il_employee_payment_type"/>
                        <field name="date"/>
                        <field name="memo"/>
                    </group>
                    <group>
                        <field name="l10n_il_affects_payroll"/>
                        <field name="journal_id"/>
                        <field name="payment_method_line_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_next" type="object" string="הבא" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_il_payment_batch_wizard" model="ir.actions.act_window">
        <field name="name">מחזור תשלומים חדש</field>
        <field name="res_model">l10n.il.payment.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_il_payment_batch_wizard_view_form_step1"/>
        <field name="target">new</field>
    </record>

    <!-- ==== אשף יצירת מחזור: שלב 2 - עובדים וסכומים ==== -->
    <record id="l10n_il_payment_batch_wizard_view_form_step2" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.wizard.view.form.step2</field>
        <field name="model">l10n.il.payment.batch.wizard</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="מחזור תשלומים - עובדים וסכומים">
                <group>
                    <field name="name" readonly="1"/>
                    <field name="date" readonly="1"/>
                </group>
                <group>
                    <field name="set_all_amount"/>
                    <button name="action_set_all_amount" type="object" string="הגדר לכולם"/>
                    <button name="action_reset_advance_amounts" type="object" string="איפוס"
                        invisible="l10n_il_employee_payment_type != 'advance'"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false">
                        <field name="included"/>
                        <field name="employee_id" widget="many2one_avatar_employee" readonly="1"/>
                        <field name="amount" readonly="not included" required="included"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_batch" type="object" string="יצירת המחזור" class="btn-primary"/>
                    <button name="action_back" type="object" string="חזור"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==== מחזורי תשלומים ==== -->
    <record id="l10n_il_payment_batch_view_list" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.view.list</field>
        <field name="model">l10n.il.payment.batch</field>
        <field name="arch" type="xml">
            <list string="מחזורי תשלומים" create="false">
                <header>
                    <button name="%(action_l10n_il_payment_batch_wizard)d" type="action" string="חדש" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="date"/>
                <field name="total_amount" sum="סה״כ"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="l10n_il_payment_batch_view_form" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.view.form</field>
        <field name="model">l10n.il.payment.batch</field>
        <field name="arch" type="xml">
            <form string="מחזור תשלומים">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="שם המחזור"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="תשלומים" name="payments">
                            <field name="payment_ids">
                                <list>
                                    <field name="partner_id" string="עובד"/>
                                    <field name="date"/>
                                    <field name="l10n_il_employee_payment_type"/>
                                    <field name="payment_type"/>
                                    <field name="amount" sum="סה״כ"/>
                                    <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'in_process'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_l10n_il_payment_batch" model="ir.actions.act_window">
        <field name="name">מחזורי תשלומים</field>
        <field name="res_model">l10n.il.payment.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">יצירת מחזור תשלומים ראשון</p>
            <p>מחזור תשלומים יוצר תשלום לכל עובד שנבחר. במקרה של מחזור מפרעות - רק עובדים שמסומן אצלם "קיים מפרעה" מוצגים, עם סכום ברירת המחדל שהוגדר לכל עובד.</p>
        </field>
    </record>

    <!-- ==== תפריטים ==== -->
    <menuitem id="menu_l10n_il_account_payment"
        name="תשלומים"
        action="action_l10n_il_account_payment"
        parent="hr_payroll.menu_hr_payroll_payslips"
        sequence="30"/>
    <menuitem id="menu_l10n_il_payment_batch"
        name="מחזורי תשלומים"
        action="action_l10n_il_payment_batch"
        parent="hr_payroll.menu_hr_payroll_payslips"
        sequence="31"/>

    <!-- ==== תפריט "עובדים" בהנהלת חשבונות, ליד "לקוחות"/"ספקים" - אותם
         view/action בדיוק כמו תחת שכר, רק נגיש גם מהנהלת חשבונות ==== -->
    <menuitem id="menu_l10n_il_finance_employees"
        name="עובדים"
        parent="account.menu_finance"
        sequence="3"/>
    <menuitem id="menu_l10n_il_finance_employees_payments"
        name="תשלומים"
        action="action_l10n_il_account_payment"
        parent="menu_l10n_il_finance_employees"
        sequence="1"/>
    <menuitem id="menu_l10n_il_finance_employees_batches"
        name="מחזורי תשלומים"
        action="action_l10n_il_payment_batch"
        parent="menu_l10n_il_finance_employees"
        sequence="2"/>
    <menuitem id="menu_l10n_il_finance_employees_list"
        name="עובדים"
        action="hr.open_view_employee_list_my"
        parent="menu_l10n_il_finance_employees"
        sequence="3"/>

    <!-- ==== טאב תשלומים בתלוש ==== -->
    <record id="view_hr_payslip_form_l10n_il_payments" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit.l10n.il.payments</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="תשלומים" name="l10n_il_payments">
                    <field name="l10n_il_payment_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="l10n_il_employee_payment_type"/>
                            <field name="memo"/>
                            <field name="payment_type"/>
                            <field name="amount" sum="סה״כ"/>
                            <field name="state" widget="badge" decoration-success="state == 'paid'"/>
                            <field name="l10n_il_batch_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
