<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_il_payslip_report_view_pivot" model="ir.ui.view">
        <field name="name">l10n.il.payslip.report.view.pivot</field>
        <field name="model">l10n.il.payslip.report</field>
        <field name="arch" type="xml">
            <pivot string="דוח שכר" sample="1">
                <field name="month" type="row"/>
                <field name="gross" type="measure"/>
                <field name="income_tax" type="measure"/>
                <field name="nii_employee" type="measure"/>
                <field name="health_employee" type="measure"/>
                <field name="net" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="l10n_il_payslip_report_view_list" model="ir.ui.view">
        <field name="name">l10n.il.payslip.report.view.list</field>
        <field name="model">l10n.il.payslip.report</field>
        <field name="arch" type="xml">
            <list string="דוח שכר">
                <field name="employee_id"/>
                <field name="department_id" optional="hide"/>
                <field name="month"/>
                <field name="year" optional="hide"/>
                <field name="state" optional="show"/>
                <field name="basic" sum="סה״כ" optional="show"/>
                <field name="overtime" sum="סה״כ" optional="hide"/>
                <field name="other_allowances" sum="סה״כ" optional="hide"/>
                <field name="gross" sum="סה״כ"/>
                <field name="income_tax" sum="סה״כ"/>
                <field name="nii_employee" sum="סה״כ"/>
                <field name="health_employee" sum="סה״כ"/>
                <field name="pension_employee" sum="סה״כ" optional="show"/>
                <field name="hishtalmut_employee" sum="סה״כ" optional="hide"/>
                <field name="net_to_pay_adjustments" sum="סה״כ" optional="hide"/>
                <field name="net_to_pay" sum="סה״כ" optional="show"/>
                <field name="other_deductions" sum="סה״כ" optional="hide"/>
                <field name="net" sum="סה״כ"/>
                <field name="pension_employer" sum="סה״כ" optional="hide"/>
                <field name="severance_employer" sum="סה״כ" optional="hide"/>
                <field name="hishtalmut_employer" sum="סה״כ" optional="hide"/>
                <field name="nii_employer" sum="סה״כ" optional="hide"/>
                <field name="employer_cost" sum="סה״כ" optional="hide"/>
                <field name="pension_fund_id" optional="hide"/>
                <field name="hishtalmut_fund_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="l10n_il_payslip_report_view_graph" model="ir.ui.view">
        <field name="name">l10n.il.payslip.report.view.graph</field>
        <field name="model">l10n.il.payslip.report</field>
        <field name="arch" type="xml">
            <graph string="דוח שכר" type="bar" sample="1">
                <field name="month"/>
                <field name="gross" type="measure"/>
                <field name="employer_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="l10n_il_payslip_report_view_search" model="ir.ui.view">
        <field name="name">l10n.il.payslip.report.view.search</field>
        <field name="model">l10n.il.payslip.report</field>
        <field name="arch" type="xml">
            <search string="דוח שכר">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="pension_fund_id"/>
                <filter name="filter_confirmed" string="מאושרים ושולמו בלבד" domain="[('state', 'in', ('validated', 'paid'))]"/>
                <separator/>
                <filter name="filter_date" string="תקופה" date="date_from" default_period="year"/>
                <group>
                    <filter name="group_by_employee" string="עובד" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_department" string="מחלקה" context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_month" string="חודש" context="{'group_by': 'month'}"/>
                    <filter name="group_by_year" string="שנת מס" context="{'group_by': 'year'}"/>
                    <filter name="group_by_pension_fund" string="קרן פנסיה" context="{'group_by': 'pension_fund_id'}"/>
                    <filter name="group_by_hishtalmut_fund" string="קרן השתלמות" context="{'group_by': 'hishtalmut_fund_id'}"/>
                    <filter name="group_by_state" string="סטטוס" context="{'group_by': 'state'}"/>
                    <filter name="group_by_company" string="חברה" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ריכוז חודשי לדיווח 102: שכר, מס שנוכה, ביטוח לאומי עובד+מעסיק -->
    <record id="action_l10n_il_report_102" model="ir.actions.act_window">
        <field name="name">ריכוז ניכויים חודשי (102)</field>
        <field name="res_model">l10n.il.payslip.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="search_view_id" ref="l10n_il_payslip_report_view_search"/>
        <field name="context">{
            'search_default_filter_confirmed': 1,
            'pivot_row_groupby': ['month'],
            'pivot_measures': ['gross', 'income_tax', 'nii_employee', 'health_employee', 'nii_employer'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">אין עדיין תלושים מאושרים</p>
            <p>הסכומים החודשיים המשמשים לדיווח 102 לרשות המסים ולביטוח הלאומי: שכר ששולם, מס הכנסה שנוכה, ודמי ביטוח לאומי ובריאות (עובד + מעסיק). יש לאשר תלושים כדי שיופיעו כאן.</p>
        </field>
    </record>

    <!-- ריכוז שנתי לעובד, בסיס לטופס 106 -->
    <record id="action_l10n_il_report_106" model="ir.actions.act_window">
        <field name="name">ריכוז שנתי לעובד (106)</field>
        <field name="res_model">l10n.il.payslip.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="search_view_id" ref="l10n_il_payslip_report_view_search"/>
        <field name="context">{
            'search_default_filter_confirmed': 1,
            'search_default_filter_date': 1,
            'pivot_row_groupby': ['employee_id'],
            'pivot_measures': ['gross', 'income_tax', 'nii_employee', 'health_employee', 'pension_employee', 'hishtalmut_employee', 'net'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">אין עדיין תלושים מאושרים</p>
            <p>סיכום שנתי לכל עובד — הבסיס לטופס 106 שחובה למסור לכל עובד עד 31 במרץ של השנה העוקבת: סך ברוטו, מס שנוכה, ביטוח לאומי ובריאות, והפרשות לפנסיה ולקרן השתלמות.</p>
        </field>
    </record>

    <!-- הפרשות לקרנות פנסיה והשתלמות -->
    <record id="action_l10n_il_report_funds" model="ir.actions.act_window">
        <field name="name">הפרשות לקרנות</field>
        <field name="res_model">l10n.il.payslip.report</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="l10n_il_payslip_report_view_search"/>
        <field name="context">{
            'search_default_filter_confirmed': 1,
            'pivot_row_groupby': ['pension_fund_id', 'employee_id'],
            'pivot_column_groupby': ['month'],
            'pivot_measures': ['pension_employee', 'pension_employer', 'severance_employer', 'hishtalmut_employee', 'hishtalmut_employer'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">אין עדיין תלושים מאושרים</p>
            <p>הסכומים שחובה להעביר לקרנות הפנסיה וההשתלמות בגין כל עובד — הבסיס לדיווח הממשק האחיד (מסלקה פנסיונית). ההעברה חייבת להתבצע עד 7 ימי עסקים מתשלום השכר.</p>
        </field>
    </record>

    <!-- עלות מעסיק -->
    <record id="action_l10n_il_report_cost" model="ir.actions.act_window">
        <field name="name">עלות מעסיק</field>
        <field name="res_model">l10n.il.payslip.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="l10n_il_payslip_report_view_search"/>
        <field name="context">{
            'search_default_filter_confirmed': 1,
            'pivot_row_groupby': ['month'],
            'pivot_measures': ['gross', 'pension_employer', 'severance_employer', 'hishtalmut_employer', 'nii_employer', 'employer_cost'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">אין עדיין תלושים מאושרים</p>
            <p>העלות האמיתית של כל עובד לחברה: ברוטו + הפרשות מעסיק לפנסיה, פיצויים, קרן השתלמות וביטוח לאומי.</p>
        </field>
    </record>

    <record id="hr_employee_view_search_l10n_il" model="ir.ui.view">
        <field name="name">hr.employee.view.search.inherit.l10n.il</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <filter name="group_manager" position="after">
                <filter name="group_by_form101" string="סטטוס טופס 101" context="{'group_by': 'l10n_il_form101_state'}" groups="hr_payroll.group_hr_payroll_user"/>
            </filter>
        </field>
    </record>

    <menuitem id="menu_l10n_il_report_102"
        name="ריכוז ניכויים חודשי (102)"
        action="action_l10n_il_report_102"
        parent="hr_payroll.menu_hr_payroll_report"
        sequence="50"/>
    <menuitem id="menu_l10n_il_report_106"
        name="ריכוז שנתי לעובד (106)"
        action="action_l10n_il_report_106"
        parent="hr_payroll.menu_hr_payroll_report"
        sequence="51"/>
    <menuitem id="menu_l10n_il_report_funds"
        name="הפרשות לקרנות"
        action="action_l10n_il_report_funds"
        parent="hr_payroll.menu_hr_payroll_report"
        sequence="52"/>
    <menuitem id="menu_l10n_il_report_cost"
        name="עלות מעסיק"
        action="action_l10n_il_report_cost"
        parent="hr_payroll.menu_hr_payroll_report"
        sequence="53"/>
</odoo>
