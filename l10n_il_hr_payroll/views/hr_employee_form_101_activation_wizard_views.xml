<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_101_activation_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.form.101.activation.wizard.form</field>
        <field name="model">hr.employee.form.101.activation.wizard</field>
        <field name="arch" type="xml">
            <form string="החלפת טופס 101 פעיל">
                <div class="alert alert-warning" role="alert">
                    <field name="warning_message" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <field name="active_form_id"/>
                    <field name="form_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="החלף והמשך"
                            class="btn-primary"/>
                    <button string="ביטול" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
