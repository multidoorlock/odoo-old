<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_overtime_rule_morning_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.rule.morning.form</field>
        <field name="model">hr.attendance.overtime.rule</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_overtime_rule_view_form"/>
        <field name="arch" type="xml">
            <field name="timing_type" position="after">
                <field name="mdl_morning_shift_only"
                       invisible="base_off != 'timing' or timing_type != 'work_days'"/>
            </field>
        </field>
    </record>
</odoo>
