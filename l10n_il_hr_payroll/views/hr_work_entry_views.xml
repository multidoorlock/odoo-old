<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- שדות ביקורת ברשומת העבודה (סעיף 19 באפיון) -->
    <record id="mdl_payroll_hr_work_entry_view_form" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.work.entry.view.form</field>
        <field name="model">hr.work.entry</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="נתוני נוכחות (בקרה)" name="mdl_audit" colspan="2">
                    <field name="mdl_actual_hours" widget="float_time"/>
                    <field name="mdl_normalized_hours" widget="float_time"/>
                    <field name="mdl_rate_category"/>
                    <field name="mdl_shift_type"/>
                    <field name="mdl_rounding_reason"/>
                    <field name="mdl_source_attendance_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="mdl_payroll_hr_work_entry_view_tree" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.work.entry.view.list</field>
        <field name="model">hr.work.entry</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="mdl_rate_category" optional="hide"/>
                <field name="mdl_shift_type" optional="hide"/>
                <field name="mdl_actual_hours" optional="hide" widget="float_time"/>
                <field name="mdl_rounding_reason" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
