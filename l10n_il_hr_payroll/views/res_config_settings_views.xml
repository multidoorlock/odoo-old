<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- הגדרות חברה: ימי סוף שבוע והגדרות משמרות (סעיפים 9, 20 באפיון) -->
    <record id="mdl_payroll_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">mdl.payroll.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="after">
                <block title="שכר ישראלי" id="mdl_payroll_settings">
                    <setting string="הגדרות משמרות" id="mdl_shift_settings"
                             help="משך משמרת בוקר, משך משמרת ערב ושעת החיתוך לזיהוי סוג המשמרת — ברמת החברה">
                        <div class="content-group mt8">
                            <group>
                                <field name="mdl_shift_morning_hours" widget="float_time"/>
                                <field name="mdl_shift_evening_hours" widget="float_time"/>
                                <field name="mdl_shift_cutoff" widget="float_time"/>
                            </group>
                        </div>
                    </setting>
                    <setting string="סוג עבודה ליום נוסף" id="mdl_additional_day_work_entry_type"
                             help="שעות בסוג עבודה זה יחושבו בתלוש לפי תעריף יום נוסף שהוגדר לעובד, לפי שעות העבודה וסוג השכר — ברוטו או נטו.">
                        <field name="mdl_additional_day_work_entry_type_id"
                               options="{'no_create': True}"
                               domain="[('is_extra_hours', '=', True), ('is_leave', '=', False)]"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
