<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- לשונית השכר בכרטיס העובד: הסתרת שדות השכר הסטנדרטיים והצגת שכבת
         ההגדרה העסקית (סעיפים 4–6, 8 באפיון). הנתונים נשמרים על גרסת
         תנאי ההעסקה הפעילה (hr.version) באמצעות מנגנון הדלגציה הסטנדרטי. -->
    <record id="mdl_payroll_hr_employee_view_form" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <!-- הסתרת השדות הסטנדרטיים (לא נמחקים — ממשיכים לשמש את Odoo).
                 הסתרת שורת השכר כולה מסלקת גם את מפריד ה־"/" של מחזור התשלום. -->
            <xpath expr="//field[@name='wage_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='hourly_wage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='hourly_wage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='wage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='wage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- תוויות בעברית לשדות הסטנדרטיים שנשארים -->
            <xpath expr="//field[@name='structure_type_id']" position="attributes">
                <attribute name="string">קטגוריית שכר</attribute>
                <attribute name="placeholder">ללא קטגוריה — לא ייכלל בחישובי שכר</attribute>
            </xpath>

            <!-- עמודת "שכר" לצד עמודת החוזה -->
            <xpath expr="//group[@name='contract']" position="after">
                <group name="mdl_wage" string="שכר">
                    <field name="mdl_resource_calendar_type" invisible="1"/>
                    <field name="mdl_wage_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="mdl_wage_rate_type" widget="radio"
                           options="{'horizontal': true}"/>
                    <field name="mdl_monthly_wage" invisible="mdl_wage_type != 'mdl_monthly'"/>
                    <field name="mdl_daily_wage" string="שכר יומי מותאם"
                           readonly="mdl_wage_type == 'mdl_monthly'" force_save="1"/>
                    <field name="mdl_hourly_wage" string="תעריף שעה" readonly="1" force_save="1"/>
                    <field name="mdl_additional_day_wage" string="תעריף יום נוסף"/>
                    <field name="mdl_additional_day_hourly_wage" readonly="1"/>
                    <field name="schedule_pay" string="מחזור תשלום" readonly="1" force_save="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
