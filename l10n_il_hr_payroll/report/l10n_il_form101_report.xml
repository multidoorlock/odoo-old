<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_form101" model="ir.actions.report">
        <field name="name">טופס 101</field>
        <field name="model">l10n.il.form101</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_il_hr_payroll.report_form101</field>
        <field name="report_file">l10n_il_hr_payroll.report_form101</field>
        <field name="print_report_name">'טופס 101 - %s - %s' % (object.employee_id.name, object.tax_year)</field>
        <field name="binding_model_id" ref="model_l10n_il_form101"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_form101">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" dir="rtl" style="direction: rtl; text-align: right; font-size: 12px;">
                        <h3 style="text-align: center;">כרטיס עובד ובקשה להקלה ולתיאום מס — טופס 101</h3>
                        <h4 style="text-align: center;">שנת המס <span t-esc="o.tax_year"/></h4>

                        <h5 style="background-color: #eee; padding: 4px;">חלק א — פרטי המעביד</h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><strong>שם המעביד:</strong> <span t-field="o.company_id.name"/></td>
                                <td><strong>תיק ניכויים:</strong> <span t-field="o.employer_deduction_file"/></td>
                                <td><strong>מספר חברה (ח״פ):</strong> <span t-field="o.company_id.vat"/></td>
                            </tr>
                            <tr>
                                <td colspan="3"><strong>כתובת:</strong>
                                    <span t-field="o.company_id.street"/> <span t-field="o.company_id.city"/> <span t-field="o.company_id.zip"/>
                                </td>
                            </tr>
                        </table>

                        <h5 style="background-color: #eee; padding: 4px;">חלק ב — פרטי העובד</h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><strong>שם מלא:</strong> <span t-field="o.employee_id.name"/></td>
                                <td><strong>מספר זהות:</strong> <span t-field="o.identification_id"/></td>
                                <td><strong>תאריך לידה:</strong> <span t-field="o.birthday"/></td>
                            </tr>
                            <tr>
                                <td><strong>מין:</strong> <span t-field="o.sex"/></td>
                                <td><strong>מצב משפחתי:</strong> <span t-field="o.marital"/></td>
                                <td><strong>תאריך עלייה:</strong> <span t-field="o.l10n_il_aliyah_date"/></td>
                            </tr>
                            <tr>
                                <td colspan="2"><strong>כתובת:</strong>
                                    <span t-field="o.private_street"/> <span t-field="o.private_city"/> <span t-field="o.private_zip"/>
                                </td>
                                <td><strong>טלפון:</strong> <span t-field="o.private_phone"/></td>
                            </tr>
                            <tr>
                                <td colspan="2"><strong>דוא״ל:</strong> <span t-field="o.private_email"/></td>
                                <td><strong>קופת חולים:</strong> <span t-field="o.kupat_holim"/></td>
                            </tr>
                        </table>

                        <h5 style="background-color: #eee; padding: 4px;">חלק ג — פרטים על ילדיי</h5>
                        <table class="table table-sm table-bordered" t-if="o.child_ids">
                            <thead>
                                <tr>
                                    <th>שם הילד/ה</th>
                                    <th>מספר זהות</th>
                                    <th>תאריך לידה</th>
                                    <th>בחזקתי</th>
                                    <th>מקבל/ת קצבת ילדים</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.child_ids" t-as="child">
                                    <td><span t-field="child.name"/></td>
                                    <td><span t-field="child.identification_id"/></td>
                                    <td><span t-field="child.birthdate"/></td>
                                    <td><span t-esc="'☑' if child.in_custody else '☐'"/></td>
                                    <td><span t-esc="'☑' if child.receives_child_allowance else '☐'"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="">אין ילדים רשומים.</p>

                        <h5 style="background-color: #eee; padding: 4px;">חלק ד — פרטים על הכנסתי</h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><strong>סוג הכנסה:</strong> <span t-field="o.pay_basis"/></td>
                                <td><span t-esc="'☑' if o.is_main_employer else '☐'"/> הכנסה עיקרית</td>
                                <td><span t-esc="'☑' if o.has_other_income else '☐'"/> יש לי הכנסות נוספות ממשכורת</td>
                            </tr>
                        </table>

                        <h5 style="background-color: #eee; padding: 4px;">חלק ה — פרטי בן/בת הזוג</h5>
                        <table class="table table-sm table-bordered" t-if="o.marital in ('married', 'cohabitant')">
                            <tr>
                                <td><strong>שם:</strong> <span t-field="o.spouse_complete_name"/></td>
                                <td><strong>מספר זהות:</strong> <span t-field="o.spouse_id_number"/></td>
                                <td><strong>תאריך לידה:</strong> <span t-field="o.spouse_birthdate"/></td>
                                <td><span t-esc="'☑' if o.spouse_has_income else '☐'"/> יש הכנסה</td>
                            </tr>
                        </table>
                        <p t-else="">לא רלוונטי.</p>

                        <h5 style="background-color: #eee; padding: 4px;">חלק ז — בקשה לפטור או זיכוי ממס</h5>
                        <table class="table table-sm table-bordered">
                            <tr><td><span t-esc="'☑' if o.is_resident else '☐'"/> אני תושב/ת ישראל</td>
                                <td><span t-esc="'☑' if o.is_disabled_blind else '☐'"/> נכה/עיוור לפי סעיף 9(5)</td></tr>
                            <tr><td><span t-esc="'☑' if o.is_settlement_resident else '☐'"/> תושב/ת יישוב מזכה
                                    <t t-if="o.is_settlement_resident">(קוד: <span t-field="o.settlement_code"/>, מתאריך: <span t-field="o.settlement_date_from"/>)</t></td>
                                <td><span t-esc="'☑' if o.is_new_immigrant else '☐'"/> עולה חדש/ה</td></tr>
                            <tr><td><span t-esc="'☑' if o.spouse_no_income else '☐'"/> בן/בת זוג ללא הכנסות</td>
                                <td><span t-esc="'☑' if o.is_single_parent else '☐'"/> הורה יחיד</td></tr>
                            <tr><td><span t-esc="'☑' if o.pays_alimony else '☐'"/> משלם/ת מזונות</td>
                                <td><span t-esc="'☑' if o.is_discharged_soldier else '☐'"/> חייל/ת משוחרר/ת
                                    <t t-if="o.is_discharged_soldier">(שחרור: <span t-field="o.service_end_date"/>)</t></td></tr>
                            <tr><td><span t-esc="'☑' if o.completed_degree else '☐'"/> סיום תואר/תעודת מקצוע</td>
                                <td><span t-esc="'☑' if o.has_disabled_child else '☐'"/> ילד נטול יכולת</td></tr>
                        </table>

                        <h5 style="background-color: #eee; padding: 4px;">חלק ח — בקשה לתיאום מס</h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><span t-esc="'☑' if o.request_tax_coordination else '☐'"/> אני מבקש/ת תיאום מס</td>
                                <td t-if="o.request_tax_coordination"><strong>סיבה:</strong> <span t-field="o.coordination_reason"/></td>
                            </tr>
                        </table>

                        <h5 style="background-color: #eee; padding: 4px;">נקודות זיכוי</h5>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><strong>בסיס (תושב):</strong> <span t-esc="'%.2f' % o.credit_points_base"/></td>
                                <td><strong>אישה:</strong> <span t-esc="'%.2f' % o.credit_points_woman"/></td>
                                <td><strong>נוספות:</strong> <span t-esc="'%.2f' % o.credit_points_extra"/></td>
                                <td><strong>סה״כ:</strong> <span t-esc="'%.2f' % o.credit_points_total"/></td>
                            </tr>
                        </table>

                        <h5 style="background-color: #eee; padding: 4px;">חלק ט — הצהרה</h5>
                        <p>אני מצהיר/ה בזה כי הפרטים שמסרתי בטופס זה הם נכונים ומלאים. ידוע לי שמסירת פרטים לא נכונים היא עבירה על פקודת מס הכנסה.</p>
                        <table class="table table-sm" style="margin-top: 24px;">
                            <tr>
                                <td style="width: 33%;"><strong>תאריך:</strong> <span t-field="o.date_signed"/></td>
                                <td style="width: 33%;"><strong>שם העובד/ת:</strong> <span t-field="o.employee_id.name"/></td>
                                <td style="width: 33%;"><strong>חתימה:</strong> ______________</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
