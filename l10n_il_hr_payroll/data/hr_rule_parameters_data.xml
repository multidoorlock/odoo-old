<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ מס הכנסה ============ -->

    <!-- שווי נקודת זיכוי חודשית -->
    <record id="rule_parameter_il_credit_point_value" model="hr.rule.parameter">
        <field name="name">ישראל: שווי נקודת זיכוי חודשית</field>
        <field name="code">l10n_il_credit_point_value</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>שווי נקודת זיכוי אחת בש״ח לחודש, לפי חוברת הניכויים של רשות המסים. הוקפא בשנים 2025–2027.</p>
        </field>
    </record>
    <record id="rule_parameter_il_credit_point_value_2025" model="hr.rule.parameter.value">
        <field name="parameter_value">242</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_credit_point_value"/>
        <field name="date_from" eval="datetime(2025, 1, 1).date()"/>
    </record>

    <!-- מדרגות מס הכנסה חודשיות: (מסכום, עד סכום, שיעור). המדרגה העליונה כוללת מס יסף 3% -->
    <record id="rule_parameter_il_tax_brackets" model="hr.rule.parameter">
        <field name="name">ישראל: מדרגות מס הכנסה (חודשי)</field>
        <field name="code">l10n_il_tax_brackets</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>מדרגות מס חודשיות לפי חוברת הניכויים 2026 (כולל תיקון 121): רשימת (מסכום, עד סכום, שיעור).
            המדרגה האחרונה עם None = ללא תקרה, בשיעור 50% הכולל מס יסף 3% מעל 60,130 ₪ לחודש (721,560 ₪ לשנה).</p>
        </field>
    </record>
    <record id="rule_parameter_il_tax_brackets_2026" model="hr.rule.parameter.value">
        <field name="parameter_value">[
    (0, 7010, 0.10),
    (7010, 10060, 0.14),
    (10060, 19000, 0.20),
    (19000, 25100, 0.31),
    (25100, 46690, 0.35),
    (46690, 60130, 0.47),
    (60130, None, 0.50),
]</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_tax_brackets"/>
        <field name="date_from" eval="datetime(2026, 1, 1).date()"/>
    </record>

    <!-- שיעור זיכוי מס בעד הפקדות עובד לפנסיה (סעיף 45א לפקודה) -->
    <record id="rule_parameter_il_pension_tax_credit_rate" model="hr.rule.parameter">
        <field name="name">ישראל: שיעור זיכוי מס בעד פנסיית עובד</field>
        <field name="code">l10n_il_pension_tax_credit_rate</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>שיעור הזיכוי ממס בעד ניכוי העובד לקופת גמל לקצבה לפי סעיף 45א לפקודה: 35%.
            תקרת הניכוי המזכה מנוהלת בפרמטר נפרד.</p>
        </field>
    </record>
    <record id="rule_parameter_il_pension_tax_credit_rate_2025" model="hr.rule.parameter.value">
        <field name="parameter_value">0.35</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_pension_tax_credit_rate"/>
        <field name="date_from" eval="datetime(2025, 1, 1).date()"/>
    </record>

    <!-- ============ ביטוח לאומי ודמי בריאות ============ -->

    <record id="rule_parameter_il_nii_rates" model="hr.rule.parameter">
        <field name="name">ישראל: ביטוח לאומי ודמי בריאות (עובד שכיר)</field>
        <field name="code">l10n_il_nii_rates</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>מדרגות ושיעורים לעובד שכיר תושב ישראל (טור 1), לפי לוחות ביטוח לאומי 2026:</p>
            <ul>
                <li>מדרגה מופחתת עד 7,703 ₪: עובד — ביטוח לאומי 1.04% + בריאות 3.23%; מעסיק — 4.51%</li>
                <li>מדרגה מלאה עד תקרה 51,910 ₪: עובד — ביטוח לאומי 7% + בריאות 5.17%; מעסיק — 7.60%</li>
            </ul>
        </field>
    </record>
    <record id="rule_parameter_il_nii_rates_2026" model="hr.rule.parameter.value">
        <field name="parameter_value">{
    'reduced_ceiling': 7703.0,
    'max_ceiling': 51910.0,
    'employee_nii_reduced': 0.0104,
    'employee_nii_full': 0.07,
    'employee_health_reduced': 0.0323,
    'employee_health_full': 0.0517,
    'employer_reduced': 0.0451,
    'employer_full': 0.076,
}</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_nii_rates"/>
        <field name="date_from" eval="datetime(2026, 1, 1).date()"/>
    </record>

    <!-- עובד תושב יהודה/שומרון/עזה (l10n_il_employee_category='palestinian') - ללא ביטוח
         בריאות כלל (המעסיק רוכש עבורו ביטוח בריאות פרטי בנפרד, מחוץ לתלוש) ובשיעורי
         ביטוח לאומי מופחתים משמעותית מתושב ישראל. מקור: btl.gov.il, "שיעורי דמי הביטוח
         לתושב חוץ" + "ביטוח לאומי לעובדים פלסטינים" (כל-זכות), תוקף 01.01.2026. -->
    <record id="rule_parameter_il_nii_rates_west_bank" model="hr.rule.parameter">
        <field name="name">ישראל: ביטוח לאומי - עובד תושב יהודה/שומרון/עזה</field>
        <field name="code">l10n_il_nii_rates_west_bank</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>שיעורי ביטוח לאומי לעובד תושב האזור (יהודה/שומרון/עזה) המועסק בישראל/באזור,
            לפי לוחות ביטוח לאומי 2026. אין ביטוח בריאות במסגרת זו - המעסיק מחויב ברכישת
            ביטוח בריאות פרטי נפרד עבור העובד.</p>
            <ul>
                <li>מדרגה מופחתת עד 8,261 ₪: עובד — 0.07%; מעסיק — 0.71%</li>
                <li>מדרגה מלאה עד תקרה 51,910 ₪: עובד — 0.61%; מעסיק — 2.49%</li>
            </ul>
        </field>
    </record>
    <record id="rule_parameter_il_nii_rates_west_bank_2026" model="hr.rule.parameter.value">
        <field name="parameter_value">{
    'reduced_ceiling': 8261.0,
    'max_ceiling': 51910.0,
    'employee_nii_reduced': 0.0007,
    'employee_nii_full': 0.0061,
    'employee_health_reduced': 0.0,
    'employee_health_full': 0.0,
    'employer_reduced': 0.0071,
    'employer_full': 0.0249,
}</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_nii_rates_west_bank"/>
        <field name="date_from" eval="datetime(2026, 1, 1).date()"/>
    </record>

    <!-- עובד זר (l10n_il_employee_category='foreign', תושב חוץ שאינו תושב האזור) - גם כאן
         ללא ביטוח בריאות, בשיעורי ביטוח לאומי מופחתים אך שונים מתושב האזור. מקור: btl.gov.il,
         "שיעורי דמי הביטוח לתושב חוץ", תוקף 01.01.2026. -->
    <record id="rule_parameter_il_nii_rates_foreign" model="hr.rule.parameter">
        <field name="name">ישראל: ביטוח לאומי - עובד זר (תושב חוץ)</field>
        <field name="code">l10n_il_nii_rates_foreign</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>שיעורי ביטוח לאומי לעובד זר (תושב חוץ שאינו תושב יהודה/שומרון/עזה), לפי לוחות
            ביטוח לאומי 2026. אין ביטוח בריאות במסגרת זו - כמו בעובד תושב האזור.</p>
            <ul>
                <li>מדרגה מופחתת עד 7,703 ₪: עובד — 0.1%; מעסיק — 0.75%</li>
                <li>מדרגה מלאה עד תקרה 51,910 ₪: עובד — 0.87%; מעסיק — 2.65%</li>
            </ul>
        </field>
    </record>
    <record id="rule_parameter_il_nii_rates_foreign_2026" model="hr.rule.parameter.value">
        <field name="parameter_value">{
    'reduced_ceiling': 7703.0,
    'max_ceiling': 51910.0,
    'employee_nii_reduced': 0.001,
    'employee_nii_full': 0.0087,
    'employee_health_reduced': 0.0,
    'employee_health_full': 0.0,
    'employer_reduced': 0.0075,
    'employer_full': 0.0265,
}</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_nii_rates_foreign"/>
        <field name="date_from" eval="datetime(2026, 1, 1).date()"/>
    </record>

    <!-- ============ שכר מינימום ============ -->

    <record id="rule_parameter_il_minimum_wage" model="hr.rule.parameter">
        <field name="name">ישראל: שכר מינימום</field>
        <field name="code">l10n_il_minimum_wage</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>שכר המינימום החודשי והשעתי בש״ח לפי הודעות שכר המינימום. השעתי מחושב לפי 182 שעות לחודש.</p>
        </field>
    </record>
    <record id="rule_parameter_il_minimum_wage_2025" model="hr.rule.parameter.value">
        <field name="parameter_value">{'monthly': 6247.67, 'hourly': 34.33}</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_minimum_wage"/>
        <field name="date_from" eval="datetime(2025, 4, 1).date()"/>
    </record>
    <record id="rule_parameter_il_minimum_wage_2026" model="hr.rule.parameter.value">
        <field name="parameter_value">{'monthly': 6443.85, 'hourly': 35.41}</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_minimum_wage"/>
        <field name="date_from" eval="datetime(2026, 4, 1).date()"/>
    </record>

    <!-- ============ פנסיה ============ -->

    <record id="rule_parameter_il_pension_min_rates" model="hr.rule.parameter">
        <field name="name">ישראל: שיעורי פנסיית חובה מינימליים</field>
        <field name="code">l10n_il_pension_min_rates</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>השיעורים המינימליים לפי צו ההרחבה לפנסיית חובה מ-1.1.2017:
            עובד 6%, מעסיק 6.5%, פיצויים 6% — סה״כ 18.5%.</p>
        </field>
    </record>
    <record id="rule_parameter_il_pension_min_rates_2017" model="hr.rule.parameter.value">
        <field name="parameter_value">{'employee': 0.06, 'employer': 0.065, 'severance': 0.06}</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_pension_min_rates"/>
        <field name="date_from" eval="datetime(2017, 1, 1).date()"/>
    </record>

    <!-- ============ קרן השתלמות ============ -->

    <record id="rule_parameter_il_hishtalmut_ceiling" model="hr.rule.parameter">
        <field name="name">ישראל: תקרת שכר מוטבת לקרן השתלמות</field>
        <field name="code">l10n_il_hishtalmut_ceiling</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>תקרת השכר החודשית להפקדה מוטבת לקרן השתלמות לשכיר. הפקדת מעסיק מעל התקרה היא הכנסה חייבת בידי העובד.</p>
        </field>
    </record>
    <record id="rule_parameter_il_hishtalmut_ceiling_2025" model="hr.rule.parameter.value">
        <field name="parameter_value">15712</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_hishtalmut_ceiling"/>
        <field name="date_from" eval="datetime(2025, 1, 1).date()"/>
    </record>

    <!-- ============ הבראה ונסיעות ============ -->

    <record id="rule_parameter_il_havraa_day_value" model="hr.rule.parameter">
        <field name="name">ישראל: ערך יום הבראה (מגזר פרטי)</field>
        <field name="code">l10n_il_havraa_day_value</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>ערך יום הבראה בש״ח במגזר הפרטי לפי צו ההרחבה. ימי הזכאות לפי ותק: שנה 1: 5 ימים; שנים 2–3: 6;
            שנים 4–10: 7; שנים 11–15: 8; שנים 16–19: 9; שנה 20 ואילך: 10.</p>
        </field>
    </record>
    <record id="rule_parameter_il_havraa_day_value_2024" model="hr.rule.parameter.value">
        <field name="parameter_value">418</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_havraa_day_value"/>
        <field name="date_from" eval="datetime(2024, 7, 1).date()"/>
    </record>

    <!-- ימי זכאות להבראה לפי ותק (שנות עבודה מושלמות), אותם דרגים המתועדים
         כבר בתיאור הפרמטר למעלה - (משנה כוללת, עד שנה לא-כוללת, ימים) -->
    <record id="rule_parameter_il_havraa_eligible_days" model="hr.rule.parameter">
        <field name="name">ישראל: ימי זכאות הבראה לפי ותק</field>
        <field name="code">l10n_il_havraa_eligible_days</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>מדרגות ימי זכאות לדמי הבראה לפי ותק (שנות עבודה מושלמות) במגזר הפרטי:
            שנה 1: 5 ימים; שנים 2–3: 6; שנים 4–10: 7; שנים 11–15: 8; שנים 16–19: 9; שנה 20+: 10.</p>
        </field>
    </record>
    <record id="rule_parameter_il_havraa_eligible_days_2017" model="hr.rule.parameter.value">
        <field name="parameter_value">[
    (0, 1, 5),
    (1, 3, 6),
    (3, 10, 7),
    (10, 15, 8),
    (15, 19, 9),
    (19, None, 10),
]</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_havraa_eligible_days"/>
        <field name="date_from" eval="datetime(2017, 1, 1).date()"/>
    </record>

    <record id="rule_parameter_il_travel_daily_cap" model="hr.rule.parameter">
        <field name="name">ישראל: תקרת החזר נסיעות יומית</field>
        <field name="code">l10n_il_travel_daily_cap</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>התקרה היומית להחזר הוצאות נסיעה לעבודה וממנה לפי צו ההרחבה: 22.60 ₪ ליום עבודה.</p>
        </field>
    </record>
    <record id="rule_parameter_il_travel_daily_cap_2016" model="hr.rule.parameter.value">
        <field name="parameter_value">22.60</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_travel_daily_cap"/>
        <field name="date_from" eval="datetime(2016, 2, 1).date()"/>
    </record>

    <!-- ============ מחלה ============ -->

    <record id="rule_parameter_il_sick_pay_tiers" model="hr.rule.parameter">
        <field name="name">ישראל: מדרגות תשלום דמי מחלה</field>
        <field name="code">l10n_il_sick_pay_tiers</field>
        <field name="country_id" ref="base.il"/>
        <field name="description" type="html">
            <p>שיעור התשלום לפי מיקום היום ברצף המחלה, לפי חוק דמי מחלה:
            יום 1 — 0%; ימים 2–3 — 50%; מהיום ה-4 — 100%. הצבירה: 1.5 יום לחודש עבודה, עד 90 יום.</p>
        </field>
    </record>
    <record id="rule_parameter_il_sick_pay_tiers_1977" model="hr.rule.parameter.value">
        <field name="parameter_value">{'day1': 0.0, 'day2_3': 0.5, 'day4_plus': 1.0, 'monthly_accrual': 1.5, 'max_days': 90}</field>
        <field name="rule_parameter_id" ref="rule_parameter_il_sick_pay_tiers"/>
        <field name="date_from" eval="datetime(2000, 1, 1).date()"/>
    </record>
</odoo>
