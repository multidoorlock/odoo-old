<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- חופשה שנתית: צבירה לפי חוק חופשה שנתית, דורשת הקצאה -->
    <record id="leave_type_il_annual" model="hr.leave.type">
        <field name="name">חופשה שנתית</field>
        <field name="requires_allocation" eval="True"/>
        <field name="request_unit">day</field>
        <field name="leave_validation_type">manager</field>
        <field name="work_entry_type_id" ref="work_entry_type_il_annual"/>
        <field name="color">10</field>
        <field name="sequence">1</field>
    </record>

    <!-- מחלה: צבירה 1.5 יום לחודש עד 90 יום. התשלום המדורג מחושב בכלל שכר ייעודי -->
    <record id="leave_type_il_sick" model="hr.leave.type">
        <field name="name">מחלה</field>
        <field name="requires_allocation" eval="False"/>
        <field name="request_unit">day</field>
        <field name="leave_validation_type">hr</field>
        <field name="work_entry_type_id" ref="work_entry_type_il_sick"/>
        <field name="support_document" eval="True"/>
        <field name="color">7</field>
        <field name="sequence">2</field>
    </record>

    <!-- חופשה ללא תשלום -->
    <record id="leave_type_il_unpaid" model="hr.leave.type">
        <field name="name">חופשה ללא תשלום (חל״ת)</field>
        <field name="requires_allocation" eval="False"/>
        <field name="request_unit">day</field>
        <field name="leave_validation_type">both</field>
        <field name="work_entry_type_id" ref="work_entry_type_il_unpaid"/>
        <field name="color">5</field>
        <field name="sequence">3</field>
    </record>

    <!-- מילואים: בתשלום מלא, המעסיק מקבל החזר מביטוח לאומי -->
    <record id="leave_type_il_reserve" model="hr.leave.type">
        <field name="name">מילואים</field>
        <field name="requires_allocation" eval="False"/>
        <field name="request_unit">day</field>
        <field name="leave_validation_type">no_validation</field>
        <field name="work_entry_type_id" ref="work_entry_type_il_reserve"/>
        <field name="support_document" eval="True"/>
        <field name="color">4</field>
        <field name="sequence">4</field>
    </record>
</odoo>
