<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ניכויי חובה: מס הכנסה, ביטוח לאומי, בריאות, פנסיה עובד -->
    <record id="rule_category_il_statutory_ded" model="hr.salary.rule.category">
        <field name="name">ניכויי חובה</field>
        <field name="code">IL_STAT_DED</field>
        <field name="parent_id" ref="hr_payroll.DED"/>
        <field name="country_id" ref="base.il"/>
    </record>

    <!-- ניכויי רשות: מפרעות, הלוואות, ארוחות -->
    <record id="rule_category_il_other_ded" model="hr.salary.rule.category">
        <field name="name">ניכויי רשות</field>
        <field name="code">IL_OTHER_DED</field>
        <field name="parent_id" ref="hr_payroll.DED"/>
        <field name="country_id" ref="base.il"/>
    </record>

    <!-- הפרשות מעסיק: אינן משפיעות על הנטו, מוצגות כעלות מעסיק -->
    <record id="rule_category_il_employer" model="hr.salary.rule.category">
        <field name="name">הפרשות מעסיק</field>
        <field name="code">IL_EMPLOYER</field>
        <field name="country_id" ref="base.il"/>
    </record>

    <!-- ניכויי/תוספות זכות (התאמות שכר ששולמו, תשלומי עובד): עומדת בכוונה - אינה בת
         של DED, כדי שלא תשפיע על הנטו הרגיל (NET) אלא רק על "נטו לתשלום" (NET_TO_PAY) בנפרד -->
    <record id="rule_category_il_net_to_pay_ded" model="hr.salary.rule.category">
        <field name="name">ניכויי זכות (נטו לתשלום)</field>
        <field name="code">IL_NET_TO_PAY_DED</field>
        <field name="country_id" ref="base.il"/>
    </record>

    <!-- נטו לתשלום: שורת סיכום עצמאית (כמו GROSS/NET), לא בת של אף קטגוריה -->
    <record id="rule_category_il_net_to_pay" model="hr.salary.rule.category">
        <field name="name">נטו לתשלום</field>
        <field name="code">IL_NET_TO_PAY</field>
        <field name="country_id" ref="base.il"/>
    </record>
</odoo>
