    <record id="rule_ilm_pens_ee" model="hr.salary.rule">
        <field name="name">פנסיה - חלק עובד</field>
        <field name="code">IL_PENS_EE</field>
        <field name="sequence">110</field>
        <field name="category_id" ref="rule_category_il_statutory_ded"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
# עובד פלסטיני: הפרשות הפנסיה/פיצויים מנוהלות דרך רשות האוכלוסין ("עמיתים"),
# לא דרך התלוש - בכל תלושי הייחוס האמיתיים (שביט רונן, יוני 2026) שורות הגמל
# והפקדות המעסיק ריקות/0 עבור כל העובדים הפלסטינים.
result = categories['BASIC'] &gt; 0 and version.l10n_il_employee_category != 'palestinian'
</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
rate = version.l10n_il_pension_employee_rate
if not rate:
    rate = payslip._rule_parameter('l10n_il_pension_min_rates')['employee'] * 100
pension_base = categories['BASIC'] + payslip._l10n_il_pension_eligible_extra()
result = -pension_base * rate / 100.0
</field>
