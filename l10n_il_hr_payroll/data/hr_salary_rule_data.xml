result = categories['GROSS'] &gt; 0
</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
p = payslip._rule_parameter('l10n_il_nii_rates')
base = min(categories['GROSS'], p['max_ceiling'])
reduced = min(base, p['reduced_ceiling'])
full = max(base - p['reduced_ceiling'], 0.0)
result = -(reduced * p['employee_nii_reduced'] + full * p['employee_nii_full'])
</field>
        <field name="struct_id" ref="hr_payroll_structure_il_employee_salary"/>
    </record>
