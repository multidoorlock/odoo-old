    <record id="rule_ilm_inctax" model="hr.salary.rule">
        <field name="name">מס הכנסה</field>
        <field name="code">IL_INCTAX</field>
        <field name="sequence">120</field>
        <field name="category_id" ref="rule_category_il_statutory_ded"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = categories['GROSS'] &gt; 0
</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# הנוסחה עצמה חיה ב-hr.payslip._l10n_il_income_tax_for_gross (l10n_il_payslip_calc.py) -
# מקור אמת יחיד, נצרך גם ע"י פותר הגילום (gross-up) ב-l10n_il_hr_payroll_account.
# בסיס חייב = GROSS פחות הכנסה פטורה (החזר נסיעות/הבראה עד תקרה - ראו
# _l10n_il_tax_exempt_income) - הפטור לא משנה את ה-GROSS המדווח עצמו.
taxable_gross = categories['GROSS'] - payslip._l10n_il_tax_exempt_income()
credit = payslip._l10n_il_basic_pension_tax_credit(categories['BASIC'])
result = -payslip._l10n_il_income_tax_for_gross(taxable_gross, credit)
</field>
        <field name="struct_id" ref="hr_payroll_structure_il_employee_salary"/>
    </record>
