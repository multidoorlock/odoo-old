    <record id="rule_ilm_sick_adj" model="hr.salary.rule">
        <field name="name">התאמת דמי מחלה</field>
        <field name="code">IL_SICK_ADJ</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = 'IL_SICK' in worked_days and worked_days['IL_SICK'].number_of_days &gt; 0
</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# התאמת דמי מחלה לפי חוק דמי מחלה: יום 1 - 0%, ימים 2-3 - 50%, מהיום ה-4 - 100%
wd = worked_days['IL_SICK']
daily = wd.amount / wd.number_of_days
tiers = payslip._rule_parameter('l10n_il_sick_pay_tiers')
window_start = payslip.date_from + relativedelta(days=-60)
entries = version.env['hr.work.entry'].search([
    ('employee_id', '=', employee.id),
    ('work_entry_type_id.code', '=', 'IL_SICK'),
    ('state', '!=', 'cancelled'),
    ('date', '&gt;=', window_start),
    ('date', '&lt;=', payslip.date_to),
])
days = sorted(set(e.date for e in entries))
deduction = 0.0
run_start = None
prev = None
for d in days:
    if prev is None or (d - prev).days &gt; 3:
        run_start = d
    prev = d
    if d &lt; payslip.date_from or d &gt; payslip.date_to:
        continue
    idx = (d - run_start).days + 1
    if idx == 1:
        frac = tiers['day1']
    elif idx &lt;= 3:
        frac = tiers['day2_3']
    else:
        frac = tiers['day4_plus']
    deduction += daily * (1.0 - frac)
result = -deduction
</field>
        <field name="struct_id" ref="hr_payroll_structure_il_employee_salary"/>
    </record>
