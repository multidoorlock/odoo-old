    <record id="rule_ilm_salary_adj_paid_ded" model="hr.salary.rule">
        <field name="name">ניכוי התאמות שכר ששולמו (מהנטו לתשלום)</field>
        <field name="code">IL_SALARY_ADJ_PAID_DED</field>
        <field name="sequence">205</field>
        <field name="category_id" ref="rule_category_il_net_to_pay_ded"/>
        <field name="condition_select">input</field>
        <field name="condition_other_input_id" ref="input_il_salary_adj_paid_deduction"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# חלק ה"שולם" מהתאמות שכר (Salary Adjustments / hr.salary.attachment עם שולם=True) -
# נוסף כבר לנטו הרגיל דרך שורת ה-Input הרגילה של הסוג עצמו, ומנוכה כאן בחזרה - רק
# מהנטו לתשלום (לא מהנטו הרגיל) כדי שלא ישולם פעמיים על מה שכבר שולם בפועל.
result = -inputs['IL_SALARY_ADJ_PAID_DED'].amount
</field>
