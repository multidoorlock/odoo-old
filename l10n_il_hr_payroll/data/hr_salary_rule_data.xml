    <record id="rule_ilm_inctax" model="hr.salary.rule">
        <field name="name">מס הכנסה</field>
        <field name="code">IL_INCTAX</field>
        <field name="sequence">120</field>
        <field name="category_id" ref="rule_category_il_statutory_ded"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = categories['GROSS'] &gt; 0
</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# מס הכנסה: מדרגות + נקודות זיכוי + זיכוי פנסיה, או שיעור קבוע לפי תיאום מס
taxable = categories['GROSS']
if version.l10n_il_tax_coordination and version.l10n_il_tax_coordination_rate:
    tax = taxable * version.l10n_il_tax_coordination_rate / 100.0
elif not version.l10n_il_main_employer:
    # מעסיק משני ללא תיאום מס: ניכוי מס מרבי
    tax = taxable * 0.47
else:
    brackets = payslip._rule_parameter('l10n_il_tax_brackets')
    tax = 0.0
    for low, high, rate in brackets:
        if taxable &gt; low:
            top = min(taxable, high) if high else taxable
            tax += (top - low) * rate
    point_value = payslip._rule_parameter('l10n_il_credit_point_value')
    credit = version.l10n_il_credit_points * point_value
    pens_rate = version.l10n_il_pension_employee_rate
    if not pens_rate:
        pens_rate = payslip._rule_parameter('l10n_il_pension_min_rates')['employee'] * 100
    credit_rate = payslip._rule_parameter('l10n_il_pension_tax_credit_rate')
    credit += categories['BASIC'] * pens_rate / 100.0 * credit_rate
    tax = max(tax - credit, 0.0)
result = -tax
</field>
        <field name="struct_id" ref="hr_payroll_structure_il_employee_salary"/>
    </record>
    <record id="rule_ilm_nii_ee" model="hr.salary.rule">
