<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- תוספות: זמינות גם כ"התאמת שכר" (Salary Adjustment / hr.salary.attachment) -->
    <record id="input_il_commission" model="hr.payslip.input.type">
        <field name="name">עמלה</field>
        <field name="code">IL_COMMISSION</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="input_il_travel" model="hr.payslip.input.type">
        <field name="name">החזר נסיעות</field>
        <field name="code">IL_TRAVEL</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="input_il_havraa" model="hr.payslip.input.type">
        <field name="name">דמי הבראה</field>
        <field name="code">IL_HAVRAA</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="input_il_other_addition" model="hr.payslip.input.type">
        <field name="name">תוספת אחרת</field>
        <field name="code">IL_OTHER_ADD</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="input_il_loan_given" model="hr.payslip.input.type">
        <field name="name">מתן הלוואה לעובד</field>
        <field name="code">IL_LOAN_GIVEN</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <!-- ניכויים: זמינות גם כ"התאמת שכר" -->
    <record id="input_il_loan" model="hr.payslip.input.type">
        <field name="name">החזר הלוואה</field>
        <field name="code">IL_LOAN</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="input_il_meals" model="hr.payslip.input.type">
        <field name="name">ניכוי ארוחות</field>
        <field name="code">IL_MEALS</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="input_il_other_deduction" model="hr.payslip.input.type">
        <field name="name">ניכוי אחר</field>
        <field name="code">IL_OTHER_DED</field>
        <field name="country_id" ref="base.il"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

</odoo>
