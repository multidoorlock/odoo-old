<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <template
        id="webclient_company_favicon"
        name="Active Company Favicon"
        inherit_id="web.webclient_bootstrap"
    >
        <xpath
            expr="//t[@t-call='web.layout']/t[@t-set='head_web']"
            position="before"
        >
            <t
                t-set="x_icon"
                t-value="'/web/image/res.company/%s/logo' % request.env.company.id"
            />
        </xpath>
    </template>
</odoo>
