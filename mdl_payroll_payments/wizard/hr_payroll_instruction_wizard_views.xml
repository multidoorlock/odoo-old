<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_instruction_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.instruction.wizard.view.form</field>
        <field name="model">hr.payroll.instruction.wizard</field>
        <field name="arch" type="xml">
            <form string="הוראה חדשה">
                <field name="currency_id" invisible="1"/>
                <field name="available_payment_method_line_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="employee_id"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="amount"/>
                        <field name="note"/>
                    </group>
                </group>
                <group string="פרטי תשלום">
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="payment_date"/>
                        <field name="journal_id"/>
                    </group>
                    <group>
                        <field name="payment_method_line_id"
                               domain="[('id', 'in', available_payment_method_line_ids)]"/>
                        <field name="partner_bank_id" domain="[('partner_id', '=', partner_id)]"/>
                    </group>
                </group>
                <group string="פרטי התאמת שכר">
                    <group>
                        <field name="other_input_type_id"/>
                        <field name="il_effect_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                    </group>
                </group>
                <footer>
                    <button string="ביטול" special="cancel"/>
                    <button string="צור הוראה" name="action_create_instruction" type="object"
                            class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_instruction_wizard" model="ir.actions.act_window">
        <field name="name">הוראה חדשה</field>
        <field name="res_model">hr.payroll.instruction.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
