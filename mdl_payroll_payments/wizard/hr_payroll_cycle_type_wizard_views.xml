<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_cycle_type_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.type.wizard.view.form</field>
        <field name="model">hr.payroll.cycle.type.wizard</field>
        <field name="arch" type="xml">
            <form string="מחזור חדש">
                <group>
                    <field name="cycle_kind" widget="radio"/>
                </group>
                <footer>
                    <button string="ביטול" special="cancel"/>
                    <button string="הבא" name="action_next" type="object"
                            class="oe_highlight" invisible="not cycle_kind"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_cycle_type_wizard" model="ir.actions.act_window">
        <field name="name">מחזור חדש</field>
        <field name="res_model">hr.payroll.cycle.type.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
