<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         שרשרת יצירה: שלב 1 (בחירת סוג — Wizard נפרד) → שלב 2 (פרטי
         המחזור, Popup) → שלב 3 (בחירת עובדים והפקה, Popup). כל שלב הוא
         Popup אמיתי (target=new) על אותה רשומה, כמנהג Odoo (לדוגמה
         hr.employee.skill). עיצוב הקנבן/כרטיס-ה-KPI זהה לכרטיסי Pay Run
         (hr.payslip.run) — אותן מחלקות CSS (o_payrun_card וכו') כבר
         נטענות אוטומטית דרך התלות ב-hr_payroll.
         ============================================================ -->

    <record id="hr_payroll_cycle_view_form_header" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.view.form.header</field>
        <field name="model">hr.payroll.cycle</field>
        <field name="arch" type="xml">
            <form string="מחזור חדש">
                <field name="cycle_kind" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="available_payment_method_line_ids" invisible="1"/>
                <div class="oe_title">
                    <h2><field name="name" readonly="1"/></h2>
                </div>

                <!-- מחזור תשלומים: קטגוריה + פרטי תשלום, קבוצה אחת. -->
                <group invisible="cycle_kind != 'payment'">
                    <group>
                        <field name="cycle_type" widget="radio" required="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="payment_date"/>
                        <field name="journal_id"/>
                        <field name="payment_method_line_id"
                               domain="[('id', 'in', available_payment_method_line_ids)]"/>
                    </group>
                </group>

                <!-- מחזור התאמות שכר: קטגוריה + פרטי ההתאמה, קבוצה אחת. -->
                <group invisible="cycle_kind != 'salary_adjustment'">
                    <group>
                        <field name="other_input_type_id" required="1"/>
                        <field name="il_effect_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="duration_type"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>

                <!-- מחזור הוראות: פריסת 3 עמודות — ימין=תשלומים,
                     מרכז=פרטי המחזור, שמאל=התאמות שכר. סדר ה-DOM הוא
                     ימין-מרכז-שמאל כדי שב-RTL זה יוצג בסדר הנכון. -->
                <div class="row" invisible="cycle_kind != 'instruction'">
                    <div class="col-4">
                        <group string="תשלומים">
                            <field name="cycle_type" widget="radio" required="cycle_kind == 'instruction'"/>
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"
                                   domain="[('id', 'in', available_payment_method_line_ids)]"/>
                        </group>
                    </div>
                    <div class="col-4">
                        <group string="פרטי המחזור">
                            <field name="payment_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </div>
                    <div class="col-4">
                        <group string="התאמות שכר">
                            <field name="other_input_type_id" required="cycle_kind == 'instruction'"/>
                            <field name="il_effect_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="date_start"/>
                        </group>
                    </div>
                </div>

                <group>
                    <field name="note" placeholder="הערה חופשית (אופציונלי)"/>
                </group>
                <footer>
                    <button string="הבא" name="action_goto_lines_step" type="object" class="btn-primary"/>
                    <button string="ביטול" name="action_cancel_creation" type="object" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_payroll_cycle_view_form_lines" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.view.form.lines</field>
        <field name="model">hr.payroll.cycle</field>
        <field name="arch" type="xml">
            <form string="מחזור — עובדים וסכומים">
                <field name="cycle_kind" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <field name="name" readonly="1"/>
                </group>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <button name="action_apply_equal_amount" type="object"
                            string="הגדר סכום לכולם" class="btn-secondary"/>
                    <field name="equal_amount" nolabel="1"/>
                    <button name="action_reset_amounts" type="object" string="איפוס סכומים"/>
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="false">
                        <field name="include"/>
                        <field name="employee_id" widget="many2one_avatar_employee" readonly="1"/>
                        <field name="partner_id" column_invisible="1"/>
                        <field name="amount" readonly="not include" required="include"/>
                        <field name="partner_bank_id"
                               required="include and parent.cycle_kind != 'salary_adjustment'"
                               column_invisible="parent.cycle_kind == 'salary_adjustment'"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="הפק" name="action_generate" type="object" class="btn-primary"/>
                    <button string="חזור" name="action_back_to_header_step" type="object"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- מסך צפייה/עדכון למחזור קיים — כרטיס-KPI עליון זהה בעיצובו
         לכרטיס הקנבן של Pay Run, ואז טבלת השורות. -->
    <record id="hr_payroll_cycle_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.view.form</field>
        <field name="model">hr.payroll.cycle</field>
        <field name="arch" type="xml">
            <form string="מחזור">
                <header>
                    <button string="הפק" name="action_generate" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button string="חזור לטיוטה" name="action_reset_draft" type="object"
                            invisible="state != 'generated'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button" name="action_open_payments"
                                icon="fa-money" invisible="payment_count == 0">
                            <field name="payment_count" widget="statinfo" string="תשלומים"/>
                        </button>
                        <button type="object" class="oe_stat_button" name="action_open_salary_adjustments"
                                icon="fa-list" invisible="salary_adjustment_count == 0">
                            <field name="salary_adjustment_count" widget="statinfo" string="התאמות שכר"/>
                        </button>
                    </div>
                    <div class="o_payrun_card w-100 gap-4 px-0 py-1 d-grid justify-items-center align-items-center align-content-center">
                        <div class="o_cell d-flex flex-column o_payrun_info">
                            <div class="fs-2">
                                <field name="name" readonly="1" class="text-truncate w-100"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border">
                                    <field name="cycle_kind" readonly="1"/>
                                </span>
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border"
                                      invisible="cycle_kind == 'salary_adjustment'">
                                    <field name="cycle_type" readonly="1"/>
                                </span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_cost">
                            <div class="fs-2"><field name="employee_count"/></div>
                            <div class="small fw-medium">עובדים</div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_state">
                            <field name="state" widget="hr_payroll_status_bubble"/>
                        </div>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="available_payment_method_line_ids" invisible="1"/>
                    <group>
                        <group invisible="cycle_kind == 'salary_adjustment'">
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="payment_method_line_id" readonly="state != 'draft'"
                                   domain="[('id', 'in', available_payment_method_line_ids)]"/>
                        </group>
                        <group invisible="cycle_kind == 'payment'">
                            <field name="other_input_type_id" readonly="state != 'draft'"/>
                            <field name="il_effect_type" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="duration_type" readonly="state != 'draft'"
                                   invisible="cycle_kind != 'salary_adjustment'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="note" readonly="state != 'draft'"/>
                    </group>
                    <group string="שורות" invisible="state != 'draft'">
                        <div class="d-flex align-items-center gap-2">
                            <button name="action_apply_equal_amount" type="object"
                                    string="הגדר סכום לכולם" class="btn-secondary"/>
                            <field name="equal_amount" nolabel="1"/>
                            <button name="action_reset_amounts" type="object" string="איפוס סכומים"/>
                        </div>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="include"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="partner_id" column_invisible="1"/>
                            <field name="amount"/>
                            <field name="partner_bank_id"
                                   column_invisible="parent.cycle_kind == 'salary_adjustment'"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- קנבן: אותה פריסת-כרטיס בדיוק כמו Pay Run (hr.payslip.run). -->
    <record id="hr_payroll_cycle_view_kanban" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.view.kanban</field>
        <field name="model">hr.payroll.cycle</field>
        <field name="arch" type="xml">
            <kanban default_order="id desc" create="0" quick_create="0" records_draggable="0" group_create="false">
                <field name="currency_id"/>
                <templates>
                    <t t-name="menu" class="d-flex flex-column">
                        <button name="unlink" type="object" class="btn text-danger" string="מחיקה"
                                invisible="state != 'draft'"/>
                    </t>
                    <t t-name="card" class="o_payrun_card cursor-pointer gap-4 w-100 px-3 py-1 d-grid justify-items-center align-items-center align-content-center">
                        <div class="o_cell d-flex flex-column o_payrun_info">
                            <div class="fs-2"><field name="name"/></div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border">
                                    <field name="cycle_kind"/>
                                </span>
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border"
                                      invisible="cycle_kind == 'salary_adjustment'">
                                    <field name="cycle_type"/>
                                </span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_cost">
                            <div class="fs-2"><field name="employee_count"/></div>
                            <div class="small fw-medium">עובדים</div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_cost">
                            <div class="fs-2"><field name="payment_count"/></div>
                            <div class="small fw-medium">תשלומים</div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_state">
                            <field name="state" widget="hr_payroll_status_bubble"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- הרשימה: ללא "New" סטנדרטי — היצירה מתחילה תמיד משרשרת ה-Popups
         דרך כפתורי הכותרת, בדיוק כמו hr.employee.skill בליבת Odoo. -->
    <record id="hr_payroll_cycle_view_list" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.view.list</field>
        <field name="model">hr.payroll.cycle</field>
        <field name="arch" type="xml">
            <list string="מחזורים והוראות" create="0">
                <header>
                    <button name="%(action_hr_payroll_cycle_type_wizard)d" type="action"
                            string="יצירת מחזור" class="btn-primary" display="always"/>
                    <button name="%(action_hr_payroll_instruction_wizard)d" type="action"
                            string="יצירת הוראה" display="always"/>
                </header>
                <field name="name"/>
                <field name="cycle_kind"/>
                <field name="cycle_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="employee_count"/>
                <field name="payment_count"/>
                <field name="salary_adjustment_count"/>
                <field name="state" widget="badge" decoration-success="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="hr_payroll_cycle_view_search" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.view.search</field>
        <field name="model">hr.payroll.cycle</field>
        <field name="arch" type="xml">
            <search string="מחזורים">
                <field name="name"/>
                <filter string="טיוטה" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="הופק" name="generated" domain="[('state', '=', 'generated')]"/>
                <filter string="סוג מחזור" name="group_kind" domain="[]" context="{'group_by': 'cycle_kind'}"/>
                <filter string="קטגוריה" name="group_type" domain="[]" context="{'group_by': 'cycle_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_payroll_cycle" model="ir.actions.act_window">
        <field name="name">מחזורים והוראות</field>
        <field name="res_model">hr.payroll.cycle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">יצירת מחזור ראשון</p>
            <p>מחזור תשלום/הוראה יוצר תשלום לכל עובד שכלול בו; מחזור התאמות שכר יוצר
               התאמת שכר לכל עובד שנבחר. הוראה בודדת יוצרת תשלום והתאמת שכר לעובד אחד.</p>
        </field>
    </record>
</odoo>
