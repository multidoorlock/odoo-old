<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- כפתור "שלם", כפתור חכם לתשלומים, טאב תשלומים ותצוגת נטו
         ששולם/לתשלום/יתר (סעיפים 18–20 באפיון). -->
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.payslip.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <!-- hr_payroll_account מסתיר כברירת מחדל את "Mark as paid" הילידי
                 ומציג במקומו "Pay" (action_register_payment) — זרימה מבוססת
                 יומן/account.payment.register שמתעלמת לגמרי מהמנגנון שלנו
                 (partner_id=work_contact_id, קישור/יצירת account.payment,
                 סגירת תשלומי יתר). לכן: מחזירים את "Mark as paid" להיות
                 גלוי, ומסתירים את "Pay" הילידי כדי שלא ילחצו עליו בטעות. -->
            <button name="action_payslip_paid" position="attributes">
                <attribute name="invisible">state != 'validated'</attribute>
            </button>
            <button name="action_register_payment" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_payslip_payment_report" position="after">
                <button string="שלם" name="action_il_register_payment" type="object"
                        class="oe_highlight"
                        invisible="state not in ('validated', 'paid') or il_net_amount_to_pay &lt;= 0"/>
            </button>
            <div name="button_box" position="inside">
                <button type="object" class="oe_stat_button" name="action_il_open_payments"
                        icon="fa-money" invisible="il_payment_count == 0">
                    <field name="il_payment_count" widget="statinfo" string="תשלומים"/>
                </button>
            </div>
            <group name="top" position="after">
                <group string="תשלום" invisible="state not in ('validated', 'paid')">
                    <field name="currency_id" invisible="1"/>
                    <field name="il_paid_amount" widget="monetary"/>
                    <field name="il_net_amount_to_pay" widget="monetary"/>
                    <field name="il_overpayment_balance" widget="monetary"
                           invisible="not il_overpayment_balance"/>
                </group>
            </group>
            <xpath expr="//notebook" position="inside">
                <page string="תשלומים" name="il_payments">
                    <field name="il_main_payment_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="memo"/>
                            <field name="amount" sum="סה״כ"/>
                            <field name="state" widget="badge" decoration-success="state == 'paid'"
                                   decoration-info="state == 'in_process'" decoration-muted="state == 'canceled'"/>
                            <field name="payroll_cycle_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_tree" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.payslip.view.list</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="net_wage" position="after">
                <field name="il_net_amount_to_pay" widget="monetary" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
