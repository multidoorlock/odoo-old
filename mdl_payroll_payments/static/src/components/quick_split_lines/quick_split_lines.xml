<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mdl_payroll_payments.QuickSplitLinesField">
        <div t-if="showQuickCreate" class="mb-2">
            <button type="button" class="btn btn-secondary" t-on-click="openQuickCreate">
                יצירה מהירה
            </button>
        </div>
        <t t-call="web.X2ManyField"/>
    </t>

    <t t-name="mdl_payroll_payments.QuickSplitDialog">
        <Dialog title="'יצירה מהירה'" size="'md'">
            <div class="mb-4 fw-bold">
                סכום התשלום:
                <t t-esc="props.amount"/>
                <t t-if="props.currencyName"> <t t-esc="props.currencyName"/></t>
            </div>
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label">כמות שורות</label>
                    <input type="number" min="1" step="1" class="form-control"
                           t-att-value="state.quantity" t-on-input="onQuantityInput"/>
                </div>
                <div class="col-6">
                    <label class="form-label">סכום לשורה</label>
                    <input type="number" min="0" t-att-step="rounding" class="form-control"
                           t-att-value="state.lineAmount" t-on-input="onAmountInput"/>
                </div>
            </div>
            <div t-if="state.error" class="alert alert-danger mt-3 mb-0" role="alert">
                <t t-esc="state.error"/>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="props.close">ביטול</button>
                <button type="button" class="btn btn-primary" t-on-click="confirm">יצירה</button>
            </t>
        </Dialog>
    </t>
</templates>
