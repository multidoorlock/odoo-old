#. module: hr_payroll_account
#: model:ir.model.fields,help:hr_payroll_account.field_hr_salary_rule__employee_move_line
msgid "Enable this option to set the employee on the journal items of the payslips."
msgstr "יש להפעיל אפשרות זו כדי לשייך את העובד לשורות תנועות היומן של התלושים."

#. module: hr_payroll_account
#: model:ir.model.fields,help:hr_payroll_account.field_hr_salary_rule__split_move_lines
msgid "Enable this option to split the accountig entries for this rule according to the payslip line name. It could be useful for deduction/reimbursement or salary adjustments for instance."
msgstr "יש להפעיל אפשרות זו כדי לפצל את תנועות היומן של כלל זה לפי שם שורת התלוש. שימושי למשל לניכויים, החזרים או התאמות שכר."

#. module: hr_payroll_account
#: model:ir.model.fields,field_description:hr_payroll_account.field_hr_salary_rule__not_computed_in_net
