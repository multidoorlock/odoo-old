#. module: hr_payroll
#: model:ir.model.fields,help:hr_payroll.field_hr_payslip__state
msgid "* When the payslip is created the status is 'Draft'\n                \n* If the payslip is confirmed then status is set to 'Done'.\n                \n* When the user cancels a payslip, the status is 'Canceled'."
msgstr "* בעת יצירת התלוש הסטטוס הוא 'טיוטה'.\n                \n* לאחר אישור התלוש הסטטוס משתנה ל'בוצע'.\n                \n* כאשר המשתמש מבטל תלוש, הסטטוס הוא 'מבוטל'."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.contribution_register
msgid "2023 Payroll"
msgstr "שכר 2023"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>categories</code>: dict containing the computed salary rule categories (sum of amount of all rules belonging to that category)."
msgstr "<code>categories</code>: מילון המכיל את קטגוריות כללי השכר שחושבו (סכום כל הכללים השייכים לכל קטגוריה)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>employee</code>: hr.employee object"
msgstr "<code>employee</code>: אובייקט hr.employee"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>inputs</code>: dict containing the computed inputs."
msgstr "<code>inputs</code>: מילון המכיל את נתוני הקלט שחושבו."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>payslip</code>: hr.payslip object"
msgstr "<code>payslip</code>: אובייקט hr.payslip"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result</code>: boolean True if the rule should be calculated, False otherwise"
msgstr "<code>result</code>: ערך בוליאני True אם יש לחשב את הכלל, ואחרת False"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result</code>: float, base amount of the rule"
msgstr "<code>result</code>: מספר עשרוני, סכום הבסיס של הכלל"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result_name</code>: string, name of the line, which defaults to the name field of the salary rule (useful if the name depends or should depend on something computed in the rule)."
msgstr "<code>result_name</code>: מחרוזת, שם השורה; ברירת המחדל היא שדה השם של כלל השכר (שימושי כאשר השם תלוי או אמור להיות תלוי בתוצאה המחושבת בכלל)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result_qty</code>: float, quantity, which defaults to 1."
msgstr "<code>result_qty</code>: מספר עשרוני, כמות שברירת המחדל שלה היא 1."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result_rate</code>: float, rate between -100.0 and 100.0, which defaults to 100.0 (%)."
msgstr "<code>result_rate</code>: מספר עשרוני, שיעור בין ‎-100.0 ל־100.0, שברירת המחדל שלו היא 100.0 (%)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result_rules</code>: dict containing the rules amounts, quantities, rates and totals (previously computed)"
msgstr "<code>result_rules</code>: מילון המכיל את הסכומים, הכמויות, השיעורים והסכומים הכוללים של הכללים שחושבו קודם לכן"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>version</code>: hr.version object"
msgstr "<code>version</code>: אובייקט hr.version"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>worked_days</code>: dict containing the computed worked days"
msgstr "<code>worked_days</code>: מילון המכיל את ימי העבודה שחושבו"

