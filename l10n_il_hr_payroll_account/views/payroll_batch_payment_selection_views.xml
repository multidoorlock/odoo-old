<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_employee_add_existing" model="ir.ui.view">
        <field name="name">account.batch.payment.form.employee.add.existing</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="il_is_employee_batch" invisible="1"/>
                <button name="action_il_add_existing_payments" type="object"
                        string="הוסף תשלומים קיימים"
                        groups="hr_payroll.group_hr_payroll_user"
                        invisible="state != 'draft' or not il_is_employee_batch or batch_type != 'outbound'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_list_employee_batch_contents" model="ir.ui.view">
        <field name="name">account.payment.list.employee.batch.contents</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="view_account_payment_list_employee"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_il_add_existing_batch_payments" type="object"
                        string="הוסף תשלומים קיימים" display="always"
                        groups="hr_payroll.group_hr_payroll_user"
                        invisible="not context.get('il_batch_allow_add_payments')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_list_employee_batch_candidates" model="ir.ui.view">
        <field name="name">account.payment.list.employee.batch.candidates</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="view_account_payment_list_employee"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
                <attribute name="multi_edit">0</attribute>
            </list>
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_il_add_selected_to_employee_batch" type="object"
                            string="הוסף לאצווה" groups="hr_payroll.group_hr_payroll_user"/>
                </header>
            </xpath>
            <field name="amount" position="attributes">
                <attribute name="sum"/>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="column_invisible">False</attribute>
            </field>
        </field>
    </record>
</odoo>
