<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_partial_reconcile_payroll_list" model="ir.ui.view">
        <field name="name">account.partial.reconcile.payroll.list</field>
        <field name="model">account.partial.reconcile</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="max_date" string="תאריך התאמה"/>
                <field name="il_payment_id" string="תשלום עובד"/>
                <field name="il_payment_move_id" string="פקודת יומן תשלום"/>
                <field name="il_payslip_move_id" string="פקודת יומן תלוש"/>
                <field name="amount" string="סכום" sum="סה״כ"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="full_reconcile_id" string="התאמה מלאה" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_account_partial_reconcile_payroll_form" model="ir.ui.view">
        <field name="name">account.partial.reconcile.payroll.form</field>
        <field name="model">account.partial.reconcile</field>
        <field name="arch" type="xml">
            <form string="התאמה" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="max_date" string="תאריך התאמה"/>
                            <field name="amount" string="סכום"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="full_reconcile_id" string="התאמה מלאה"/>
                        </group>
                        <group>
                            <field name="il_payment_id" string="תשלום עובד"/>
                            <field name="il_payment_move_id" string="פקודת יומן תשלום"/>
                            <field name="il_payslip_move_id" string="פקודת יומן תלוש"/>
                        </group>
                    </group>
                    <group string="שורות יומן">
                        <field name="debit_move_id" string="שורת חובה"/>
                        <field name="credit_move_id" string="שורת זכות"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
