<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="il_employee_payment_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">il.employee.payment.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_il_hr_payroll.mdl_payroll_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='mdl_payroll_settings']" position="inside">
                <setting string="חשבונות תשלומי עובד"
                         id="il_employee_payment_accounts"
                         help="חשבונות החובה והזכות לפקודת היומן המלאה שנוצרת לכל תשלום עובד.">
                    <div class="content-group mt8">
                        <group>
                            <field name="il_employee_payment_debit_account_id"
                                   options="{'no_create': True}"
                                   domain="[('company_ids', 'parent_of', company_id)]"/>
                            <field name="il_employee_payment_credit_account_id"
                                   options="{'no_create': True}"
                                   domain="[('company_ids', 'parent_of', company_id)]"/>
                        </group>
                    </div>
                </setting>
            </xpath>
            <xpath expr="//block[@id='hr_payroll_settings']" position="inside">
                <setting string="הגדרות קובץ מס״ב"
                         id="il_masav_file_settings"
                         help="מספרי הזיהוי שנמסרו לחברה על ידי מס״ב והקידוד לקובץ התשלומים.">
                    <div class="content-group mt8">
                        <group>
                            <field name="il_masav_institution_number"
                                   placeholder="8 ספרות"/>
                            <field name="il_masav_sender_number"
                                   placeholder="5 ספרות"/>
                            <field name="il_masav_hebrew_code"/>
                        </group>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
