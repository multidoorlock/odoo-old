<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_il_payment_cycle_type_list" model="ir.ui.view">
        <field name="name">il.payment.cycle.type.list</field>
        <field name="model">il.payment.cycle.type</field>
        <field name="arch" type="xml">
            <list string="סוגי מחזורי תשלומים">
                <field name="name"/>
                <field name="recurrence"/>
                <field name="payment_state"/>
                <field name="batch_payment_count" string="אצוות"/>
            </list>
        </field>
    </record>

    <record id="view_il_payment_cycle_type_form" model="ir.ui.view">
        <field name="name">il.payment.cycle.type.form</field>
        <field name="model">il.payment.cycle.type</field>
        <field name="arch" type="xml">
            <form string="סוג מחזור תשלום">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_batches" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="batch_payment_count" widget="statinfo" string="תשלומי אצווה"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="recurrence"/>
                        <field name="payment_state"/>
                    </group>
                    <notebook>
                        <page string="תשלומי אצווה" invisible="not id">
                            <field name="batch_payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                    <field name="payment_method_id"/>
                                    <field name="amount" sum="סה״כ"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_il_payment_cycle_types" model="ir.actions.act_window">
        <field name="name">סוגי מחזורי תשלומים</field>
        <field name="res_model">il.payment.cycle.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_il_payment_cycle_batch_list" model="ir.ui.view">
        <field name="name">account.batch.payment.il.payment.cycle.list</field>
        <field name="model">account.batch.payment</field>
        <field name="arch" type="xml">
            <list string="תשלומי אצווה" create="0">
                <header>
                    <button name="%(action_il_payment_cycle_wizard)d" type="action"
                            string="חדש" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="il_payment_cycle_type_ids" widget="many2many_tags"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="payment_method_id"/>
                <field name="amount" sum="סה״כ"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_batch_payment_form_il_cycle" model="ir.ui.view">
        <field name="name">account.batch.payment.form.il.cycle</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_il_create_masav_file" type="object"
                        string="יצירת קובץ מס״ב" class="btn-primary"
                        invisible="not il_payment_cycle_type_ids"/>
                <button name="action_il_print_employee_payments" type="object"
                        string="דוח תשלומים לעובדים" invisible="not payment_ids"/>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_il_open_grouped_payments" type="object"
                            class="oe_stat_button" icon="fa-money">
                        <field name="il_payment_count" widget="statinfo" string="תשלומים"/>
                    </button>
                </div>
            </xpath>
            <field name="batch_type" position="after">
                <field name="il_payment_cycle_type_ids" widget="many2many_tags" readonly="payment_ids"/>
            </field>
            <!-- Keep the native many2many payments tab unchanged. Grouping,
                 search, pivot and exports belong to the full-page action. -->
        </field>
    </record>

    <record id="view_account_payment_il_batch_grouped_list" model="ir.ui.view">
        <field name="name">account.payment.il.batch.grouped.list</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="view_account_payment_list_employee"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
                <attribute name="default_group_by">il_employee_id</attribute>
                <attribute name="default_order">il_employee_id,il_payment_cycle_type_id,date,id</attribute>
                <attribute name="expand">1</attribute>
            </list>
            <field name="partner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="il_employee_id" string="עובד"/>
                <field name="il_payment_cycle_type_id" string="סוג"/>
            </field>
            <field name="amount_company_currency_signed" position="replace">
                <field name="amount" string="סכום כולל" sum="סה״כ"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_il_batch_pivot" model="ir.ui.view">
        <field name="name">account.payment.il.batch.pivot</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <pivot string="תשלומים לעובדים" display_quantity="1">
                <field name="il_employee_id" type="row"/>
                <field name="il_payment_cycle_type_id" type="col"/>
                <field name="currency_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_il_payment_cycles" model="ir.actions.act_window">
        <field name="name">תשלומי אצווה</field>
        <field name="res_model">account.batch.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_il_payment_cycle_batch_list"/>
        <field name="domain">[('il_payment_cycle_type_ids', '!=', False)]</field>
        <field name="context">{'default_batch_type': 'outbound'}</field>
    </record>
</odoo>
