<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="il_payslip_payment_split_line_list" model="ir.ui.view">
        <field name="name">mdl.payroll.payslip.payment.split.line.list</field>
        <field name="model">account.payment.split.line</field>
        <field name="arch" type="xml">
            <list string="תשלומים" create="0" edit="0" delete="0">
                <field name="payment_id" string="תשלום"/>
                <field name="sequence" string="פעימה מספר"/>
                <field name="amount" string="סכום כולל" sum="סה״כ"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.payslip.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="state_display" widget="badge" class="ms-2"
                       invisible="state_display != 'overpayment'"
                       decoration-danger="state_display == 'overpayment'"/>
            </field>
            <button name="action_payslip_paid" position="attributes">
                <attribute name="invisible">state != 'validated'</attribute>
            </button>
            <button name="action_register_payment" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_payslip_payment_report" position="after">
                <button string="שלם" name="action_il_register_payment" type="object"
                        class="oe_highlight"
                        invisible="state not in ('validated', 'paid') or il_net_amount_to_pay &lt;= 0"/>
            </button>
            <div name="button_box" position="inside">
                <button type="object" class="oe_stat_button" name="action_il_open_payments"
                        icon="fa-money" invisible="il_payment_count == 0">
                    <field name="il_payment_count" widget="statinfo" string="תשלומים"/>
                </button>
            </div>
            <field name="line_ids" position="attributes">
                <attribute name="name">il_visible_line_ids</attribute>
            </field>
            <xpath expr="//field[@name='il_visible_line_ids']/list/field[@name='currency_id']" position="after">
                <field name="il_hide_redundant_base" column_invisible="True"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="סיכום" name="il_summary">
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="gross_wage" string="ברוטו" widget="monetary" readonly="1"/>
                        <field name="net_wage" string="נטו" widget="monetary" readonly="1"/>
                        <field name="il_net_amount_to_pay" string="נטו לתשלום" widget="monetary" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_tree" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.payslip.view.list</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="net_wage" position="after">
                <field name="il_net_amount_to_pay" widget="monetary" optional="show"/>
            </field>
            <field name="state_display" position="attributes">
                <attribute name="decoration-danger">state_display in ('error', 'overpayment')</attribute>
            </field>
        </field>
    </record>
</odoo>
