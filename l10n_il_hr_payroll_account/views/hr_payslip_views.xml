<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.payslip.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <button name="action_payslip_paid" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_payslip_unpaid" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_register_payment" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_payslip_draft" position="attributes">
                <attribute name="string">החזר לטיוטה</attribute>
                <attribute name="invisible">state not in ('validated', 'paid', 'cancel')</attribute>
            </button>
            <xpath expr="(//button[@name='compute_sheet'])[1]" position="attributes">
                <attribute name="invisible">state != 'draft' or il_visible_line_ids or credit_note</attribute>
            </xpath>
            <xpath expr="(//button[@name='compute_sheet'])[2]" position="attributes">
                <attribute name="invisible">state != 'draft' or not il_visible_line_ids or credit_note</attribute>
            </xpath>
            <button name="action_payslip_payment_report" position="after">
                <button string="שלם" name="action_il_register_payment" type="object"
                        class="oe_highlight"
                        invisible="state not in ('validated', 'paid') or il_net_amount_to_pay &lt;= 0"/>
            </button>
            <div name="button_box" position="inside">
                <button type="object" class="oe_stat_button" name="action_il_open_payments"
                        icon="fa-money" invisible="il_payment_count == 0">
                    <field name="il_payment_count" widget="statinfo" string="תשלומים"/>
                </button>
                <button type="object" class="oe_stat_button"
                        name="action_il_open_reconciliations" icon="fa-link"
                        invisible="il_reconcile_count == 0">
                    <field name="il_reconcile_count" widget="statinfo"
                           string="התאמות"/>
                </button>
            </div>
            <field name="line_ids" position="attributes">
                <attribute name="name">il_visible_line_ids</attribute>
            </field>
            <xpath expr="//field[@name='il_visible_line_ids']/list" position="attributes">
                <attribute name="decoration-info">total == 0</attribute>
                <attribute name="decoration-success">total &gt; 0 and code not in ('BASIC', 'GROSS', 'NET', 'IL_NET_TO_PAY', 'IL_EMPLOYER_COST', 'IL_TAX_BASE', 'IL_NI_BASE', 'IL_PENSION_BASE', 'IL_SEVERANCE_BASE', 'IL_STUDY_FUND_BASE', 'IL_PAL_EQUALIZATION_BASE')</attribute>
                <attribute name="decoration-danger">total &lt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='il_visible_line_ids']/list/field[@name='currency_id']" position="after">
                <field name="il_hide_redundant_base" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/list/field[@name='amount']" position="after">
                <field name="daily_wage" string="שכר יומי" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="סיכום" name="il_summary">
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="employer_cost" string="עלות מעסיק כוללת" widget="monetary" readonly="1"/>
                        <field name="gross_wage" string="ברוטו" widget="monetary" readonly="1"/>
                        <field name="net_wage" string="נטו" widget="monetary" readonly="1"/>
                        <field name="il_paid_amount" string="תשלומים" widget="monetary" readonly="1"/>
                        <field name="il_net_amount_to_pay" string="נטו לתשלום" widget="monetary" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_tree" model="ir.ui.view">
        <field name="name">mdl.payroll.hr.payslip.view.list</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="net_wage" position="after">
                <field name="il_net_amount_to_pay" widget="monetary" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
