<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_payroll_common" model="ir.ui.view">
        <field name="name">mdl.payroll.account.payment.view.form.common</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="il_is_employee_payment" invisible="1"/>
                <field name="il_currency_rounding" invisible="1"/>
            </field>
            <button name="button_open_invoices" position="attributes">
                <attribute name="invisible">reconciled_invoices_count == 0 or il_is_employee_payment or context.get('il_employee_payment')</attribute>
            </button>
            <button name="button_open_bills" position="attributes">
                <attribute name="invisible">reconciled_bills_count == 0 or il_is_employee_payment or context.get('il_employee_payment')</attribute>
            </button>
            <button name="button_open_statement_lines" position="attributes">
                <attribute name="invisible">reconciled_statement_lines_count == 0 or il_is_employee_payment or context.get('il_employee_payment')</attribute>
            </button>
            <button name="action_validate" position="attributes">
                <attribute name="invisible">state != 'in_process' or (move_id and not il_is_employee_payment and not context.get('il_employee_payment'))</attribute>
            </button>

            <field name="payment_type" position="attributes">
                <attribute name="invisible">il_is_employee_payment or context.get('il_employee_payment')</attribute>
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="amount" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="date" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="memo" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="journal_id" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="payment_method_line_id" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="payment_type" position="after">
                <field name="il_payment_type_display" string="סוג תשלום" readonly="1"
                       invisible="not il_is_employee_payment and not context.get('il_employee_payment')"/>
                <field name="il_masav_file" filename="il_masav_filename" readonly="1"
                       invisible="not il_masav_file"/>
                <field name="il_masav_filename" invisible="1"/>
                <field name="il_masav_generated_on" readonly="1"
                       invisible="not il_masav_file"/>
            </field>

            <xpath expr="(//field[@name='partner_id'])[1]" position="attributes">
                <attribute name="invisible">partner_type != 'customer' or il_is_employee_payment or context.get('il_employee_payment')</attribute>
            </xpath>
            <xpath expr="(//field[@name='partner_id'])[2]" position="attributes">
                <attribute name="invisible">partner_type != 'supplier' or il_is_employee_payment or context.get('il_employee_payment')</attribute>
            </xpath>
            <xpath expr="(//field[@name='partner_id'])[2]" position="after">
                <field name="partner_id" string="עובד"
                       domain="[('employee_ids', '!=', False)]"
                       context="{}" options="{'no_quick_create': True}"
                       readonly="state != 'draft'"
                       invisible="not il_is_employee_payment and not context.get('il_employee_payment')"/>
            </xpath>

            <xpath expr="(//field[@name='partner_bank_id'])[2]" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or partner_type != 'supplier' or payment_type == 'inbound' or il_is_employee_payment or context.get('il_employee_payment')</attribute>
            </xpath>
            <xpath expr="(//field[@name='partner_bank_id'])[2]" position="after">
                <field name="partner_bank_id" string="חשבון בנק (עובד)"
                       context="{'default_partner_id': partner_id, 'display_account_trust': True}"
                       invisible="not il_is_employee_payment and not context.get('il_employee_payment')"
                       readonly="state != 'draft'"
                       required="False"/>
            </xpath>
            <notebook position="inside">
                <page string="מעקב שכר" name="il_payroll"
                      invisible="not il_is_employee_payment and not context.get('il_employee_payment')">
                    <group>
                        <field name="il_spread_type"
                               readonly="state != 'draft'"/>
                        <field name="il_planned_amount" widget="monetary" readonly="1"/>
                        <field name="il_applied_amount" widget="monetary" readonly="1"/>
                        <field name="il_remaining_amount" string="יתרה לסגירה" widget="monetary" readonly="1"/>
                    </group>
                    <field name="il_split_line_ids" widget="il_quick_split_lines"
                           readonly="state != 'draft'"
                           invisible="il_spread_type != 'planned'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="sequence" string="פעימה מס'" readonly="1"/>
                            <field name="amount" sum="סה״כ"/>
                            <field name="il_linked_payslip_id" string="תלוש מקושר" readonly="1"/>
                            <field name="is_applied" string="סגור בתלוש" readonly="1"/>
                            <field name="employee_id" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <field name="il_split_line_ids" readonly="state != 'draft'"
                           invisible="il_spread_type == 'planned'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" readonly="1"/>
                            <field name="amount" sum="סה״כ"/>
                            <field name="il_linked_payslip_id" string="תלוש מקושר" readonly="1"/>
                            <field name="is_applied" string="סגור בתלוש" readonly="1"/>
                            <field name="employee_id" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- ============================================================
         מסך ייעודי לתשלומי עובדים — mode="primary" יוצר View עצמאי
         לגמרי מה-View הסטנדרטי; אינו משפיע על מסכי התשלומים הרגילים
         של הנהלת החשבונות (לקוחות/ספקים). כל מה שקשור לעובד/שכר
         (התוויות, האילוץ לשליחה בלבד, הקישור לתלוש) חי רק כאן.
         עיצוב תואם למסך המקביל שנבנה בעבר במודול l10n_il_hr_payroll_account.
         ============================================================ -->
    <record id="view_account_payment_form_employee" model="ir.ui.view">
        <field name="name">mdl.payroll.account.payment.view.form.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="view_account_payment_form_payroll_common"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="string">תשלום לעובד</attribute>
                <attribute name="edit">1</attribute>
            </form>
            <!-- All employee-specific fields, buttons and payroll tracking are
                 inherited from the common form so every entry path resolves
                 to exactly the same architecture. -->
        </field>
    </record>

    <!-- יצירה בודדת = Popup, לא ניווט מלא-עמוד (חייב להיות מוגדר לפני
         הרשימה למטה, שמפנה אליו דרך %(...)d). -->
    <!-- זהה למבנה הליבה של Odoo עבור "Vendor Payments"
         (account.view_account_supplier_payment_tree) — רק שינוי תווית +
         כפתור "תשלום חדש" (פותח כ-Popup) במקום "New" הרגיל. -->
    <record id="view_account_payment_list_employee" model="ir.ui.view">
        <field name="name">mdl.payroll.account.payment.view.list.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">1</attribute>
            </list>
            <field name="partner_id" position="attributes">
                <attribute name="string">עובד / שותף</attribute>
            </field>
            <field name="journal_id" position="replace"/>
            <field name="payment_method_line_id" position="replace"/>
            <field name="name" position="after">
                <field name="memo" string="פתק" optional="show"/>
            </field>
            <xpath expr="//field[@name='company_id']" position="replace"/>
            <xpath expr="//field[@name='amount_signed' and @groups='!base.group_multi_currency']"
                   position="replace"/>
            <xpath expr="//field[@name='amount_signed' and @groups='base.group_multi_currency']"
                   position="replace"/>
            <field name="amount_company_currency_signed" position="replace">
                <field name="amount" widget="monetary" string="סכום התשלום" sum="סה״כ תשלומים"/>
            </field>
            <xpath expr="//field[@name='currency_id']" position="replace">
                <!-- Keep the technical currency value loaded for the monetary
                     widget without displaying the Payment Currency column. -->
                <field name="currency_id" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="replace"/>
            <field name="partner_id" position="after">
                <field name="il_relevant_installment_number"
                       column_invisible="not context.get('il_payslip_id')"/>
                <field name="il_relevant_installment_amount"
                       column_invisible="not context.get('il_payslip_id')"/>
            </field>
        </field>
    </record>

    <!-- Native selectable payment list. Link changes are reviewed together
         from Actions; financial payment fields remain read-only here. -->
    <record id="view_account_payment_list_payslip_links" model="ir.ui.view">
        <field name="name">mdl.payroll.account.payment.view.list.payslip.links</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="view_account_payment_list_employee"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="edit">0</attribute>
                <attribute name="editable"/>
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
                <attribute name="multi_edit">0</attribute>
            </list>
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_il_add_payslip_payment" type="object"
                            string="הוסף תשלום" display="always"/>
                </header>
            </xpath>
            <!-- Inherited-view locators update only their first match. Keep
                 each document column explicitly read-only in this editor. -->
            <field name="company_currency_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="available_payment_method_line_ids" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="date" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="memo" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="batch_payment_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="amount" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="state" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="il_relevant_installment_number" position="replace"/>
            <field name="il_relevant_installment_amount" position="replace"/>
            <field name="amount" position="after">
                <field name="il_payslip_linked_amount" string="סכום להכרה"
                       widget="monetary" readonly="1" sum="סה״כ להכרה"/>
                <field name="il_recognition_available_amount" string="יתרה להכרה"
                       widget="monetary" readonly="1" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_list_payslip_candidates" model="ir.ui.view">
        <field name="name">mdl.payroll.account.payment.view.list.payslip.candidates</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="view_account_payment_list_payslip_links"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_il_select_payslip_payments" type="object"
                            string="קישור לתלוש"/>
                </header>
            </xpath>
            <field name="il_payslip_linked_amount" position="replace"/>
            <field name="il_recognition_available_amount" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="sum">סה״כ יתרה להכרה</attribute>
            </field>
        </field>
    </record>

    <record id="action_payslip_change_recognized_amount" model="ir.actions.server">
        <field name="name">שינוי סכום להכרה</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_il_change_recognized_amount()</field>
    </record>

    <record id="action_payslip_remove_payment_links" model="ir.actions.server">
        <field name="name">הסרת קישור מהתלוש</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_il_remove_payslip_links()</field>
    </record>

    <!-- מוסיפה פילטר "תשלומי עובדים" (ניתן להסרה) גם למסכי הנהלת
         החשבונות הרגילים — ירושה רגילה (לא primary) על תצוגת החיפוש
         המשותפת, לצד הפילטרים הקיימים "תשלומי לקוח"/"תשלומי ספק". -->
    <record id="view_account_payment_search_employee_filter" model="ir.ui.view">
        <field name="name">mdl.payroll.account.payment.view.search.employee.filter</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="outbound_filter" position="after">
                <filter name="il_filter_employee" string="תשלומי עובדים"
                        domain="[('partner_id.employee_ids', '!=', False)]"/>
            </filter>
        </field>
    </record>

    <record id="view_account_payment_search_employee" model="ir.ui.view">
        <field name="name">mdl.payroll.account.payment.view.search.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">עובד / שותף</attribute>
            </field>
        </field>
    </record>

    <!-- Restore Accounting actions to their native unrestricted domains. -->
    <function model="ir.actions.act_window" name="write"
        eval="[[ref('account.action_account_payments')], {'domain': []}]"/>
    <function model="ir.actions.act_window" name="write"
        eval="[[ref('account.action_account_payments_payable')], {'domain': []}]"/>

    <!-- רשימת תשלומי עובדים (סעיף 5 באפיון) — מסך ייעודי, לא מסך הספקים. -->
    <record id="il_action_employee_payments" model="ir.actions.act_window">
        <field name="name">תשלומי עובדים</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form,graph,activity</field>
        <field name="domain">[]</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier', 'search_default_il_filter_employee': 1, 'il_employee_payment': True}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_account_payment_list_employee')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_payment_form_employee')}),
        ]"/>
        <field name="search_view_id" ref="view_account_payment_search_employee"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">רישום תשלום עובד ראשון</p>
            <p>תשלומים לעובדים וקישורם לתלושים, כולל יתרות לפריסה עתידית.</p>
        </field>
    </record>
</odoo>
