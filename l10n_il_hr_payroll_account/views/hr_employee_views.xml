<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- פרטים אישיים לצורכי שכר, הפרשות סוציאליות, ומחזורי תשלומים
         (מפרעה/אוכל/הלוואה) בכרטיס העובד — סעיפים 1–3 ו-57–60 באפיון. -->
    <record id="mdl_payroll_payments_hr_employee_view_form" model="ir.ui.view">
        <field name="name">mdl.payroll.payments.hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="structure_type_id" position="after">
                <field name="il_salary_structure_id"
                       domain="[('type_id', '=', structure_type_id)]"
                       invisible="not il_is_israel_payroll"
                       required="il_is_israel_payroll"/>
                <field name="il_is_israel_payroll" invisible="1"/>
            </field>
            <field name="schedule_pay" position="attributes">
                <attribute name="readonly">il_is_israel_payroll</attribute>
                <attribute name="force_save">1</attribute>
            </field>
            <group name="payroll_group" position="after">
                <group invisible="not il_is_israel_payroll">
                    <group string="פרטים אישיים לשכר" name="il_personal">
                        <field name="il_tax_credit_points"/>
                        <field name="il_primary_employer"/>
                        <field name="il_tax_coordination"/>
                        <field name="il_tax_coordination_valid_from"
                               invisible="not il_tax_coordination"/>
                        <field name="il_tax_coordination_valid_until"
                               invisible="not il_tax_coordination"/>
                        <field name="il_employment_sector"/>
                        <field name="il_pal_organization_tax"/>
                    </group>
                    <group string="הפרשות סוציאליות" name="il_social">
                        <field name="il_pension_enabled"/>
                        <field name="il_pension_start_date" invisible="not il_pension_enabled"/>
                        <field name="il_employee_pension_rate" invisible="not il_pension_enabled"/>
                        <field name="il_employer_pension_rate" invisible="not il_pension_enabled"/>
                        <field name="il_severance_rate" invisible="not il_pension_enabled"/>
                        <field name="il_study_fund_enabled"/>
                        <field name="il_employee_study_fund_rate" invisible="not il_study_fund_enabled"/>
                        <field name="il_employer_study_fund_rate" invisible="not il_study_fund_enabled"/>
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
