<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.l10n.il.hr.payroll.account</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="l10n_il_hr_payroll.hr_employee_view_form"/>
        <field name="arch" type="xml">
            <!-- טאב נפרד, לא בתוך "שינויי שכר" - טבלה **קבועה** (3 שורות
                 בדיוק, אוכל/מפרעה/הלוואה - נזרעות אוטומטית, ראו hr_employee.py) -
                 לא ניתן להוסיף/למחוק שורות (create="false" delete="false"),
                 רק לסמן "נכלל" ואז להזין סכום. זה מה שמחזור התשלומים
                 (l10n.il.payment.batch.wizard) מסנן/מושך לפיו כשנבחרים סוג/י
                 מחזור מסוימים. -->
            <page name="salary_attachment" position="after">
                <page name="l10n_il_payment_cycle_lines" string="סכומי מחזורי תשלום" groups="hr_payroll.group_hr_payroll_user">
                    <field name="l10n_il_payment_cycle_line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="cycle_type" readonly="1"/>
                            <field name="included"/>
                            <field name="amount" readonly="not included"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
