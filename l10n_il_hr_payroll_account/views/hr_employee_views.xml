<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- פרטים אישיים לצורכי שכר, הפרשות סוציאליות, ומחזורי תשלומים
         (מפרעה/אוכל/הלוואה) בכרטיס העובד — סעיפים 1–3 ו-57–60 באפיון. -->
    <record id="mdl_payroll_payments_hr_employee_view_form" model="ir.ui.view">
        <field name="name">mdl.payroll.payments.hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_il_open_work_contact" type="object"
                        class="oe_stat_button" icon="fa-address-card-o"
                        invisible="not work_contact_id" groups="hr.group_hr_user">
                    <div class="o_stat_info"><span class="o_stat_text">איש קשר</span></div>
                </button>
                <button name="action_il_open_payments" type="object"
                        class="oe_stat_button" icon="fa-money"
                        groups="hr_payroll.group_hr_payroll_user">
                    <field name="il_payment_count" widget="statinfo" string="תשלומים"/>
                </button>
                <button name="action_il_open_payroll_ledger" type="object"
                        class="oe_stat_button" icon="fa-book"
                        groups="account.group_account_readonly">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="il_payroll_balance" widget="monetary"
                                   options="{'currency_field': 'il_payroll_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">יתרה לפירעון</span>
                    </div>
                    <field name="il_payroll_currency_id" invisible="1"/>
                </button>
            </xpath>
            <field name="structure_type_id" position="after">
                <field name="il_salary_structure_id"
                       domain="[('type_id', '=', structure_type_id)]"
                       invisible="not il_is_israel_payroll"
                       required="il_is_israel_payroll"/>
                <field name="il_is_israel_payroll" invisible="1"/>
            </field>
            <field name="schedule_pay" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </field>
            <group name="payroll_group" position="after">
                <group invisible="not il_is_israel_payroll">
                    <group string="פרטים אישיים לשכר" name="il_personal">
                        <field name="il_tax_credit_points"/>
                        <field name="il_monthly_tax_credit_adjustment"/>
                        <field name="il_primary_employer"/>
                        <field name="il_tax_coordination"/>
                        <field name="il_tax_coordination_valid_from"
                               invisible="not il_tax_coordination"/>
                        <field name="il_tax_coordination_valid_until"
                               invisible="not il_tax_coordination"/>
                        <field name="il_employment_sector"/>
                        <field name="il_pal_organization_tax"/>
                        <field name="il_ni_full_rate_from_first_shekel"/>
                        <field name="il_national_insurance_exempt"/>
                        <field name="il_health_insurance_exempt"/>
                    </group>
                    <group string="הפרשות סוציאליות" name="il_social">
                        <field name="il_pension_enabled"/>
                        <field name="il_pension_start_date" invisible="not il_pension_enabled"/>
                        <field name="il_employee_pension_rate" invisible="not il_pension_enabled"/>
                        <field name="il_employer_pension_rate" invisible="not il_pension_enabled"/>
                        <field name="il_severance_rate" invisible="not il_pension_enabled"/>
                        <field name="il_pension_insured_wage" invisible="not il_pension_enabled"/>
                        <field name="il_study_fund_enabled"/>
                        <field name="il_employee_study_fund_rate" invisible="not il_study_fund_enabled"/>
                        <field name="il_employer_study_fund_rate" invisible="not il_study_fund_enabled"/>
                    </group>
                </group>
            </group>
            <notebook position="inside">
                <page string="סוגי מחזורי תשלומי אצווה" name="il_payment_cycle_types">
                    <field name="il_payment_cycle_type_line_ids" context="{'default_employee_id': id}">
                        <list editable="bottom">
                            <field name="cycle_type_id"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Native journal items, with the existing residual column visible. -->
    <record id="view_employee_payroll_ledger_list" model="ir.ui.view">
        <field name="name">account.move.line.employee.payroll.ledger.list</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="amount_residual" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">יתרה לסגירה</attribute>
            </field>
        </field>
    </record>
</odoo>
