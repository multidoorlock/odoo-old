<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==== תשלומי עובדים: אותה טבלה/מודל account.payment ואותו שדה שותף
         (partner_id) בדיוק - אין שדה "עובד" נפרד, בדיוק כמו שתשלומי ספק
         נוספו על גבי תשלומי לקוח בליבת account: view_account_supplier_payment_tree
         רק משנה את ה-string של partner_id ל-"Vendor", לא מוסיפה שדה חדש. כאן
         אותו הדבר בדיוק - partner_id מקבל string="עובד" + domain שמסנן
         לאנשי-קשר של עובדים (res.partner.employee_ids, שדה הפוך קיים כבר על
         hr.employee.work_contact_id - לא צריך שום שדה חדש). ללא domain קשיח
         על ה-action עצמו, אפשר להסיר את הפילטר ולראות גם לקוחות/ספקים. אבל
         התצוגות עצמן הן mode="primary" (יורשות מבנה, לא נבנות מאפס) ומשמשות
         אך ורק את הפעולה הזו תחת שכר - בדיוק כמו view_account_supplier_payment_tree
         עצמה, כדי שמסכי התשלומים המקוריים בהנהלת חשבונות (לקוחות/ספקים/הכל)
         יישארו בדיוק כפי שהיו. priority גבוה מוודא שהתצוגות האלו לעולם לא
         "יזכו" ברזולוציה כברירת מחדל כשלא מציינים view_id במפורש. ==== -->
    <record id="l10n_il_account_payment_view_form" model="ir.ui.view">
        <field name="name">account.payment.view.form.l10n.il.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- partner_id[2] הוא זה שמוצג ל-partner_type='supplier' (המצב
                 היחיד הרלוונטי לתשלומי עובד) - רק שינוי string+domain, לא
                 שדה נוסף. לא ניתן להשתמש ב-string כסלקטור בירושת תצוגות,
                 לכן ממוקם לפי סדר המופעים בתצוגה המקורית. -->
            <xpath expr="(//field[@name='partner_id'])[2]" position="attributes">
                <attribute name="string">עובד</attribute>
                <attribute name="domain">[('employee_ids', '!=', False)]</attribute>
                <attribute name="readonly">state != 'draft' or context.get('l10n_il_lock_payslip_fields')</attribute>
            </xpath>
            <!-- תשלום עובד הוא תמיד "נשלח" (outbound) - הבחירה מיותרת כאן -->
            <field name="payment_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <!-- הכפתור הראשי למעלה (Confirm/action_post) מוסתר - מוחלף בכפתורי
                 footer מפורשים למטה ("שמור כטיוטה"/"שמור", ראו שם) שמכסים בדיוק
                 את אותה פעולה (action_post עצמו, לא מתודה חדשה) בלי שהמשתמש
                 צריך שני קליקים נפרדים (שמור + אישור) ביצירה. -->
            <button name="action_post" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <xpath expr="//form" position="inside">
                <footer>
                    <button name="action_post" type="object" string="שמור" class="btn-primary"
                        invisible="state != 'draft' or context.get('l10n_il_lock_payslip_fields')"/>
                    <button name="action_l10n_il_confirm_payslip_payment" type="object" string="שלם" class="btn-primary"
                        invisible="state != 'draft' or not context.get('l10n_il_lock_payslip_fields')"/>
                    <button string="שמור כטיוטה" special="save"/>
                </footer>
            </xpath>
            <!-- חשבון בנק של החברה לא רלוונטי לתשלום עובד -->
            <xpath expr="(//field[@name='partner_bank_id'])[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- partner_bank_id[2] הוא "Vendor Bank Account" הילידי - הרלוונטי
                 היחיד כאן (partner_type תמיד 'supplier') - רק relabel לעובד -->
            <xpath expr="(//field[@name='partner_bank_id'])[2]" position="attributes">
                <attribute name="string">חשבון בנק (עובד)</attribute>
            </xpath>
            <notebook name="payment_notebook" position="inside">
                <page string="מעקב שכר" name="l10n_il_payroll_tracking">
                    <!-- l10n_il_payslip_net_to_pay הוא "הנטו-לתשלום הנותר, כרגע"
                         של התלוש - ברגע שהתשלום הזה עצמו כבר אושר, הוא כבר
                         נכלל בחישוב הזה (הנטו-לתשלום ירד/התאפס בזכותו), אז
                         ההשוואה כבר לא רלוונטית רטרואקטיבית על תשלום ישן/רגיל
                         (יראה "תשלום ביתר" גם כשהיה תקין ב-100% ברגע שנוצר).
                         לכן האזהרה מוצגת אך ורק בזמן טיוטה (לפני האישור עצמו) -
                         בדיוק כשהיא עדיין שימושית/אקשיונבילית. -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'draft' or amount &lt;= l10n_il_payslip_net_to_pay">
                        שים לב: הסכום שהוזן גבוה מהנטו לתשלום הזמין בתלוש המקושר (תשלום ביתר).
                    </div>
                    <group>
                        <field name="payslip_id"
                            readonly="context.get('l10n_il_lock_payslip_fields') or l10n_il_closure_allocation_ids"/>
                        <field name="l10n_il_payslip_net_to_pay" invisible="1"/>
                        <field name="l10n_il_batch_id" invisible="context.get('l10n_il_lock_payslip_fields')"/>
                    </group>
                </page>
                <!-- מוצג רק אם התשלום הזה בפועל פוצל (שימש, ולו חלקית, לסגירת
                     תלוש אחר) - ראו l10n_il_overpayment_closure.py -->
                <page string="פיצול בין תלושים" name="l10n_il_closure_allocation"
                      invisible="not l10n_il_closure_allocation_ids">
                    <field name="l10n_il_closure_allocation_ids" readonly="1">
                        <list>
                            <field name="payslip_id"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- הוספת פילטר "תשלומי עובדים" גם למסכי הנהלת חשבונות המקוריים (לקוחות/
         ספקים/הכל) - ירושה רגילה (לא primary) על אותה תצוגת חיפוש משותפת,
         בדיוק לצד הפילטרים הקיימים "תשלומי לקוח"/"תשלומי ספק" - רק פילטר
         חיפוש נוסף, לא שדה/עמודה, לכן לא "מזהם" את המסכים המקוריים. -->
    <record id="account_payment_view_search_l10n_il_employee_filter" model="ir.ui.view">
        <field name="name">account.payment.view.search.inherit.l10n.il.employee.filter</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="outbound_filter" position="after">
                <filter name="l10n_il_filter_employee" string="תשלומי עובדים" domain="[('partner_id.employee_ids', '!=', False)]"/>
            </filter>
        </field>
    </record>

    <!-- הפרדה אמיתית (domain, לא רק פילטר-חיפוש ניתן-להסרה) בין תשלומי עובד
         למסכי לקוחות/ספקים המקוריים - שתי הפעולות המקוריות (account) אין להן
         domain כלל, רק search_default_*_filter הניתן להסרה, ולכן תשלומי עובד
         (partner_type='supplier' כמו ספק רגיל) "דלפו" גם לתשלומי ספק כברירת
         מחדל. הרשומות המקוריות noupdate="1" - <function name="write"> ולא
         <record>, כמו שכבר נדרש עבור hr_work_entry.work_entry_type_overtime.
         הסינון עצמו לפי partner_id.employee_ids (לא שדה "סוג תשלום" יותר -
         הוסר לגמרי, כל תשלום הוא פשוט תשלום). -->
    <function model="ir.actions.act_window" name="write"
        eval="[[ref('account.action_account_payments')], {'domain': [('partner_id.employee_ids', '=', False)]}]"/>
    <function model="ir.actions.act_window" name="write"
        eval="[[ref('account.action_account_payments_payable')], {'domain': [('partner_id.employee_ids', '=', False)]}]"/>

    <!-- יצירה בודדת = פופאפ (כמו סוגי מחזורי תשלומים) במקום ניווט מלא-עמוד -
         create="false" כאן + כפתור header שפותח את action_l10n_il_account_payment_popup. -->
    <record id="action_l10n_il_account_payment_popup" model="ir.actions.act_window">
        <field name="name">תשלום חדש</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_il_account_payment_view_form"/>
        <field name="target">new</field>
        <field name="context">{'default_partner_type': 'supplier', 'default_payment_type': 'outbound'}</field>
    </record>

    <record id="l10n_il_account_payment_view_list" model="ir.ui.view">
        <field name="name">account.payment.view.list.l10n.il.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">false</attribute>
            </list>
            <xpath expr="//header" position="inside">
                <button name="%(action_l10n_il_account_payment_popup)d" type="action"
                        string="תשלום חדש" class="btn-primary" display="always"/>
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="string">עובד</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="l10n_il_batch_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="l10n_il_account_payment_view_search" model="ir.ui.view">
        <field name="name">account.payment.view.search.l10n.il.employee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">עובד</attribute>
            </field>
            <filter name="state_in_process" position="after">
                <filter name="state_paid" string="שולם" domain="[('state', '=', 'paid')]"/>
            </filter>
            <filter name="reconciled" position="after">
                <filter name="filter_off_cycle" string="תשלומי עובד בודדים (Off-Cycle)" domain="[('partner_id.employee_ids', '!=', False), ('l10n_il_batch_id', '=', False)]"/>
            </filter>
            <filter name="paymentmethodline" position="after">
                <filter name="group_by_batch" string="מחזור" context="{'group_by': 'l10n_il_batch_id'}"/>
            </filter>
        </field>
    </record>

    <record id="action_l10n_il_account_payment" model="ir.actions.act_window">
        <field name="name">תשלומים</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'default_partner_type': 'supplier', 'default_payment_type': 'outbound', 'search_default_l10n_il_filter_employee': 1}</field>
        <field name="search_view_id" ref="l10n_il_account_payment_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">רישום תשלום עובד ראשון</p>
            <p>אותה טבלת תשלומים בדיוק כמו בהנהלת חשבונות - הפילטר "תשלומי עובדים" מוצג כברירת מחדל, ניתן להסיר אותו כדי לראות גם תשלומי לקוחות/ספקים. תשלום במצב "בביצוע" שעוד לא מקושר לתלוש נאסף אוטומטית לתלוש השכר הבא של העובד. ליצירה קבוצתית או ליצירת תשלום+התאמת שכר עצמאיים יחד השתמשו במסך "מחזורים והוראות".</p>
        </field>
    </record>
    <record id="action_l10n_il_account_payment_list_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="l10n_il_account_payment_view_list"/>
        <field name="act_window_id" ref="action_l10n_il_account_payment"/>
    </record>
    <record id="action_l10n_il_account_payment_form_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_il_account_payment_view_form"/>
        <field name="act_window_id" ref="action_l10n_il_account_payment"/>
    </record>

    <!-- ==== אשף יצירת מחזור: שלב 0 - בחירת "סוג" המחזור (radio) ==== -->
    <record id="l10n_il_payment_batch_wizard_view_form_step0" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.wizard.view.form.step0</field>
        <field name="model">l10n.il.payment.batch.wizard</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="מחזור חדש">
                <group>
                    <field name="l10n_il_batch_kind" widget="radio" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_choose_kind" type="object" string="המשך" class="btn-primary"/>
                    <button string="ביטול" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_il_payment_batch_wizard_new" model="ir.actions.act_window">
        <field name="name">מחזור חדש</field>
        <field name="res_model">l10n.il.payment.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_il_payment_batch_wizard_view_form_step0"/>
        <field name="target">new</field>
    </record>

    <!-- ==== אשף יצירת מחזור: שלב 1 - פרטים משותפים, תלוי-סוג (l10n_il_batch_kind).
         'תשלום': כמו תמיד. 'התאמת שכר': סוג/סוג השפעה/משך זמן/הערה - קבוצה
         פשוטה אחת (לא 3 עמודות). 'הוראה': פריסת 3 עמודות - מרכז (שם/תאריך/הערה),
         ימין="תשלומים" (סוג מחזור/יומן/אמצעי תשלום), שמאל="התאמות שכר"
         (סוג/סוג השפעה) - ה-DOM-order הוא ימין-מרכז-שמאל כדי שב-RTL זה יוצג
         בסדר הנכון (ראשון ב-DOM = הכי ימני ב-RTL). ==== -->
    <record id="l10n_il_payment_batch_wizard_view_form_step1" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.wizard.view.form.step1</field>
        <field name="model">l10n.il.payment.batch.wizard</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="מחזור חדש">
                <group invisible="l10n_il_batch_kind != 'payment'">
                    <group>
                        <field name="name"/>
                        <label for="l10n_il_include_food" string="סוגי מחזור"/>
                        <div class="d-flex flex-column gap-1">
                            <div class="form-check">
                                <field name="l10n_il_include_food" class="form-check-input"/>
                                <label for="l10n_il_include_food" string="אוכל" class="form-check-label"/>
                            </div>
                            <div class="form-check">
                                <field name="l10n_il_include_advance" class="form-check-input"/>
                                <label for="l10n_il_include_advance" string="מפרעה" class="form-check-label"/>
                            </div>
                            <div class="form-check">
                                <field name="l10n_il_include_loan" class="form-check-input"/>
                                <label for="l10n_il_include_loan" string="הלוואה" class="form-check-label"/>
                            </div>
                        </div>
                        <field name="date"/>
                        <field name="memo"/>
                    </group>
                    <group>
                        <field name="journal_id"/>
                        <field name="payment_method_line_id"/>
                    </group>
                </group>
                <group invisible="l10n_il_batch_kind != 'salary_adjustment'">
                    <field name="name"/>
                    <field name="other_input_type_id"/>
                    <field name="l10n_il_impact_type"/>
                    <field name="duration_type"/>
                    <field name="date"/>
                    <field name="memo" string="הערה"/>
                </group>
                <div class="row" invisible="l10n_il_batch_kind != 'instruction'">
                    <div class="col-4">
                        <group string="תשלומים">
                            <label for="l10n_il_include_food" string="סוגי מחזור"/>
                            <div class="d-flex flex-column gap-1">
                                <div class="form-check">
                                    <field name="l10n_il_include_food" class="form-check-input"/>
                                    <label for="l10n_il_include_food" string="אוכל" class="form-check-label"/>
                                </div>
                                <div class="form-check">
                                    <field name="l10n_il_include_advance" class="form-check-input"/>
                                    <label for="l10n_il_include_advance" string="מפרעה" class="form-check-label"/>
                                </div>
                                <div class="form-check">
                                    <field name="l10n_il_include_loan" class="form-check-input"/>
                                    <label for="l10n_il_include_loan" string="הלוואה" class="form-check-label"/>
                                </div>
                            </div>
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"/>
                        </group>
                    </div>
                    <div class="col-4">
                        <group string="פרטי המחזור">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="memo" string="הערה"/>
                        </group>
                    </div>
                    <div class="col-4">
                        <group string="התאמות שכר">
                            <!-- הוראה תמיד חיובית (מלווה תשלום יוצא) - לא ניתן
                                 לבחור כאן סוג שסימנו נקבע כשלילי. -->
                            <field name="l10n_il_positive_only_type_ids" invisible="1"/>
                            <field name="other_input_type_id"
                                domain="[('id', 'in', l10n_il_positive_only_type_ids)]"/>
                            <field name="l10n_il_impact_type"/>
                        </group>
                    </div>
                </div>
                <footer>
                    <button name="action_next" type="object" string="הבא" class="btn-primary"/>
                    <button name="action_back_to_kind" type="object" string="חזור"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==== אשף יצירת מחזור: שלב 2 - עובדים וסכומים ==== -->
    <record id="l10n_il_payment_batch_wizard_view_form_step2" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.wizard.view.form.step2</field>
        <field name="model">l10n.il.payment.batch.wizard</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="מחזור - עובדים וסכומים">
                <group>
                    <field name="name" readonly="1"/>
                    <field name="date" readonly="1"/>
                </group>
                <div class="d-flex align-items-center gap-2 mb-2" invisible="l10n_il_batch_kind != 'salary_adjustment'">
                    <button name="action_set_all_amount" type="object" string="הגדר סכום לכולם" class="btn-secondary"/>
                    <field name="set_all_amount" nolabel="1"/>
                </div>
                <div class="d-flex align-items-center gap-2 mb-2" invisible="l10n_il_batch_kind == 'salary_adjustment'">
                    <div class="d-flex align-items-center gap-2" invisible="not l10n_il_include_food">
                        <button name="action_set_all_food" type="object" string="הגדר אוכל לכולם" class="btn-secondary"/>
                        <field name="set_all_food_amount" nolabel="1"/>
                    </div>
                    <div class="d-flex align-items-center gap-2" invisible="not l10n_il_include_advance">
                        <button name="action_set_all_advance" type="object" string="הגדר מפרעה לכולם" class="btn-secondary"/>
                        <field name="set_all_advance_amount" nolabel="1"/>
                    </div>
                    <div class="d-flex align-items-center gap-2" invisible="not l10n_il_include_loan">
                        <button name="action_set_all_loan" type="object" string="הגדר הלוואה לכולם" class="btn-secondary"/>
                        <field name="set_all_loan_amount" nolabel="1"/>
                    </div>
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="false">
                        <field name="included"/>
                        <field name="employee_id" widget="many2one_avatar_employee" readonly="1"/>
                        <field name="employee_bank_account_ids" column_invisible="1"/>
                        <field name="partner_bank_id" required="included and parent.l10n_il_batch_kind != 'salary_adjustment'"
                            column_invisible="parent.l10n_il_batch_kind == 'salary_adjustment'"/>
                        <field name="amount" readonly="not included" required="included"
                            column_invisible="parent.l10n_il_batch_kind == 'instruction' or parent.l10n_il_batch_kind == 'payment'"/>
                        <field name="has_food" column_invisible="1"/>
                        <field name="food_amount" string="אוכל" readonly="not has_food or not included"
                            column_invisible="not parent.l10n_il_include_food or parent.l10n_il_batch_kind == 'salary_adjustment'"/>
                        <field name="has_advance" column_invisible="1"/>
                        <field name="advance_amount" string="מפרעה" readonly="not has_advance or not included"
                            column_invisible="not parent.l10n_il_include_advance or parent.l10n_il_batch_kind == 'salary_adjustment'"/>
                        <field name="has_loan" column_invisible="1"/>
                        <field name="loan_amount" string="הלוואה" readonly="not has_loan or not included"
                            column_invisible="not parent.l10n_il_include_loan or parent.l10n_il_batch_kind == 'salary_adjustment'"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_batch" type="object" string="יצירת המחזור" class="btn-primary"/>
                    <button name="action_back" type="object" string="חזור"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==== תצוגת קנבן למחזורים - עיצוב חזותי זהה ל-Pay Runs (hr.payslip.run,
         ראו hr_payroll/views/hr_payslip_run_views.xml): אותה פריסת-רשת
         (o_payrun_card/o_cell/o_payrun_info/o_payrun_cost/o_payrun_state,
         מוגדרות ב-CSS של hr_payroll עצמו - נטען אוטומטית כי המודול תלוי בו,
         בלי להוסיף שום asset חדש) ואותו widget לבועת ההתקדמות
         (hr_payroll_status_bubble). השדות המוצגים (סכום/עובדים/תשלומים) הם
         מדדים רלוונטיים למחזור, לא זהים ל-Pay Run (עלות מעסיק/ברוטו/נטו) - כפי
         שהוסבר למשתמש. state/has_error/payslips_with_issues/color כולם
         מחושבים (לא stored) - ראו l10n_il_payment_batch.py. ==== -->
    <record id="l10n_il_payment_batch_view_kanban" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.view.kanban</field>
        <field name="model">l10n.il.payment.batch</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" default_order="date desc, id desc"
                create="0" quick_create="0" records_draggable="0" group_create="false">
                <field name="color"/>
                <field name="currency_id"/>
                <field name="payslips_with_issues"/>
                <field name="has_error"/>
                <templates>
                    <t t-name="menu" class="d-flex flex-column">
                        <button name="unlink" type="object" class="btn text-danger" string="מחיקה"/>
                    </t>
                    <t t-name="card" class="o_payrun_card cursor-pointer gap-4 w-100 px-3 py-1 d-grid justify-items-center align-items-center align-content-center">
                        <div class="o_cell d-flex flex-column o_payrun_info">
                            <div class="fs-2">
                                <field name="name"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span><field name="date"/></span>
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border">
                                    <field name="l10n_il_batch_kind"/>
                                </span>
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border">
                                    <field name="payment_count"/> תשלומים
                                </span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_cost">
                            <div class="fs-2">
                                <field name="total_amount" widget="monetary"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span>סה״כ סכום</span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_cost">
                            <div class="fs-2">
                                <field name="employee_count"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span>עובדים</span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_state">
                            <field name="state" widget="hr_payroll_status_bubble"
                                options="{
                                    'remove_states': ['04_cancel'],
                                }"
                            />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==== מחזורי תשלומים - שני כפתורי כניסה: "יצירת מחזור" (בורר-סוג, שלב 0)
         ו"יצירת הוראה" (יצירה בודדת, ראו l10n_il_salary_adjustment_payment_wizard_views.xml) ==== -->
    <record id="l10n_il_payment_batch_view_list" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.view.list</field>
        <field name="model">l10n.il.payment.batch</field>
        <field name="arch" type="xml">
            <list string="מחזורים והוראות" create="false">
                <header>
                    <button name="%(action_l10n_il_payment_batch_wizard_new)d" type="action" string="יצירת מחזור" class="btn-primary" display="always"/>
                    <button name="%(action_l10n_il_salary_adjustment_payment_wizard)d"
                        type="action" string="יצירת הוראה" display="always"/>
                </header>
                <field name="name"/>
                <field name="l10n_il_batch_kind"/>
                <field name="date"/>
                <field name="total_amount" sum="סה״כ"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ==== טופס-פרטים של מחזור - עיצוב זהה לכרטיס הקנבן של Pay Run
         (אותן מחלקות o_payrun_card/o_cell/o_payrun_info/o_payrun_cost/
         o_payrun_state מ-hr_payroll, כבר נטענות אוטומטית כי המודול תלוי בו),
         עם שורת-KPI (שם/תאריך+סוג+מספר-תשלומים, סה"כ סכום, עובדים, בועת
         התקדמות) בראש הטופס, ואז טבלאות התשלומים/ההתאמות עצמן. ==== -->
    <record id="l10n_il_payment_batch_view_form" model="ir.ui.view">
        <field name="name">l10n.il.payment.batch.view.form</field>
        <field name="model">l10n.il.payment.batch</field>
        <field name="arch" type="xml">
            <form string="מחזור">
                <sheet>
                    <div class="o_payrun_card w-100 gap-4 px-0 py-1 d-grid justify-items-center align-items-center align-content-center">
                        <div class="o_cell d-flex flex-column o_payrun_info">
                            <div class="fs-2">
                                <field name="name" placeholder="שם המחזור" class="text-truncate w-100"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span><field name="date"/></span>
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border">
                                    <field name="l10n_il_batch_kind" readonly="1"/>
                                </span>
                                <span class="badge rounded-pill btn-outline-secondary btn-addr border">
                                    <field name="payment_count"/> תשלומים
                                </span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_cost">
                            <div class="fs-2">
                                <field name="total_amount" widget="monetary"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span>סה״כ סכום</span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_cost">
                            <div class="fs-2">
                                <field name="employee_count"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <span>עובדים</span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column o_payrun_state">
                            <field name="state" widget="hr_payroll_status_bubble"
                                options="{
                                    'remove_states': ['04_cancel'],
                                }"
                            />
                        </div>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="תשלומים" name="payments">
                            <field name="payment_ids">
                                <list>
                                    <field name="partner_id" string="עובד"/>
                                    <field name="l10n_il_cycle_type" string="סוג"/>
                                    <field name="date"/>
                                    <field name="amount" sum="סה״כ"/>
                                    <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'in_process'" decoration-muted="state == 'canceled'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="התאמות שכר" name="attachments" invisible="not attachment_ids">
                            <field name="attachment_ids">
                                <list>
                                    <field name="employee_ids" widget="many2many_tags"/>
                                    <field name="other_input_type_id"/>
                                    <field name="l10n_il_impact_type"/>
                                    <field name="monthly_amount" sum="סה״כ"/>
                                    <field name="state" widget="badge" decoration-success="state == 'close'" decoration-info="state == 'open'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_l10n_il_payment_batch" model="ir.actions.act_window">
        <field name="name">מחזורים</field>
        <field name="res_model">l10n.il.payment.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">יצירת מחזור ראשון</p>
            <p>מחזור תשלום/הוראה יוצר תשלום לכל עובד שיש לו סכום מוגדר לסוג מחזור התשלומים שנבחר (בטופס העובד); מחזור התאמות שכר יוצר התאמת שכר לכל עובד שנבחר.</p>
        </field>
    </record>

    <!-- ==== תפריטים: tab עליון יחיד "התאמות ותשלומים" - בדיוק 3 "כפתורים"
         (תשלומים / התאמות שכר / מחזורים והוראות) - "סוגי מחזורי תשלומים" כבר
         לא קיים כמסך נפרד, הפך לפיקליסט קבוע (ראו l10n_il_payment_cycle_type.py). ==== -->
    <menuitem id="menu_l10n_il_adjustments_payments_root"
        name="התאמות ותשלומים"
        parent="hr_work_entry_enterprise.menu_hr_payroll_root"
        sequence="71"
        groups="hr_payroll.group_hr_payroll_user"/>
    <menuitem id="menu_l10n_il_account_payment"
        name="תשלומים"
        action="action_l10n_il_account_payment"
        parent="menu_l10n_il_adjustments_payments_root"
        sequence="10"/>
    <menuitem id="menu_l10n_il_salary_adjustment"
        name="התאמות שכר"
        action="action_l10n_il_salary_adjustment"
        parent="menu_l10n_il_adjustments_payments_root"
        sequence="20"/>
    <menuitem id="menu_l10n_il_payment_batch"
        name="מחזורים והוראות"
        action="action_l10n_il_payment_batch"
        parent="menu_l10n_il_adjustments_payments_root"
        sequence="30"/>
    <!-- ==== תפריט "עובדים" בהנהלת חשבונות, ליד "לקוחות"/"ספקים" - אותם
         view/action בדיוק כמו תחת שכר, רק נגיש גם מהנהלת חשבונות. חשוב:
         ה-Enterprise App "הנהלת חשבונות" שהמשתמש בפועל רואה הוא
         accountant.menu_accounting (מודול "accountant"), לא account.menu_finance
         ("Invoicing" - נהוג להישאר כאפליקציה נפרדת/מוסתרת כשה-Accounting App
         המלא מותקן) - account_accountant/accountant מעבירים את התפריטים
         הקיימים menu_finance_receivables/menu_finance_payables לשם, ולכן גם
         אנחנו צריכים להתלות שם, לא ב-menu_finance, אחרת התפריט לא יופיע כלל
         באפליקציה שהמשתמש בפועל פותח. ==== -->
    <menuitem id="menu_l10n_il_finance_employees"
        name="עובדים"
        parent="accountant.menu_accounting"
        sequence="3"/>
    <menuitem id="menu_l10n_il_finance_employees_payments"
        name="תשלומים"
        action="action_l10n_il_account_payment"
        parent="menu_l10n_il_finance_employees"
        sequence="1"/>
    <menuitem id="menu_l10n_il_finance_employees_batches"
        name="מחזורים"
        action="action_l10n_il_payment_batch"
        parent="menu_l10n_il_finance_employees"
        sequence="2"/>
    <menuitem id="menu_l10n_il_finance_employees_list"
        name="עובדים"
        action="hr.open_view_employee_list_my"
        parent="menu_l10n_il_finance_employees"
        sequence="3"/>

    <!-- ==== טאב תשלומים בתלוש ==== -->
    <record id="view_hr_payslip_form_l10n_il_payments" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit.l10n.il.payments</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="תשלומים" name="l10n_il_payments">
                    <field name="l10n_il_payment_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="memo"/>
                            <field name="amount" sum="סה״כ"/>
                            <field name="state" widget="badge" decoration-success="state == 'paid'"/>
                            <field name="l10n_il_batch_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
