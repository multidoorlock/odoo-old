<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_il_payment_cycle_wizard_form" model="ir.ui.view">
        <field name="name">il.payment.cycle.wizard.form</field>
        <field name="model">il.payment.cycle.wizard</field>
        <field name="arch" type="xml">
            <form string="יצירת מחזור תשלומים">
                <field name="step" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="available_payment_method_ids" invisible="1"/>
                <group invisible="step != 'details'">
                    <field name="name"/>
                    <field name="cycle_type_ids" string="סוג" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="date"/>
                    <field name="batch_type"/>
                    <field name="journal_id"/>
                    <field name="payment_method_id"/>
                </group>
                <field name="employee_selection_line_ids" nolabel="1"
                       invisible="step != 'selection'">
                    <list editable="bottom" no_open="True" create="0" delete="0"
                          default_order="sequence,id">
                        <field name="sequence" column_invisible="True"/>
                        <field name="selected"/>
                        <field name="employee_id" widget="many2one_avatar_employee"
                               options="{'no_open': True}"/>
                        <field name="cycle_type_ids" widget="many2many_tags"
                               options="{'no_open': True, 'no_create': True}"/>
                    </list>
                </field>
                <field name="employee_line_ids" nolabel="1" invisible="step != 'amounts'">
                    <list editable="bottom" create="0" delete="0" default_order="sequence,id">
                        <field name="sequence" column_invisible="True"/>
                        <field name="selected"/>
                        <field name="employee_id" widget="many2one_avatar_employee"/>
                        <field name="cycle_type_id"/>
                        <field name="amount"/>
                        <field name="employee_partner_id" column_invisible="True"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="partner_bank_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_next" type="object" string="הבא" class="btn-primary"
                            invisible="step not in ('details', 'selection')"/>
                    <button name="action_previous" type="object" string="חזרה" class="btn-secondary"
                            invisible="step == 'details'"/>
                    <button name="action_create_cycles" type="object" string="יצירה" class="btn-primary"
                            invisible="step != 'amounts'"/>
                    <button string="ביטול" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_il_payment_cycle_wizard" model="ir.actions.act_window">
        <field name="name">יצירת מחזור תשלומים</field>
        <field name="res_model">il.payment.cycle.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>
</odoo>
