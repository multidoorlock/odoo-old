<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_il_payroll_reconciliation_wizard" model="ir.ui.view">
        <field name="name">il.payroll.reconciliation.wizard.form</field>
        <field name="model">il.payroll.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="תשלומים מקושרים">
                <field name="source_payment_id" invisible="1"/>
                <field name="source_payslip_id" invisible="1"/>
                <field name="add_only" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="available_payment_ids" invisible="1"/>
                <field name="available_payslip_ids" invisible="1"/>
                <group>
                    <field name="employee_id" string="עובד" readonly="1"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="add_only">
                    הוסף שורה, שנה סכום או הסר שורה כדי לשנות את הקיזוז בלבד.
                    סכומי התשלום והתלוש נשארים כפי שנרשמו.
                </div>
                <div class="alert alert-info" role="alert" invisible="not add_only">
                    בחר תשלום עם יתרה פתוחה ואת הסכום שיקושר לתלוש.
                    תשלומים שכבר מקושרים לתלוש מופיעים ברשימת התשלומים המקושרים.
                </div>
                <field name="line_ids" nolabel="1"
                       context="{'default_payment_id': source_payment_id, 'default_payslip_id': source_payslip_id}">
                    <list editable="bottom">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="is_existing" column_invisible="True"/>
                        <field name="payment_id" readonly="is_existing or parent.source_payment_id"
                               domain="[('id', 'in', parent.available_payment_ids)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="memo" optional="show" readonly="1"/>
                        <field name="payment_amount" optional="hide" readonly="1"/>
                        <field name="payment_available_amount" readonly="1"/>
                        <field name="payslip_id" readonly="is_existing or parent.source_payslip_id"
                               column_invisible="parent.source_payslip_id"
                               domain="[('id', 'in', parent.available_payslip_ids)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="payslip_remaining" optional="hide" readonly="1"/>
                        <field name="amount" sum="סה״כ להכרה"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="שמירת שינויים"
                            class="btn-primary" invisible="add_only"/>
                    <button name="action_apply" type="object" string="קישור לתלוש"
                            class="btn-primary" invisible="not add_only"/>
                    <button special="cancel" string="ביטול" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_il_payslip_payment_selection_wizard" model="ir.ui.view">
        <field name="name">il.payslip.payment.selection.wizard.form</field>
        <field name="model">il.payslip.payment.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="תשלומים שנבחרו">
                <field name="operation" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="source_payslip_id" options="{'no_open': True}"/>
                        <field name="employee_id" options="{'no_open': True}"/>
                    </group>
                    <group>
                        <field name="payslip_remaining"/>
                        <field name="total_amount" invisible="operation == 'remove'"/>
                    </group>
                </group>
                <p invisible="operation != 'add'">
                    הזן את הסכום להכרה בכל תשלום שנבחר. סכום אפס משאיר את התשלום ללא קישור לתלוש זה.
                </p>
                <p invisible="operation != 'remove'">
                    הקישור של התשלומים שנבחרו לתלוש יוסר. סכומי התשלומים יישמרו.
                </p>
                <field name="line_ids" nolabel="1" readonly="operation == 'remove'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="payment_date"/>
                        <field name="payment_id" options="{'no_open': True}"/>
                        <field name="memo" optional="show"/>
                        <field name="payment_amount"/>
                        <field name="amount" sum="סה״כ להכרה" readonly="parent.operation == 'remove'"/>
                        <field name="available_amount"/>
                        <field name="current_amount" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="קישור לתלוש"
                            class="btn-primary" invisible="operation != 'add'"/>
                    <button name="action_apply" type="object" string="שמירת הסכומים"
                            class="btn-primary" invisible="operation != 'edit'"/>
                    <button name="action_apply" type="object" string="הסרת הקישור"
                            class="btn-primary" invisible="operation != 'remove'"/>
                    <button special="cancel" string="ביטול" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
