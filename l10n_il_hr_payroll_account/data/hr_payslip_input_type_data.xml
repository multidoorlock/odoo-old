<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================
             סוגי התאמות שכר (Salary Adjustment Types) — סעיף "Salary
             Adjustment Types שיש ליצור" + מיפוי הבסיסים המחייב.
             ============================================================ -->

        <record id="input_type_il_adj_salary_addition" model="hr.payslip.input.type">
            <field name="name">תוספת שכר</field>
            <field name="code">IL_ADJ_SALARY_ADDITION</field>
            <field name="country_id" ref="base.il"/>
            <field name="available_in_attachments">True</field>
            <field name="il_adjustment_direction">positive</field>
            <field name="il_net_adjustment_treatment">gross_up</field>
            <field name="il_income_taxable">True</field>
            <field name="il_national_insurance_applicable">True</field>
            <field name="il_pensionable">True</field>
            <field name="il_severance_applicable">True</field>
            <field name="il_study_fund_applicable">True</field>
            <field name="il_equalization_levy_applicable">True</field>
            <field name="il_ni_payment_treatment">regular</field>
        </record>

