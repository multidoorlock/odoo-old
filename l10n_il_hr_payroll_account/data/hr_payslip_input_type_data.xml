            <field name="il_income_taxable">True</field>
            <field name="il_national_insurance_applicable">True</field>
            <field name="il_pensionable">False</field>
            <field name="il_severance_applicable">False</field>
            <field name="il_study_fund_applicable">False</field>
            <field name="il_equalization_levy_applicable">True</field>
            <field name="il_ni_payment_treatment">additional_payment</field>
        </record>

