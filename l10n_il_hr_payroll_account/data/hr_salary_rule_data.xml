    <record id="rule_ilm_payment_adj" model="hr.salary.rule">
        <field name="name">סך הכל תשלומי עובד</field>
        <field name="code">IL_PAYMENT_ADJ</field>
        <field name="sequence">206</field>
        <field name="category_id" ref="l10n_il_hr_payroll.rule_category_il_net_to_pay_ded"/>
        <field name="condition_select">input</field>
        <field name="condition_other_input_id" ref="input_il_payment_adj"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# תשלומים לעובד (account.payment עם השפעה על שכר) שנאספו לתלוש הבא: תשלום ששלחנו
# לעובד (Send) מנוכה מהנטו לתשלום; תשלום שהתקבל ממנו (Receive) נוסף לנטו לתשלום.
result = inputs['IL_PAYMENT_ADJ'].amount
</field>
        <field name="struct_id" ref="l10n_il_hr_payroll.hr_payroll_structure_il_employee_salary"/>
    </record>
    <record id="rule_ilm_overpayment_closure" model="hr.salary.rule">
        <field name="name">סך הכל תשלומי יתר שנסגרו</field>
        <field name="code">IL_OVERPAYMENT_CLOSURE</field>
        <field name="sequence">207</field>
        <field name="category_id" ref="l10n_il_hr_payroll.rule_category_il_net_to_pay_ded"/>
        <field name="condition_select">input</field>
        <field name="condition_other_input_id" ref="input_il_overpayment_closure"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# סכום היתרות של תלושי תשלום-יתר אחרים שנבחרו להיסגר דרך התלוש הזה (ראו
# l10n_il_overpayment_closure.py) - מנוכה מהנטו לתשלום של התלוש הזה, כי חלק
# ממה שהיה משתלם כאן מכסה בפועל את החוב הישן במקום.
result = -inputs['IL_OVERPAYMENT_CLOSURE'].amount
</field>
        <field name="struct_id" ref="l10n_il_hr_payroll.hr_payroll_structure_il_employee_salary"/>
    </record>

