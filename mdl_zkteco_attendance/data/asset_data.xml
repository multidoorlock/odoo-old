<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Register the conflict Gantt extension in the same lazy bundle as the
        native Odoo Gantt implementation. Database records also make a normal
        module upgrade invalidate that bundle for already-running workers.
    -->
    <record id="asset_conflict_timeline_js" model="ir.asset">
        <field name="name">ZKTeco attendance conflict timeline JavaScript v19.0.5.9.68</field>
        <field name="bundle">web.assets_backend_lazy</field>
        <field name="directive">append</field>
        <field name="path">mdl_zkteco_attendance/static/src/conflict_timeline/conflict_timeline.js</field>
    </record>

    <record id="asset_conflict_timeline_xml" model="ir.asset">
        <field name="name">ZKTeco attendance conflict timeline templates v19.0.5.9.68</field>
        <field name="bundle">web.assets_backend_lazy</field>
        <field name="directive">append</field>
        <field name="path">mdl_zkteco_attendance/static/src/conflict_timeline/conflict_timeline.xml</field>
    </record>

    <record id="asset_conflict_timeline_scss" model="ir.asset">
        <field name="name">ZKTeco attendance conflict timeline styles v19.0.5.9.68</field>
        <field name="bundle">web.assets_backend_lazy</field>
        <field name="directive">append</field>
        <field name="path">mdl_zkteco_attendance/static/src/conflict_timeline/conflict_timeline.scss</field>
    </record>
</odoo>
