<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mdl_zk_raw_log_list" model="ir.ui.view">
        <field name="name">mdl.zk.raw.log.list</field>
        <field name="model">mdl.zk.raw.log</field>
        <field name="arch" type="xml">
            <list
                string="ZKTeco Raw Requests"
                create="true"
                edit="true"
                delete="true"
            >
                <field name="received_at"/>
                <field name="device_sn"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="remote_ip"/>
            </list>
        </field>
    </record>

    <record id="view_mdl_zk_raw_log_form" model="ir.ui.view">
        <field name="name">mdl.zk.raw.log.form</field>
        <field name="model">mdl.zk.raw.log</field>
        <field name="arch" type="xml">
            <form
                string="ZKTeco Raw Request"
                create="true"
                edit="true"
                delete="true"
            >
                <sheet>
                    <group>
                        <group>
                            <field name="received_at"/>
                            <field name="device_sn"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                        </group>

                        <group>
                            <field name="remote_ip"/>
                            <field name="query_string"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Request Body">
                            <field
                                name="request_body"
                                nolabel="1"
                            />
                        </page>

                        <page string="Request Headers">
                            <field
                                name="request_headers"
                                nolabel="1"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mdl_zk_raw_log" model="ir.actions.act_window">
        <field name="name">Raw Requests</field>
        <field name="res_model">mdl.zk.raw.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_mdl_zkteco_root"
        name="ZKTeco"
        sequence="90"
        groups="base.group_system"
    />

    <menuitem
        id="menu_mdl_zkteco_raw_log"
        name="Raw Requests"
        parent="menu_mdl_zkteco_root"
        action="action_mdl_zk_raw_log"
        sequence="10"
        groups="base.group_system"
    />

</odoo>
