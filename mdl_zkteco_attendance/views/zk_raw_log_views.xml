<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mdl_zk_raw_log_list" model="ir.ui.view">
        <field name="name">mdl.zk.raw.log.list</field>
        <field name="model">mdl.zk.raw.log</field>

        <field name="arch" type="xml">
            <list
                create="false"
                edit="false"
            >
                <field name="received_at"/>
                <field name="device_id"/>
                <field name="device_sn"/>
                <field name="remote_ip"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="table_name"/>
                <field name="processing_state"/>
                <field name="command_id"/>
            </list>
        </field>
    </record>

    <record id="view_mdl_zk_raw_log_form" model="ir.ui.view">
        <field name="name">mdl.zk.raw.log.form</field>
        <field name="model">mdl.zk.raw.log</field>

        <field name="arch" type="xml">
            <form
                create="false"
                edit="false"
            >
                <sheet>

                    <group>
                        <group>
                            <field name="received_at"/>
                            <field name="device_id"/>
                            <field name="device_sn"/>
                            <field name="remote_ip"/>
                        </group>

                        <group>
                            <field name="method"/>
                            <field name="endpoint"/>
                            <field name="table_name"/>
                            <field name="processing_state"/>
                            <field name="command_id"/>
                        </group>
                    </group>

                    <field name="processing_message"/>

                    <notebook>

                        <page string="Request Body">
                            <field
                                name="request_body"
                                nolabel="1"
                            />
                        </page>

                        <page string="Query String">
                            <field
                                name="query_string"
                                nolabel="1"
                            />
                        </page>

                        <page string="Request Headers">
                            <field
                                name="request_headers"
                                nolabel="1"
                            />
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mdl_zk_raw_log" model="ir.actions.act_window">
        <field name="name">Raw Requests</field>
        <field name="res_model">mdl.zk.raw.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>