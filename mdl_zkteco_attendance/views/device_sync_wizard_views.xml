<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_device_sync_wizard_form" model="ir.ui.view">
        <field name="name">mdl.attendance.device.sync.wizard.form</field>
        <field name="model">mdl.attendance.device.sync.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="device_id"/>
                    <field name="direction" widget="radio"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="direction != 'pull'">
                    המשיכה כוללת את הגדרות השעון, כל הכרטיסים, תמונות הפרופיל,
                    מצב טביעות האצבע והפנים ורשומות הנוכחות. תמונה ביומטרית אינה
                    נמשכת מפני שהשעון אינו מחזיר אותה.
                </div>
                <div class="alert alert-info" role="alert" invisible="direction != 'push'">
                    השליחה כוללת את הגדרות השעון ואת כל פרטי כל הכרטיסים,
                    כולל תמונות פרופיל ותמונות ביומטריות.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="אישור" class="btn-primary"/>
                    <button string="ביטול" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
