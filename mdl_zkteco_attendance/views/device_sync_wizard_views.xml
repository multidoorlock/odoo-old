<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_device_sync_wizard_form" model="ir.ui.view">
        <field name="name">mdl.attendance.device.sync.wizard.form</field>
        <field name="model">mdl.attendance.device.sync.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="device_id"/>
                    <field name="direction"/>
                    <field name="selection_mode" widget="radio"/>
                    <field name="device_employee_ids" widget="many2many_tags"
                           invisible="selection_mode != 'selected'"
                           required="selection_mode == 'selected'"/>
                </group>
                <group string="מידע">
                    <field name="sync_name"/>
                    <field name="sync_privilege"/>
                    <field name="sync_verification_mode"/>
                    <field name="sync_profile_photo"/>
                    <field name="sync_biometric_photo" string="תמונת פנים לזיהוי"
                           invisible="direction == 'pull'"
                           groups="mdl_zkteco_attendance.group_attendance_device_manager"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="not sync_biometric_photo or direction == 'pull'">
                    התמונה נשלחת לשעון כ־BIOPHOTO Type 9, והשעון יוצר ממנה את תבנית זיהוי הפנים.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="אישור" class="btn-primary"/>
                    <button string="ביטול" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
