<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mdl_zk_device_list" model="ir.ui.view">
        <field name="name">mdl.zk.device.list</field>
        <field name="model">mdl.zk.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="last_ip"/>
                <field name="last_seen_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mdl_zk_device_form" model="ir.ui.view">
        <field name="name">mdl.zk.device.form</field>
        <field name="model">mdl.zk.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="last_ip"/>
                            <field name="last_seen_at"/>
                            <field name="default_photo_type"/>
                        </group>
                    </group>

                    <group string="ADMS Stamps">
                        <field name="attendance_stamp"/>
                        <field name="operation_stamp"/>
                        <field name="photo_stamp"/>
                    </group>

                    <notebook>

                        <page string="עובדים">
                            <field name="employee_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="zk_user_id"/>
                                    <field name="zk_sync_state"/>
                                </list>
                            </field>
                        </page>

                        <page string="פקודות">
                            <field name="command_ids">
                                <list>
                                    <field name="id"/>
                                    <field name="employee_id"/>
                                    <field name="command_type"/>
                                    <field name="state"/>
                                    <field name="sent_at"/>
                                    <field name="completed_at"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mdl_zk_device" model="ir.actions.act_window">
        <field name="name">שעונים</field>
        <field name="res_model">mdl.zk.device</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>