<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pending_attendance_wizard_form" model="ir.ui.view">
        <field name="name">mdl.attendance.pending.wizard.form</field>
        <field name="model">mdl.attendance.pending.wizard</field>
        <field name="arch" type="xml">
            <form string="רשומות נוכחות מוכנות לעיבוד">
                <group>
                    <field name="device_employee_id"/>
                    <field name="employee_id"/>
                </group>
                <field name="interval_line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="interval_type" widget="badge"/>
                        <field name="check_in"/>
                        <field name="check_out"/>
                        <button name="action_apply" type="object" icon="fa-check"
                                title="הכנס את הרשומה למערכת" class="btn-success"/>
                        <button name="action_dismiss" type="object" icon="fa-times"
                                title="התעלם מהאירועים לצמיתות" class="btn-danger"
                                confirm="אירועי הכניסה והיציאה יישכחו לצמיתות ולא יוצעו שוב. האם אתה בטוח?"/>
                    </list>
                </field>
                <footer><button string="סגור" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
