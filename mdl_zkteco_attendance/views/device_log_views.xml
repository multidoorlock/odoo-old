<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_device_log_list" model="ir.ui.view"><field name="name">mdl.attendance.device.log.list</field><field name="model">mdl.attendance.device.log</field><field name="arch" type="xml">
        <list create="true" edit="true" delete="true"><field name="received_at"/><field name="device_id"/><field name="device_identifier"/><field name="request_type"/><field name="processing_state" widget="badge"/><field name="command_id"/></list>
    </field></record>
    <record id="view_device_log_form" model="ir.ui.view"><field name="name">mdl.attendance.device.log.form</field><field name="model">mdl.attendance.device.log</field><field name="arch" type="xml">
        <form create="true" edit="true" delete="true"><sheet><group><group><field name="received_at" readonly="0"/><field name="device_id" readonly="0"/><field name="device_identifier" readonly="0"/><field name="request_type" readonly="0"/></group><group><field name="processing_state" widget="badge" readonly="0"/><field name="processing_message" readonly="0"/><field name="http_method" readonly="0"/><field name="endpoint" readonly="0"/><field name="remote_ip" readonly="0"/><field name="command_id" readonly="0"/></group></group><notebook><page string="אירועים"><field name="event_ids"><list create="false" edit="false" delete="false"><field name="event_datetime"/><field name="device_employee_id"/><field name="employee_id"/><field name="punch_state"/><field name="processing_state" widget="badge"/><field name="attendance_id"/></list></field></page><page string="Body"><field name="body" nolabel="1" readonly="0"/><field name="body_binary" filename="request_type" readonly="0"/></page><page string="Query String"><field name="query_string" nolabel="1" readonly="0"/></page><page string="Headers"><field name="headers" nolabel="1" readonly="0"/></page></notebook></sheet></form>
    </field></record>
    <record id="view_device_log_search" model="ir.ui.view"><field name="name">mdl.attendance.device.log.search</field><field name="model">mdl.attendance.device.log</field><field name="arch" type="xml">
        <search><field name="device_id"/><field name="request_type"/><filter name="processed" string="עובד" domain="[('processing_state','=','processed')]"/><filter name="waiting" string="ממתין לקישור" domain="[('processing_state','=','waiting_employee_link')]"/><filter name="not_applied" string="לא יושם" domain="[('processing_state','=','not_applied')]"/><filter name="error" string="שגיאה" domain="[('processing_state','=','error')]"/><filter name="attlog" string="ATTLOG" domain="[('request_type','=','ATTLOG')]"/><filter name="userinfo" string="USERINFO" domain="[('request_type','=','USERINFO')]"/></search>
    </field></record>
    <record id="action_device_log" model="ir.actions.act_window"><field name="name">לוגים</field><field name="res_model">mdl.attendance.device.log</field><field name="view_mode">list,form</field></record>
</odoo>
