<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_device_list" model="ir.ui.view">
        <field name="name">mdl.attendance.device.list</field><field name="model">mdl.attendance.device</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="manufacturer"/><field name="device_identifier"/><field name="company_id" groups="base.group_multi_company"/><field name="last_seen_at"/><field name="last_ip"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_attendance_device_form" model="ir.ui.view">
        <field name="name">mdl.attendance.device.form</field><field name="model">mdl.attendance.device</field>
        <field name="arch" type="xml">
        <form>
            <header><button name="action_open_push_wizard" type="object" string="שלח מידע לשעון" class="btn-primary"/><button name="action_open_pull_wizard" type="object" string="משוך מידע מהשעון"/><button name="action_discover_users" type="object" string="גלה כרטיסים מהשעון"/><button name="action_reconcile_attendance" type="object" string="סנכרן רשומות נוכחות" groups="mdl_zkteco_attendance.group_attendance_device_manager"/></header>
            <sheet><group><group><field name="name"/><field name="manufacturer"/><field name="device_identifier"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group><group><field name="timezone"/><field name="last_seen_at"/><field name="last_ip"/></group></group>
            <notebook><page string="כרטיסי עובדים"><field name="device_employee_ids" context="{'default_device_id': id}"><list><field name="employee_id"/><field name="device_user_id"/><field name="device_name_display" string="שם בכרטיס"/><field name="link_state" widget="badge"/><field name="sync_state" widget="badge" decoration-success="sync_state == 'synced'" decoration-warning="sync_state in ['pending_push', 'pending_pull']" decoration-danger="sync_state == 'error'"/></list></field></page>
            <page string="סנכרון" groups="mdl_zkteco_attendance.group_attendance_device_manager"><group><field name="auto_discover_users"/><field name="auto_push_new_cards"/><field name="auto_sync_name"/><field name="auto_sync_profile_photo"/><field name="auto_sync_biometric_photo"/><field name="auto_reconcile_attendance"/><field name="attendance_reconcile_lookback_days" invisible="not auto_reconcile_attendance"/><field name="last_attendance_sync_at"/></group></page>
            <page string="טכני" groups="mdl_zkteco_attendance.group_attendance_device_technical"><group><field name="punch_state_column"/><field name="punch_in_values"/><field name="punch_out_values"/><field name="attendance_stamp"/><field name="operation_stamp"/><field name="photo_stamp"/><field name="default_photo_type"/></group></page></notebook></sheet>
        </form>
        </field>
    </record>
    <record id="view_attendance_device_search" model="ir.ui.view"><field name="name">mdl.attendance.device.search</field><field name="model">mdl.attendance.device</field><field name="arch" type="xml">
        <search><field name="name"/><field name="device_identifier"/><filter name="archived" string="בארכיון" domain="[('active','=',False)]"/></search>
    </field></record>
    <record id="action_attendance_device" model="ir.actions.act_window"><field name="name">שעונים</field><field name="res_model">mdl.attendance.device</field><field name="view_mode">list,form</field></record>
</odoo>
