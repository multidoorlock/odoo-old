<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mdl_zkteco_attendance.DeviceNameSelectedField">
        <t t-if="props.readonly">
            <span t-esc="formattedValue"/>
        </t>
        <t t-else="">
            <input
                class="o_input o_field_translate"
                t-att-id="props.id"
                type="text"
                autocomplete="off"
                t-att-maxlength="maxLength > 0 and maxLength"
                t-att-placeholder="props.placeholder"
                t-on-blur="onBlur"
                t-ref="input"
            />
            <div class="o_field_input_buttons">
                <TranslationButton fieldName="'device_name'" record="props.record"/>
            </div>
        </t>
    </t>
</templates>
