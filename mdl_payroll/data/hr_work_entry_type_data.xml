<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="work_entry_type_weekend" model="hr.work.entry.type">
            <field name="name">עבודה בסוף שבוע</field>
            <field name="code">WEEKEND</field>
            <field name="display_code">סשב</field>
            <field name="color">5</field>
            <field name="is_leave">False</field>
            <field name="round_days">NO</field>
        </record>

        <record id="work_entry_type_additional_day" model="hr.work.entry.type">
            <field name="name">יום עבודה נוסף</field>
            <field name="code">ADDITIONAL_DAY</field>
            <field name="display_code">נסף</field>
            <field name="color">6</field>
            <field name="is_leave">False</field>
            <field name="round_days">NO</field>
        </record>

        <record id="work_entry_type_sleep" model="hr.work.entry.type">
            <field name="name">שינה במשמרת ערב</field>
            <field name="code">SLEEP</field>
            <field name="display_code">שנה</field>
            <field name="color">3</field>
            <field name="is_leave">False</field>
            <field name="round_days">NO</field>
            <!-- שינה אינה מזכה בתשלום -->
            <field name="amount_rate">0.0</field>
        </record>

        <record id="work_entry_type_unpaid_absence" model="hr.work.entry.type">
            <field name="name">היעדרות ללא תשלום</field>
            <field name="code">UNPAID_ABSENCE</field>
            <field name="display_code">העד</field>
            <field name="color">1</field>
            <field name="is_leave">False</field>
            <field name="round_days">NO</field>
            <field name="amount_rate">0.0</field>
        </record>
    </data>

    <!-- ביטול עיגול מובנה בסוגי הרשומות הסטנדרטיים שהמנוע משתמש בהם
         (סעיף 29 באפיון) — המנוע יוצר את הרשומות מראש במשך הנכון. -->
    <record id="hr_work_entry.work_entry_type_attendance" model="hr.work.entry.type">
        <field name="round_days">NO</field>
    </record>
    <record id="hr_work_entry.work_entry_type_overtime" model="hr.work.entry.type">
        <field name="round_days">NO</field>
    </record>
</odoo>
