<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_labels_batch_wizard_form" model="ir.ui.view">
        <field name="name">labels.batch.wizard.form</field>
        <field name="model">labels.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="יצירת טווח" class="labels-range-popup labels-rtl">
                <sheet>
                    <div class="labels-popup-layout">
                        <div class="labels-popup-visual">
                            <img src="/labels/static/src/img/red_label.svg" alt="Label" class="labels-popup-image"/>
                        </div>
                        <div class="labels-popup-fields">
                            <group>
                                <group>
                                    <field name="prefix" placeholder="A"/>
                                    <field name="first_number"/>
                                    <field name="last_number"/>
                                </group>
                            </group>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-success labels-popup-button"/>
                    <button string="Cancel" special="cancel" class="btn-success labels-popup-button"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_labels_batch_wizard" model="ir.actions.act_window">
        <field name="name">יצירת טווח</field>
        <field name="res_model">labels.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_labels_batch_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
