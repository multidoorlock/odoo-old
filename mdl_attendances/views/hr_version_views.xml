<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_segment_ruleset" model="ir.ui.view">
        <field name="name">hr.employee.form.segment.ruleset</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/>
        <field name="arch" type="xml">
            <field name="ruleset_id" position="after">
                <field name="segment_ruleset_id" string="Attendance Segmentation Ruleset"
                       placeholder="Select rules that define effective worked intervals."/>
            </field>
        </field>
    </record>
</odoo>
