<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_overtime_rule_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.rule.form.inherit.attandences.customizations</field>
        <field name="model">hr.attendance.overtime.rule</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_overtime_rule_view_form"/>
        <field name="arch" type="xml">
            <field name="base_off" position="after">
                <field name="att_attendance_type" string="חל על סוג משמרת"/>
            </field>
        </field>
    </record>

    <record id="hr_attendance_overtime_rule_view_list_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.rule.list.inherit.attandences.customizations</field>
        <field name="model">hr.attendance.overtime.rule</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_overtime_rule_view_list"/>
        <field name="arch" type="xml">
            <field name="base_off" position="after">
                <field name="att_attendance_type"/>
            </field>
        </field>
    </record>
</odoo>
