<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "סוג לוח זמנים לעבודה" (נוכחות/משמרות) + "סוג ספירת שעות" (שעתי/
         יומי/שבועי, שעתי לא זמין במשמרות) - ברמת ה-Working Schedule עצמו
         (resource.calendar), לא ברמת החוזה/העובד - כל עובד ששובץ ללוח כזה
         "יורש" את ההתנהגות דרכו. -->
    <record id="resource_calendar_view_form_l10n_il" model="ir.ui.view">
        <field name="name">resource.calendar.view.form.inherit.l10n.il</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <!-- שדה "Flexible/Fully Fixed" הילידי אינו רלוונטי למודל שלנו
                 (l10n_il_schedule_type/l10n_il_counting_type מחליפים אותו
                 לגמרי) ומבלבל - מוסתר. -->
            <field name="schedule_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="schedule_type" position="after">
                <field name="l10n_il_schedule_type" widget="radio"/>
                <field name="l10n_il_counting_type" widget="radio"/>

                <!-- נוכחות + יומי: "כמה שעות זו יומית אחת" (לא בטבלה - שדה
                     כללי ללוח). -->
                <group invisible="l10n_il_schedule_type != 'attendance' or l10n_il_counting_type != 'daily'">
                    <field name="l10n_il_daily_base_hours" widget="float_time"/>
                </group>

                <!-- נוכחות + שבועי: אין ימים ספציפיים - רק יעד שבועי כולל. -->
                <group invisible="l10n_il_schedule_type != 'attendance' or l10n_il_counting_type != 'weekly'">
                    <field name="l10n_il_weekly_days"/>
                    <field name="l10n_il_weekly_total_hours" widget="float_time"/>
                    <field name="l10n_il_weekly_work_entry_type_id"/>
                </group>

                <!-- משמרות (יומי ושבועי כאחד) - סוג רשומת נוכחות ברמת הלוח,
                     לא לכל יום בנפרד. -->
                <group invisible="l10n_il_schedule_type != 'shifts'">
                    <field name="l10n_il_shift_morning_type_id"/>
                    <field name="l10n_il_shift_afternoon_type_id"/>
                </group>

                <!-- משמרות + שבועי: אין ימים ספציפיים - רק כמה משמרות מכל
                     סוג בשבוע. -->
                <group invisible="l10n_il_schedule_type != 'shifts' or l10n_il_counting_type != 'weekly'">
                    <field name="l10n_il_weekly_morning_shifts"/>
                    <field name="l10n_il_weekly_afternoon_shifts"/>
                    <field name="l10n_il_weekly_any_shifts"/>
                </group>
            </field>

            <!-- "Define Amount of Hours per day" הילידי (switch_based_on_duration) -
                 לא בשימוש בכלל במודל הזה (יומי משתמש בשדות מותאמים אישית,
                 לא ב-duration_based הילידי). -->
            <label for="switch_based_on_duration" position="attributes">
                <attribute name="invisible">1</attribute>
            </label>
            <button name="switch_based_on_duration" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>

            <!-- עמוד ימי העבודה: מוצג רק בשעתי (נוכחות) וביומי (נוכחות/
                 משמרות) - לא בשבועי (אין ימים ספציפיים בכלל). -->
            <page name="working_hours" position="attributes">
                <attribute name="invisible">flexible_hours or two_weeks_calendar or l10n_il_counting_type == 'weekly'</attribute>
            </page>

            <!-- attendance_ids הילידי (section_one2many) - רק לנוכחות+שעתי,
                 בדיוק כמו היום. -->
            <field name="attendance_ids" position="attributes">
                <attribute name="invisible">l10n_il_schedule_type != 'attendance' or l10n_il_counting_type != 'hourly'</attribute>
            </field>

            <!-- נוכחות + יומי: רשימה רגילה עם עמודות מותאמות (שעות/יומיות
                 לכל יום), במקום ה-widget הילידי שלא חושף אותן. -->
            <field name="attendance_ids" position="after">
                <field name="attendance_ids" invisible="l10n_il_schedule_type != 'attendance' or l10n_il_counting_type != 'daily'">
                    <list editable="bottom">
                        <field name="dayofweek"/>
                        <field name="l10n_il_day_kind"/>
                        <field name="l10n_il_day_hours" invisible="l10n_il_day_kind != 'hours'"/>
                        <field name="l10n_il_day_units" invisible="l10n_il_day_kind != 'daily_units'"/>
                        <field name="l10n_il_day_total_hours" widget="float_time" readonly="1"/>
                        <field name="work_entry_type_id"/>
                    </list>
                </field>

                <!-- משמרות + יומי: 7 ימי השבוע (תמיד קיימים) - בחירה אחת
                     מ-4 לכל יום; attendance_ids נגזרות אוטומטית מזה, לא
                     נערכות ידנית. -->
                <field name="l10n_il_shift_weekday_ids" invisible="l10n_il_schedule_type != 'shifts' or l10n_il_counting_type != 'daily'">
                    <list editable="bottom" create="false" delete="false">
                        <field name="dayofweek" readonly="1"/>
                        <field name="l10n_il_shift_choice"/>
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>
