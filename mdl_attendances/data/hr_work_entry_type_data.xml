<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- הסוג הכללי "נוכחות" נשאר פעיל: הוא משמש עובדים שלוח הזמנים שלהם (resource.calendar)
         מסוג "נוכחות" (l10n_il_schedule_type='attendance'). רק עובדי לוח משמרות מקבלים את
         הסוגים הייעודיים (בוקר/ערב, ניתנים להתאמה אישית ללוח - ראו
         l10n_il_shift_morning_type_id/l10n_il_shift_afternoon_type_id) - ה-override
         ב-hr_version.py מחליף את הסוג הכללי באחד מהם לפי שעת הכניסה בפועל
         (hr_attendance.py._classify_check_in).

         round_days='FULL'/round_days_type='UP': העיגול "יום קצר = יום מלא"
         נעשה כאן, דרך המנגנון המובנה של אודו (hr.work.entry.type.round_days,
         מוצג ב-hr.payslip.worked_days.number_of_days - ראו
         hr_payslip._get_worked_day_lines_values) - לא יותר על ידי כפיית
         משך רשומת העבודה בקוד. שעות מעבר ליום שלם כבר לא נכללות כאן בכלל:
         המנוע הילידי של שעות נוספות (hr.attendance.overtime.rule) מפריד
         אותן החוצה *לפני* יצירת רשומת העבודה הזאת (ראו
         hr_work_entry_attendance._get_attendance_intervals: מחסיר את
         overtime_intervals מה-attendance הרגילה) - לכן "יום" כאן תמיד
         מתעגל כלפי מעלה לכל היותר ל-1.0, לא ל-2.0 גם אם העובד עבד הרבה
         מעבר לשעות המשמרת. -->
    <function model="hr.work.entry.type" name="write"
        eval="[[ref('hr_work_entry.work_entry_type_attendance')], {'active': True, 'round_days': 'FULL', 'round_days_type': 'UP'}]"/>

    <record id="work_entry_type_morning_attendance" model="hr.work.entry.type">
        <field name="name">משמרת בוקר</field>
        <field name="code">IL_ATT_MORNING</field>
        <field name="display_code">בוק</field>
        <field name="color">3</field>
        <field name="is_leave">False</field>
        <field name="is_extra_hours">False</field>
        <field name="amount_rate">1.0</field>
        <field name="round_days">FULL</field>
        <field name="round_days_type">UP</field>
    </record>

    <record id="work_entry_type_afternoon_attendance" model="hr.work.entry.type">
        <field name="name">משמרת ערב</field>
        <field name="code">IL_ATT_AFTERNOON</field>
        <field name="display_code">ערב</field>
        <field name="color">2</field>
        <field name="is_leave">False</field>
        <field name="is_extra_hours">False</field>
        <field name="amount_rate">1.0</field>
        <field name="round_days">FULL</field>
        <field name="round_days_type">UP</field>
    </record>

    <!-- משמרות שחלות ביום שישי/שבת (מקומי) - אותה קביעת שעות-נומינליות למשמרת
         (9.5/14.5) כמו יום חול, אבל לפי שכר-יום נפרד (l10n_il_weekend_daily_wage
         ב-hr_version.py) - ראו hr_payslip_worked_days.py. סווג אוטומטית לפי
         hr_attendance.py._classify_check_in, לא ניתן לבחירה ידנית. -->
    <record id="work_entry_type_morning_weekend_attendance" model="hr.work.entry.type">
        <field name="name">משמרת בוקר - שישי/שבת</field>
        <field name="code">IL_ATT_MORNING_WEEKEND</field>
        <field name="display_code">בוק׳ סופ״ש</field>
        <field name="color">4</field>
        <field name="is_leave">False</field>
        <field name="is_extra_hours">False</field>
        <field name="amount_rate">1.0</field>
        <field name="round_days">FULL</field>
        <field name="round_days_type">UP</field>
    </record>

    <record id="work_entry_type_afternoon_weekend_attendance" model="hr.work.entry.type">
        <field name="name">משמרת ערב - שישי/שבת</field>
        <field name="code">IL_ATT_AFTERNOON_WEEKEND</field>
        <field name="display_code">ערב סופ״ש</field>
        <field name="color">1</field>
        <field name="is_leave">False</field>
        <field name="is_extra_hours">False</field>
        <field name="amount_rate">1.0</field>
        <field name="round_days">FULL</field>
        <field name="round_days_type">UP</field>
    </record>

    <!-- "העדרות" - יום שהעובד לא-משמרות היה אמור לעבוד בו (לפי הימים
         המוגדרים בלוח שלו) אבל אין לו שום נוכחות ואין לו חופשה/מחלה
         מאושרת ב-Time Off (יום שממש אין עליו מידע). נוצרת אוטומטית -
         ראו hr_version.py._l10n_il_create_absence_entries - תמיד עם
         duration=hours_per_day (יום מלא בשעות, גם אם התשלום עליו 0). התשלום
         בפועל נקבע לפי l10n_il_missing_days_policy - ראו
         hr_payslip_worked_days.py._compute_amount. -->
    <record id="work_entry_type_absence" model="hr.work.entry.type">
        <field name="name">העדרות</field>
        <field name="code">IL_ABSENCE</field>
        <field name="display_code">העדרות</field>
        <field name="color">5</field>
        <field name="is_leave">False</field>
        <field name="is_extra_hours">False</field>
        <field name="amount_rate">1.0</field>
    </record>

    <!-- "שינה" - חלק ממשמרת ערב (01:30-06:30, 5 שעות קבועות) שבו העובד ישן ולא
         עובד בפועל, לכן לא משולם: לא מופיע ב-L10N_IL_SHIFT_CODE_INFO
         (hr_payslip_worked_days.py) ולכן לא נספר כיום-עבודה ולא משולם. נוצר
         אוטומטית לצד רשומת "משמרת ערב" (9.5 שעות משולמות) - ראו
         hr_version.py._get_real_attendance_work_entry_vals. -->
    <record id="work_entry_type_sleep" model="hr.work.entry.type">
        <field name="name">שינה (משמרת ערב)</field>
        <field name="code">IL_SLEEP</field>
        <field name="display_code">שינה</field>
        <field name="color">8</field>
        <field name="is_leave">False</field>
        <field name="is_extra_hours">False</field>
        <field name="amount_rate">0.0</field>
    </record>

    <!-- הסוג הייעודי "שעות נוספות - נוכחות" הוחלף בסוג המובנה של אודו "Overtime Hours"
         (hr_work_entry.work_entry_type_overtime, קוד OVERTIME) - לכן מוסתר ולא בשימוש עוד. -->
    <record id="work_entry_type_attendance_overtime" model="hr.work.entry.type">
        <field name="name">שעות נוספות - נוכחות (legacy)</field>
        <field name="code">IL_OT_ATTENDANCE_LEGACY</field>
        <field name="active">False</field>
    </record>

    <!-- הסוג המובנה "Overtime Hours": שיעור התשלום מאופס כי התשלום בפועל על שעות נוספות
         מנוכחות מחושב על ידי כלל שכר ייעודי (IL_OT_ATTENDANCE) לפי "שכר לשעה נוספת" קבוע
         לעובד, ולא לפי אחוז מהשכר הרגיל. שינוי הזה משפיע על כל שימוש עתידי בסוג הזה במערכת,
         לא רק על שעות נוספות מנוכחות.
         הרשומה המובנית מסומנת noupdate="1" במודול המקורי, כך שעדכון רגיל דרך <record> לא
         היה נשמר בשדרוגים חוזרים - לכן משתמשים כאן ב-<function> שרץ בכל התקנה/שדרוג. -->
    <function model="hr.work.entry.type" name="write"
        eval="[[ref('hr_work_entry.work_entry_type_overtime')], {'amount_rate': 0.0}]"/>
</odoo>
