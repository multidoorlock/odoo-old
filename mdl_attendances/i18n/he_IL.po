#. module: mdl_attendances
#: model_terms:ir.ui.view,arch_db:mdl_attendances.hr_attendance_view_form_segments
msgid "Hours for Approval / Payment"
msgstr "שעות לאישור / לתשלום"

#. module: mdl_attendances
#: model_terms:ir.ui.view,arch_db:mdl_attendances.hr_attendance_view_form_segments
msgid "Total Hours for Approval / Payment"
msgstr "סה״כ שעות לאישור / לתשלום"
