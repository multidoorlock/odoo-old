#. module: mdl_attendances
#: model:ir.model.fields.selection,name:mdl_attendances.selection__hr_attendance_overtime_rule__quantity_period__shift
msgid "Whole Shift / Workday"
msgstr "משמרת שלמה / יום עבודה"

#. module: mdl_attendances
#: model:ir.model.fields,help:mdl_attendances.field_hr_attendance_overtime_rule__quantity_period
msgid "Whole Shift / Workday combines all effective work from attendances that start on the same local date, including work after midnight. Non-work segments are excluded. Daily and weekly rules keep their native behavior."
msgstr "משמרת שלמה / יום עבודה מצרף את כל שעות העבודה בפועל מהחתמות שהתחילו באותו תאריך מקומי, כולל עבודה אחרי חצות. מקטעי אי־עבודה אינם נכללים. כללים יומיים ושבועיים שומרים על אופן החישוב הרגיל שלהם."

#. module: mdl_attendances
#. odoo-python
#: code:addons/mdl_attendances/models/hr_attendance_overtime_rule.py:0
msgid "Whole-shift rules cannot be combined with daily, weekly or timing rules in the same ruleset."
msgstr "לא ניתן לשלב כללי משמרת שלמה עם כללים יומיים, שבועיים או כללי תזמון באותה קבוצת כללים."

#. module: mdl_attendances
#. odoo-python
#: code:addons/mdl_attendances/models/hr_attendance_overtime_rule.py:0
msgid "A whole-shift rule requires an explicit duration to exceed."
msgstr "בכלל משמרת שלמה יש להגדיר במפורש את מספר השעות שמעבר לו יחושבו שעות נוספות."

#. module: mdl_attendances
#. odoo-python
#: code:addons/mdl_attendances/models/hr_attendance_overtime_rule.py:0
#, python-format
msgid "%(hours)s h / whole shift"
msgstr "%(hours)s שעות / משמרת שלמה"

#. module: mdl_attendances
#: model:ir.model.fields,field_description:mdl_attendances.field_hr_attendance_overtime_rule__mdl_shift_rounding_threshold_minutes
msgid "Whole-shift Rounding Threshold (minutes)"
msgstr "סף עיגול למשמרת שלמה (בדקות)"

#. module: mdl_attendances
#: model:ir.model.fields,help:mdl_attendances.field_hr_attendance_overtime_rule__mdl_shift_rounding_threshold_minutes
msgid "Zero keeps exact overtime hours. Otherwise, round the whole workday to full payable hours, adding the next hour when the remaining minutes reach this threshold. Actual work intervals are unchanged."
msgstr "אפס משאיר את השעות הנוספות המדויקות. אחרת, יום העבודה כולו מעוגל לשעות מלאות לתשלום, והשעה הבאה מתווספת כאשר יתרת הדקות מגיעה לסף הזה. מקטעי העבודה בפועל אינם משתנים."

#. module: mdl_attendances
#: model:ir.model.fields,field_description:mdl_attendances.field_hr_attendance_overtime_line__mdl_auto_approval_hours
msgid "Automatically Calculated Approval Hours"
msgstr "שעות לאישור שחושבו אוטומטית"

#. module: mdl_attendances
#: model:ir.model.fields,help:mdl_attendances.field_hr_attendance_overtime_line__mdl_auto_approval_hours
msgid "Original rounded approval hours generated by the whole-shift rule. Used to distinguish automatic rounding from a later manual change."
msgstr "השעות המעוגלות לאישור שנוצרו בכלל המשמרת השלמה. משמשות להבחנה בין עיגול אוטומטי לשינוי ידני מאוחר יותר."

#. module: mdl_attendances
#. odoo-python
#: code:addons/mdl_attendances/models/hr_attendance_overtime_rule.py:0
msgid "Rounding requires a whole-shift rule and a threshold from 1 to 59 minutes, or zero for exact hours."
msgstr "עיגול מחייב כלל משמרת שלמה וסף בין דקה אחת ל־59 דקות, או אפס לשעות מדויקות."

#. module: mdl_attendances
#. odoo-python
#: code:addons/mdl_attendances/models/hr_attendance_overtime_rule.py:0
msgid "A ruleset with whole-shift rounding must contain exactly one rule."
msgstr "קבוצת כללים עם עיגול למשמרת שלמה חייבת לכלול כלל אחד בלבד."

#. module: mdl_attendances
#: model:ir.model.fields,field_description:mdl_attendances.field_hr_attendance__mdl_pending_overtime_hours
msgid "Hours to Approve"
msgstr "שעות לאישור"

#. module: mdl_attendances
#: model:ir.model.fields,help:mdl_attendances.field_hr_attendance__mdl_pending_overtime_hours
msgid "Approval hours from overtime lines that are still awaiting approval, including the whole-shift rounding policy."
msgstr "השעות משורות השעות הנוספות שעדיין ממתינות לאישור, כולל העיגול שנקבע למשמרת שלמה."

#. module: mdl_attendances
#: model_terms:ir.ui.view,arch_db:mdl_attendances.hr_attendance_management_pending_hours
#: model_terms:ir.ui.view,arch_db:mdl_attendances.hr_attendance_view_form_segments
msgid "Actual Overtime Hours"
msgstr "שעות נוספות בפועל"

#. module: mdl_attendances
#: model_terms:ir.ui.view,arch_db:mdl_attendances.hr_attendance_management_pending_hours
msgid "Approved Overtime Hours"
msgstr "שעות נוספות שאושרו"

#. module: mdl_attendances
#: model_terms:ir.ui.view,arch_db:mdl_attendances.hr_attendance_management_pending_hours
