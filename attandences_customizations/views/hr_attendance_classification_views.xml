<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_classification_rule_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.classification.rule.form</field>
        <field name="model">hr.attendance.classification.rule</field>
        <field name="arch" type="xml">
            <form string="כלל סיווג משמרת">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="שם הכלל"/>
                        <h1><field name="name" placeholder="לדוגמה: כניסה לפני 13:30"/></h1>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </div>
                    <group string="תנאי">
                        <field name="time_from" widget="float_time"/>
                        <field name="time_to" widget="float_time"/>
                    </group>
                    <group string="תוצאה">
                        <field name="attendance_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_attendance_classification_rule_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.classification.rule.list</field>
        <field name="model">hr.attendance.classification.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="time_from" widget="float_time"/>
                <field name="time_to" widget="float_time"/>
                <field name="attendance_type"/>
            </list>
        </field>
    </record>

    <record id="hr_attendance_classification_ruleset_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.classification.ruleset.form</field>
        <field name="model">hr.attendance.classification.ruleset</field>
        <field name="arch" type="xml">
            <form string="חוקי משמרות">
                <field name="active" invisible="1"/>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="שם הקבוצה"/>
                        <h1><field name="name" placeholder="לדוגמה: חוקי משמרות - ברירת מחדל"/></h1>
                    </div>
                    <group>
                        <field name="country_id" options="{'no_create': True, 'no_open': True}" groups="base.group_multi_company"/>
                    </group>
                    <group colspan="4">
                        <field name="description" colspan="4" placeholder="תיאור או הסבר לקבוצת הכללים."/>
                    </group>
                    <notebook colspan="4">
                        <page name="classification_rules" string="כללי סיווג">
                            <field name="rule_ids" readonly="not id">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="information_display"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_attendance_classification_ruleset_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.classification.ruleset.list</field>
        <field name="model">hr.attendance.classification.ruleset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id" groups="base.group_multi_company" optional="hide"/>
                <field name="rules_count"/>
            </list>
        </field>
    </record>

    <record id="hr_attendance_classification_ruleset_view_filter" model="ir.ui.view">
        <field name="name">hr_attendance_classification_ruleset_view_filter</field>
        <field name="model">hr.attendance.classification.ruleset</field>
        <field name="arch" type="xml">
            <search string="חיפוש קבוצות סיווג">
                <filter string="יש לפחות כלל אחד" name="has_rules" domain="[('rule_ids', '!=', False)]"/>
                <filter string="בארכיון" name="archived_rulesets" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="מדינה" name="country" context="{'group_by': 'country_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_attendance_classification_rule_action" model="ir.actions.act_window">
        <field name="name">כללי סיווג משמרות</field>
        <field name="res_model">hr.attendance.classification.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hr_attendance_classification_ruleset_action" model="ir.actions.act_window">
        <field name="name">חוקי משמרות</field>
        <field name="res_model">hr.attendance.classification.ruleset</field>
        <field name="search_view_id" ref="hr_attendance_classification_ruleset_view_filter"/>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_attendance_classification_rulesets" name="חוקי משמרות"
        parent="hr_attendance.menu_hr_attendance_configuration" sequence="310"
        action="hr_attendance_classification_ruleset_action"
        groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
