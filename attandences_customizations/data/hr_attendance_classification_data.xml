<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="classification_ruleset_default" model="hr.attendance.classification.ruleset">
        <field name="name">חוקי משמרות - ברירת מחדל</field>
        <field name="company_id" eval="False"/>
        <field name="country_id" eval="False"/>
    </record>

    <record id="classification_rule_morning" model="hr.attendance.classification.rule">
        <field name="ruleset_id" ref="classification_ruleset_default"/>
        <field name="sequence">10</field>
        <field name="name">כניסה לפני 13:30 - משמרת בוקר</field>
        <field name="time_from">0.0</field>
        <field name="time_to">13.5</field>
        <field name="attendance_type">morning</field>
    </record>

    <record id="classification_rule_afternoon" model="hr.attendance.classification.rule">
        <field name="ruleset_id" ref="classification_ruleset_default"/>
        <field name="sequence">20</field>
        <field name="name">כניסה מ-13:30 - משמרת ערב</field>
        <field name="time_from">13.5</field>
        <field name="time_to">24.0</field>
        <field name="attendance_type">afternoon</field>
    </record>
</odoo>
