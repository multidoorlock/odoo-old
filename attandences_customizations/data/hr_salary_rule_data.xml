<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- כלל שכר לתשלום שעות נוספות מנוכחות: לפי "שכר לשעה נוספת" קבוע לעובד (שדה
         att_overtime_hourly_rate), ולא לפי אחוז מהשכר הרגיל כמו כללי שעות נוספות אחרים.
         משתמש בסוג כניסת העבודה המובנה של אודו "Overtime Hours" (קוד OVERTIME). כלל IL_OT
         הקיים ב-l10n_il_hr_payroll כבר סוכם את כל סוגי כניסת העבודה שהם is_extra_hours (כולל
         OVERTIME), אבל ה-amount שלו לסוג הזה הוא 0 (amount_rate=0 אופס בסוג כניסת העבודה
         עצמו) - כך שאין כפל תשלום; הכלל הזה הוא שמביא את הסכום האמיתי. -->

    <record id="rule_ilm_ot_attendance" model="hr.salary.rule">
        <field name="name">שעות נוספות - נוכחות</field>
        <field name="code">IL_OT_ATTENDANCE</field>
        <field name="sequence">26</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = any(wd.work_entry_type_id.code == 'OVERTIME' for wd in payslip.worked_days_line_ids)
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
hours = sum(wd.number_of_hours for wd in payslip.worked_days_line_ids if wd.work_entry_type_id.code == 'OVERTIME')
hours = round(hours * 2) / 2.0
result = hours * (version.att_overtime_hourly_rate or 0.0)
        </field>
        <field name="struct_id" ref="l10n_il_hr_payroll.hr_payroll_structure_il_employee_salary"/>
    </record>

    <record id="rule_ilh_ot_attendance" model="hr.salary.rule">
        <field name="name">שעות נוספות - נוכחות</field>
        <field name="code">IL_OT_ATTENDANCE</field>
        <field name="sequence">26</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = any(wd.work_entry_type_id.code == 'OVERTIME' for wd in payslip.worked_days_line_ids)
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
hours = sum(wd.number_of_hours for wd in payslip.worked_days_line_ids if wd.work_entry_type_id.code == 'OVERTIME')
hours = round(hours * 2) / 2.0
result = hours * (version.att_overtime_hourly_rate or 0.0)
        </field>
        <field name="struct_id" ref="l10n_il_hr_payroll.hr_payroll_structure_il_worker_salary"/>
    </record>
</odoo>
